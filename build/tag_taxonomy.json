            }
          }
        },
        "abstract": {
          "description": "Abstract concepts",
          "subcategories": {
            "emotion": {
              "description": "Emotions and feelings",
              "examples": ["嬉しい", "悲しい", "怒り"]
            },
            "color": {
              "description": "Colors",
              "examples": ["赤", "青", "白", "黒"]
