  "notes": {
    "verb_default": "Generic 'verb' without type specification is mapped to 'verb-godan' as it is the most common verb class",
    "adjective_default": "Generic 'adjective' without type specification is mapped to 'adjective-i' as a reasonable default",
    "case_insensitive": "All mappings are applied case-insensitively with normalized whitespace"
