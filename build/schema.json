{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://je-dict-1/entry.schema.json",
  "title": "Dictionary Entry",
  "description": "Schema for je-dict-1 dictionary entries",
  "type": "object",
  "required": ["id", "headword", "reading", "part_of_speech", "gloss", "metadata"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9]{5}$",
      "description": "Unique identifier: romanized_reading + underscore + 5-digit number"
    },
    "headword": {
      "type": "string",
      "minLength": 1,
      "description": "Dictionary form, kanji if applicable"
    },
    "reading": {
      "type": "string",
      "pattern": "^[ぁ-んー]+$",
      "description": "Hiragana reading"
    },
    "part_of_speech": {
      "type": "string",
      "minLength": 1,
      "description": "Grammatical category (e.g., 'verb (ichidan)', 'noun', 'particle')"
    },
    "gloss": {
      "type": "string",
      "minLength": 1,
      "description": "Brief English equivalent for quick scanning"
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sense_number", "gloss"],
        "properties": {
          "sense_number": {
            "type": "integer",
            "minimum": 1,
            "description": "Numeric sense identifier"
          },
          "gloss": {
            "type": "string",
            "minLength": 1,
            "description": "Brief gloss for this sense"
          },
          "explanation": {
            "type": "string",
            "description": "Fuller explanatory definition"
          }
        }
      },
      "description": "Array of sense objects with detailed explanations"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["japanese", "english"],
        "properties": {
          "japanese": {
            "type": "string",
            "minLength": 1,
            "description": "Japanese example sentence"
          },
          "english": {
            "type": "string",
            "minLength": 1,
            "description": "English translation"
          },
          "notes": {
            "type": ["string", "null"],
            "description": "Notes about this specific example"
          }
        }
      },
      "description": "Array of example sentence objects"
    },
    "notes": {
      "type": "string",
      "description": "Free-form prose: grammar notes, usage notes, cultural notes"
    },
    "cross_references": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of related entry IDs"
    },
    "predicates_requiring": {
      "type": "object",
      "description": "For particles: predicates that require this particle",
      "properties": {
        "description": { "type": "string" },
        "verbs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "word": { "type": "string" },
              "example": { "type": "string" },
              "meaning": { "type": "string" }
            }
          }
        },
        "adjectives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "word": { "type": "string" },
              "example": { "type": "string" },
              "meaning": { "type": "string" }
            }
          }
        }
      }
    },
    "particle_contrasts": {
      "type": "array",
      "description": "For particles: contrasts with other particles",
      "items": {
        "type": "object",
        "properties": {
          "particle": { "type": "string" },
          "explanation": { "type": "string" },
          "examples": { "type": "array" },
          "key_points": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "fixed_patterns": {
      "type": "array",
      "description": "Fixed grammatical patterns using this word",
      "items": {
        "type": "object",
        "properties": {
          "pattern": { "type": "string" },
          "meaning": { "type": "string" },
          "example": { "type": "string" },
          "example_english": { "type": "string" }
        }
      }
    },
    "common_mistakes": {
      "type": "array",
      "description": "Common mistakes learners make with this word",
      "items": {
        "type": "object",
        "properties": {
          "mistake": { "type": "string" },
          "incorrect": { "type": "string" },
          "correct": { "type": "string" },
          "explanation": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["created", "modified", "review_status"],
      "properties": {
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of entry creation"
        },
        "modified": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last modification"
        },
        "ai_model": {
          "type": "string",
          "description": "Which AI model generated/edited this entry"
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Confidence level"
        },
        "review_status": {
          "type": "string",
          "enum": ["draft", "reviewed", "verified"],
          "description": "Review status of the entry"
        },
        "jlpt_level": {
          "type": "string",
          "enum": ["N5", "N4", "N3", "N2", "N1"],
          "description": "JLPT level if applicable"
        },
        "frequency_rank": {
          "type": ["integer", "null"],
          "description": "Numeric frequency rank if available"
        }
      }
    }
  }
}
