{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://je-dict-1/entry.schema.json",
  "title": "Dictionary Entry",
  "description": "Schema for je-dict-1 dictionary entries",
  "type": "object",
  "required": ["id", "headword", "reading", "part_of_speech", "gloss", "metadata"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version this entry conforms to (e.g., \"2.0\")"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{5}_[a-z]+(_[a-z]+)?$",
      "description": "Unique identifier: 5-digit number + underscore + romanized_reading (with optional suffix for homophones)"
    },
    "headword": {
      "type": "string",
      "minLength": 1,
      "description": "Dictionary form, kanji if applicable"
    },
    "reading": {
      "type": "string",
      "pattern": "^[ぁ-んァ-ヶーゝゞ]+$",
      "description": "Hiragana or katakana reading"
    },
    "part_of_speech": {
      "type": "string",
      "minLength": 1,
      "description": "Grammatical category (e.g., 'verb (ichidan)', 'noun', 'particle')"
    },
    "gloss": {
      "type": "string",
      "minLength": 1,
      "description": "Brief English equivalent for quick scanning"
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sense_number", "gloss"],
        "properties": {
          "sense_number": {
            "type": "integer",
            "minimum": 1,
            "description": "Numeric sense identifier"
          },
          "gloss": {
            "type": "string",
            "minLength": 1,
            "description": "Brief gloss for this sense"
          },
          "explanation": {
            "type": "string",
            "description": "Fuller explanatory definition"
          }
        }
      },
      "description": "Array of sense objects with detailed explanations"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "japanese", "english"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{5}_[a-z]+(_[a-z]+)?_ex[0-9]+$",
            "description": "Unique example ID: {entry_id}_ex{number}"
          },
          "japanese": {
            "type": "string",
            "minLength": 1,
            "description": "Japanese example sentence"
          },
          "english": {
            "type": "string",
            "minLength": 1,
            "description": "English translation"
          },
          "notes": {
            "type": ["string", "null"],
            "description": "Notes about this specific example"
          },
          "has_audio": {
            "type": "boolean",
            "description": "Whether audio exists for this example"
          },
          "sense_numbers": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Array of sense numbers this example illustrates"
          }
        }
      },
      "description": "Array of example sentence objects"
    },
    "notes": {
      "type": "string",
      "description": "Free-form prose: grammar notes, usage notes, cultural notes"
    },
    "cross_references": {
      "type": "array",
      "items": {
        "$comment": "Legacy plain-string format removed 2026-02-06 after converting all 28 remaining entries to object format",
        "type": "object",
        "required": ["type", "reading"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["pair", "synonym", "antonym", "keigo", "related", "see_also", "contrast", "homophone"],
            "$comment": "Keep this enum in sync with CROSS_REF_TYPES in build/constants.py",
            "description": "Relationship type"
          },
          "target_id": {
            "type": "string",
            "pattern": "^[0-9]{5}_[a-z]+(_[a-z]+)?$",
            "description": "Hard-coded entry ID for direct resolution (optional, takes priority over reading/headword lookup)"
          },
          "reading": {
            "type": "string",
            "pattern": "^[ぁ-んーゝゞ]+$",
            "description": "Hiragana reading of target word (primary lookup key when target_id is absent)"
          },
          "headword": {
            "type": "string",
            "description": "Display form with kanji/furigana (optional, for display before entry exists)"
          },
          "label": {
            "type": "string",
            "description": "Short label like 'intransitive', 'honorific', 'formal'"
          }
        }
      },
      "description": "Array of cross-references to related entries"
    },
    "predicates_requiring": {
      "type": "object",
      "description": "For particles: predicates that require this particle",
      "properties": {
        "description": { "type": "string" },
        "verbs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "word": { "type": "string" },
              "example": { "type": "string" },
              "meaning": { "type": "string" }
            }
          }
        },
        "adjectives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "word": { "type": "string" },
              "example": { "type": "string" },
              "meaning": { "type": "string" }
            }
          }
        }
      }
    },
    "particle_contrasts": {
      "type": "array",
      "description": "For particles: contrasts with other particles",
      "items": {
        "type": "object",
        "properties": {
          "particle": { "type": "string" },
          "explanation": { "type": "string" },
          "examples": { "type": "array" },
          "key_points": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "fixed_patterns": {
      "type": "array",
      "description": "Fixed grammatical patterns using this word",
      "items": {
        "type": "object",
        "properties": {
          "pattern": { "type": "string" },
          "meaning": { "type": "string" },
          "example": { "type": "string" },
          "example_english": { "type": "string" }
        }
      }
    },
    "common_mistakes": {
      "type": "array",
      "description": "Common mistakes learners make with this word",
      "items": {
        "type": "object",
        "properties": {
          "mistake": { "type": "string" },
          "incorrect": { "type": "string" },
          "correct": { "type": "string" },
          "explanation": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["created", "modified"],
      "properties": {
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of entry creation"
        },
        "modified": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last modification"
        },
        "ai_model": {
          "type": "string",
          "description": "Which AI model generated/edited this entry"
        },
        "vocabulary_tier": {
          "type": ["string", "null"],
          "enum": ["basic", "core", "general", null],
          "description": "Vocabulary tier: basic (600-800 fundamental words), core (1600-2000 words for adult communication), or general (all other vocabulary)"
        },
        "tags": {
          "type": "object",
          "description": "Structured tags for search and categorization",
          "properties": {
            "pos": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "noun",
                  "verb-godan",
                  "verb-ichidan",
                  "verb-suru",
                  "verb-kuru",
                  "verb-irregular",
                  "adjective-i",
                  "adjective-na",
                  "adjective-no",
                  "adjective-taru",
                  "adverb",
                  "particle",
                  "conjunction",
                  "interjection",
                  "pronoun",
                  "counter",
                  "prefix",
                  "suffix",
                  "expression",
                  "pre-noun-adjectival",
                  "number",
                  "auxiliary",
                  "onomatopoeia"
                ]
              },
              "description": "Part of speech (canonical forms)"
            },
            "transitivity": {
              "type": ["string", "null"],
              "enum": ["transitive", "intransitive", "both", null],
              "description": "Verb transitivity (verbs only)"
            },
            "verb_class": {
              "type": ["string", "null"],
              "enum": [
                "godan-u",
                "godan-ku",
                "godan-gu",
                "godan-su",
                "godan-tsu",
                "godan-nu",
                "godan-bu",
                "godan-mu",
                "godan-ru",
                "ichidan",
                "suru",
                "kuru",
                "irregular",
                null
              ],
              "description": "Verb conjugation class (verbs only)"
            },
            "formality": {
              "type": ["string", "null"],
              "enum": ["formal", "neutral", "informal", "vulgar", null],
              "description": "Register/formality level"
            },
            "politeness": {
              "type": ["string", "null"],
              "enum": ["honorific", "humble", "polite", "plain", null],
              "description": "Keigo classification"
            },
            "style": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["written", "spoken", "literary", "archaic", "slang"]
              },
              "description": "Style/medium associations"
            },
            "domain": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "business",
                  "academic",
                  "technical",
                  "legal",
                  "medical",
                  "colloquial",
                  "internet"
                ]
              },
              "description": "Usage domains"
            },
            "semantic": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Semantic categories (e.g., time-day-of-week, animal-mammal, body-part)"
            }
          }
        }
      }
    }
  }
}
