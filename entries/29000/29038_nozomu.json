{
  "id": "29038_nozomu",
  "headword": "{臨|のぞ}む",
  "reading": "のぞむ",
  "romaji": "nozomu",
  "part_of_speech": "verb (godan)",
  "gloss": "to face; to tackle; to be present at",
  "schema_version": "2.0",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to face; to tackle; to be present at (an occasion)",
      "explanation": "To face an event, challenge, or formal occasion, often with a sense of readiness or resolve. Used for competitions, exams, ceremonies, or any important occasion one is about to participate in."
    },
    {
      "sense_number": 2,
      "gloss": "to face; to overlook (a view or location)",
      "explanation": "Of a building, room, or location: to face onto or overlook something such as the sea, a plaza, or a mountain. Used in formal or descriptive writing."
    }
  ],
  "examples": [
    {
      "id": "29038_nozomu_ex1",
      "japanese": "{試合|しあい}に{臨|のぞ}む。",
      "english": "To face a match; to take on a game.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29038_nozomu_ex2",
      "japanese": "{万全|ばんぜん}の{準備|じゅんび}で{本番|ほんばん}に{臨|のぞ}む。",
      "english": "To face the real performance fully prepared.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29038_nozomu_ex3",
      "japanese": "{緊張|きんちょう}しているが、{前向|まえむ}きな{気持|きも}ちで{面接|めんせつ}に{臨|のぞ}みたい。",
      "english": "I'm nervous, but I want to approach the interview with a positive attitude.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29038_nozomu_ex4",
      "japanese": "{海|うみ}に{臨|のぞ}む{部屋|へや}。",
      "english": "A room overlooking the sea.",
      "sense_numbers": [
        2
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29038_nozomu_ex5",
      "japanese": "{広場|ひろば}に{臨|のぞ}む{建物|たてもの}が{市庁舎|しちょうしゃ}だ。",
      "english": "The building facing the plaza is city hall.",
      "sense_numbers": [
        2
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29038_nozomu_ex6",
      "japanese": "そのホテルは{山|やま}に{臨|のぞ}む{絶好|ぜっこう}のロケーションにある。",
      "english": "That hotel is in a prime location overlooking the mountains.",
      "sense_numbers": [
        2
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "Formal verb used in written and public speech. Common in sports commentary, ceremony language, and descriptive writing.\n\nSIMILAR WORDS:\n- {望|のぞ}む (01976): to wish; to desire; to hope for — a frequent homophone with a completely different meaning; note 望 vs 臨 in kanji\n- {向|む}かう: to face; to head toward (less formal, more directional movement)\n- {挑|いど}む: to challenge; to take on (implies active defiance)",
