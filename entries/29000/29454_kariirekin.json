  "definitions": [
    {
      "sense_number": 1,
      "gloss": "borrowed money; loan; amount borrowed",
      "explanation": "Money that a person, household, or company has borrowed and must repay, especially from a bank. A common term in accounting and personal finance."
    }
  ],
