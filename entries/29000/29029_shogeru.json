{
  "id": "29029_shogeru",
  "headword": "しょげる",
  "reading": "しょげる",
  "romaji": "shogeru",
  "part_of_speech": "verb (ichidan)",
  "gloss": "to be crestfallen; to lose spirit; to be dejected",
  "schema_version": "2.0",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be crestfallen; to be dejected; to lose one's spirit",
      "explanation": "To become visibly discouraged or downcast, typically after a failure, scolding, or disappointment. Suggests a sudden loss of energy or confidence, often shown through slumped posture or a subdued demeanor."
    }
  ],
  "examples": [
    {
      "id": "29029_shogeru_ex1",
      "japanese": "しょげないで。",
      "english": "Don't be so down.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29029_shogeru_ex2",
      "japanese": "{試験|しけん}に{落|お}ちてすっかりしょげてしまった。",
      "english": "He was completely crestfallen after failing the exam.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29029_shogeru_ex3",
      "japanese": "{犬|いぬ}は{叱|しか}られてしょげているのか、{尻尾|しっぽ}を{丸|まる}めてすみっこに{座|すわ}っていた。",
      "english": "The dog seemed crestfallen after being scolded — it was sitting in the corner with its tail tucked.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "Informal verb describing a deflated, downcast mood. Often used when someone takes a hit to their confidence or gets scolded.\n\nCOMMON PATTERNS:\n- しょげる — to become crestfallen\n- しょげている — to be in a down/dejected state\n- しょげないで — don't be so down\n- しょげた{顔|かお} — a dejected face\n\nSIMILAR WORDS:\n- がっかりする: to be disappointed (more about unmet expectations)\n- 落ち込む（おちこむ）: to feel depressed, to be in low spirits (stronger and longer-lasting)\n- しゅんとする: to suddenly become quiet and downcast (similar but slightly more literary)",
