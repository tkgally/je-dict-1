  "definitions": [
    {
      "sense_number": 1,
      "gloss": "consultation; advisory inquiry",
      "explanation": "A formal request for advice or opinions from an expert body or advisory committee, especially in government or institutional contexts. The body consulted then provides a formal response ({答申|とうしん})."
    }
  ],
  "examples": [
