  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to pester; to badger; to beg persistently",
      "explanation": "To repeatedly ask or beg someone for something in a persistent, often childish way. Typically describes children asking parents for things, but can also be used for adults."
    }
  ],
  "examples": [
