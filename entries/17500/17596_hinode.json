      "sense_number": 1,
      "gloss": "sunrise",
      "explanation": "the moment when the sun appears above the horizon; also the time at which this occurs"
    }
  ],
  "examples": [
    {
      "id": "17596_hinode_ex1",
      "japanese": "{日|ひ}の{出|で}を{見|み}に{山|やま}に{登|のぼ}った。",
      "english": "I climbed the mountain to see the sunrise.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
