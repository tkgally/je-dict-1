  "definitions": [
    {
      "sense_number": 1,
      "gloss": "refutation; winning an argument; demolishing someone's argument",
      "explanation": "Defeating an opponent's argument through logic and reasoning. In modern internet culture, often used more casually to mean proving someone wrong or shutting them down in a debate."
    }
  ],
