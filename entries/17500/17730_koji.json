  "definitions": [
    {
      "sense_number": 1,
      "gloss": "firm refusal; persistent declining",
      "explanation": "Firmly and repeatedly refusing an offer, appointment, or request. Stronger than a simple refusal, implying that the person declines despite pressure or repeated offers."
    }
  ],
