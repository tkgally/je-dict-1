  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to hold up, to put up",
      "explanation": "To hold something up or over oneself, most commonly an umbrella."
    },
    {
      "sense_number": 2,
      "gloss": "to shine in, to come through",
      "explanation": "For light or color to come through or appear. Used when sunlight streams in or when a flush of color appears on someone's face."
    },
    {
      "sense_number": 3,
      "gloss": "to pour, to offer a drink",
      "explanation": "To pour a drink for someone, especially sake. Part of the traditional custom of pouring for others at meals."
    }
  ],
