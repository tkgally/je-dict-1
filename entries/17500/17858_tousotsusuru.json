  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to command; to lead; to direct (a group)",
      "explanation": "To exercise leadership and bring a group together under unified direction. Used for military command, team leadership, and organizational management."
    }
  ],
  "examples": [
