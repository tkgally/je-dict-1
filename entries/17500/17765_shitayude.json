  "definitions": [
    {
      "sense_number": 1,
      "gloss": "parboiling, precooking by boiling, blanching",
      "explanation": "Briefly boiling ingredients before the main cooking step to remove bitterness, excess starch, or impurities, or to soften tough vegetables. A fundamental technique in Japanese cooking."
    }
  ],
