  "definitions": [
    {
      "sense_number": 1,
      "gloss": "leaving one's seat; withdrawing from a meeting or gathering",
      "explanation": "Formally leaving one's seat or place during a meeting, class, ceremony, or other gathering. Often implies excusing oneself partway through."
    }
  ],
