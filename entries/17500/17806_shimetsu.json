  "definitions": [
    {
      "sense_number": 1,
      "gloss": "extinction; dying out; perishing",
      "explanation": "The complete dying out or destruction of living things such as organisms, species, or cells. Also used figuratively for the disappearance of cultures, traditions, or ideas. Used as a suru verb."
    }
  ],
