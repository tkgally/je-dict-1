  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to subside, to be suppressed, to calm down",
      "explanation": "For disturbances, pain, emotions, or unrest to settle down and return to a calm state. Implies that something turbulent or agitated has been brought under control or has naturally subsided."
    }
  ],
  "examples": [
