  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to pull out; to extract",
      "explanation": "to remove something by pulling it out, such as a plant, cork, or tooth"
    },
    {
      "sense_number": 2,
      "gloss": "to headhunt; to poach",
      "explanation": "to recruit talented individuals away from another company or organization"
    }
  ],
