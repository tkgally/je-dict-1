  "definitions": [
    {
      "sense_number": 1,
      "gloss": "reproduction; replica; copy; duplicate",
      "explanation": "A copy or reproduction of an original item, such as a work of art, document, or digital file. Implies a faithful reproduction rather than a rough copy."
    }
  ],
  "examples": [
