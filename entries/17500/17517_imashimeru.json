  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to warn; to admonish; to caution",
      "explanation": "To strongly advise someone against doing something wrong or dangerous, often from a position of authority or experience."
    },
    {
      "sense_number": 2,
      "gloss": "to discipline; to punish as a lesson",
      "explanation": "To impose a consequence or correction on someone so they learn from their mistake."
    }
  ],
