  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to join a club; to become a member of a club",
      "explanation": "To formally join a school club or extracurricular activity group. Primarily used in the context of Japanese schools, where club activities ({部活動|ぶかつどう}) are a central part of student life."
    }
  ],
