  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to incite; to egg on; to urge on",
      "explanation": "To provoke or encourage someone to do something, often something aggressive or unwise."
    },
    {
      "sense_number": 2,
      "gloss": "to sic; to set (an animal) on",
      "explanation": "To command an animal, especially a dog, to attack."
    }
  ],
  "examples": [
    {
