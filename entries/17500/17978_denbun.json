  "definitions": [
    {
      "sense_number": 1,
      "gloss": "hearsay; rumor; secondhand information",
      "explanation": "Information that one has heard from others rather than witnessed firsthand. Often used in formal or legal contexts to distinguish direct knowledge from reported information."
    }
  ],
  "examples": [
