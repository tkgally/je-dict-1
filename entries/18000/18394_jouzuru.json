  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to take advantage of; to exploit (an opportunity or weakness)",
      "explanation": "To seize upon a situation, moment of weakness, or confusion to act in one's favor. Often implies cunning or opportunism."
    },
    {
      "sense_number": 2,
      "gloss": "to multiply (mathematics)",
      "explanation": "To perform multiplication. A formal/literary alternative to 掛ける in mathematical contexts."
    }
  ],
