  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to crowd together; to flock; to swarm; to gather in groups",
      "explanation": "For animals or people to gather together in large numbers. When used about people, it can carry a slightly negative nuance of mindlessly clustering together."
    }
  ],
