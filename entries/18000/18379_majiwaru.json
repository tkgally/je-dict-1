  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to cross; to intersect",
      "explanation": "For lines, roads, or paths to cross each other at a point. Used for physical intersections."
    },
    {
      "sense_number": 2,
      "gloss": "to associate with; to have relations with",
      "explanation": "To interact or socialize with people. Often used in somewhat formal or literary contexts to describe personal or social relationships."
    }
  ],
  "examples": [
