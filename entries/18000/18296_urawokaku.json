  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to outwit; to outsmart; to catch off guard; to do the unexpected",
      "explanation": "To act in a way that the other party does not expect, thereby gaining an advantage. Often used in strategy, competition, and negotiations."
    }
