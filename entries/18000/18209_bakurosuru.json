  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to expose; to reveal; to disclose; to unmask",
      "explanation": "To bring hidden or secret information to light, especially wrongdoing, scandals, or things someone wanted to keep secret. Often implies the revelation is damaging to the person exposed."
    }
  ],
