  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be interrupted, to break off, to pause",
      "explanation": "Something continuous (conversation, signal, flow of people, etc.) stops temporarily or permanently. An intransitive verb describing the state of being cut off or disrupted."
    }
  ],
