  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be absorbed in; to be immersed in; to devote oneself to",
      "explanation": "To concentrate so deeply on an activity that one loses awareness of everything else. Often used for work, study, hobbies, or creative pursuits. Takes the particle に for the activity."
    }
  ],
  "examples": [
