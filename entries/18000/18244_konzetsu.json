  "definitions": [
    {
      "sense_number": 1,
      "gloss": "eradication; extermination; uprooting; stamping out",
      "explanation": "Completely eliminating something undesirable so that it cannot recur. Used for diseases, social problems, crime, and harmful practices."
    }
  ],
