  "definitions": [
    {
      "sense_number": 1,
      "gloss": "rehabilitation, reform, turning over a new leaf",
      "explanation": "Returning to a normal, productive life after criminal behavior, addiction, or other serious problems. Often used in legal and social welfare contexts."
