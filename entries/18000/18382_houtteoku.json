  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to leave alone; to let be; to leave someone/something as is",
      "explanation": "To deliberately not interfere with or attend to someone or something. Can imply either benign neglect (giving space) or irresponsible neglect depending on context."
    }
  ],
