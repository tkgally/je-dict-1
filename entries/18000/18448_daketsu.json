  "definitions": [
    {
      "sense_number": 1,
      "gloss": "settlement; reaching an agreement; conclusion of negotiations",
      "explanation": "The successful conclusion of negotiations or discussions in which both sides reach a mutually acceptable agreement. Used primarily in formal, business, legal, and diplomatic contexts."
    }
  ],
