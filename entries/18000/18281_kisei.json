  "definitions": [
    {
      "sense_number": 1,
      "gloss": "parasitism; living off a host",
      "explanation": "In biology, living on or in another organism and obtaining nourishment from it. Used for insects, plants, and microorganisms."
    },
    {
      "sense_number": 2,
      "gloss": "dependence; living off others",
      "explanation": "Figuratively, relying on someone else for one's livelihood without contributing in return."
    }
  ],
  "examples": [
