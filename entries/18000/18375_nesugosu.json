  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to oversleep; to sleep past one's alarm or intended wake-up time",
      "explanation": "To sleep longer than planned, typically resulting in being late. A compound of 寝る (to sleep) and 過ごす (to pass/exceed)."
    }
  ],
  "examples": [
