  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to harm, to impair, to damage",
      "explanation": "To cause damage or deterioration to something valuable — health, reputation, trust, beauty, etc. Often used for abstract damage rather than physical destruction."
    },
    {
      "sense_number": 2,
      "gloss": "to fail to do, to miss doing (as a verb suffix)",
      "explanation": "When attached to the stem of another verb (V-stem + {損|そこ}なう), it means failing to do the action or doing it incorrectly."
    }
  ],
  "examples": [
