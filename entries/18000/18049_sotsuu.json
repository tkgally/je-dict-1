  "definitions": [
    {
      "sense_number": 1,
      "gloss": "communication; mutual understanding; getting through",
      "explanation": "The state of ideas, feelings, or information flowing smoothly between people. Emphasizes the successful exchange and mutual comprehension rather than the act of speaking itself."
    }
