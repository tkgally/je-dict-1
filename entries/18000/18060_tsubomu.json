  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to close up, to be in bud",
      "explanation": "For flowers or petals to be closed or not yet open. The opposite of blooming."
    },
    {
      "sense_number": 2,
      "gloss": "to narrow, to purse, to pucker",
      "explanation": "For something to become smaller or narrower, like pursing the lips or an opening becoming smaller."
    }
  ],
