  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to bend; to flex; to be supple; to spring",
      "explanation": "To bend smoothly under force and spring back, like a flexible branch or fishing rod. Describes an elastic, resilient bending motion rather than a permanent deformation."
    }
  ],
