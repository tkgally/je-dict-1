  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be soothed, to feel at ease, to be calmed",
      "explanation": "To become relaxed and feel a warm, gentle sense of comfort. Often describes the feeling when seeing something cute, heartwarming, or peaceful."
    },
    {
      "sense_number": 2,
      "gloss": "to soften, to become mild",
      "explanation": "An atmosphere or mood becoming gentler, less tense, or more relaxed."
    }
