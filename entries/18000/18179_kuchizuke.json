  "definitions": [
    {
      "sense_number": 1,
      "gloss": "kiss",
      "explanation": "A literary or poetic word for a kiss. More elegant and romantic than the loanword キス, and typically used in fiction, poetry, and formal or artistic contexts."
    }
  ],
  "examples": [
