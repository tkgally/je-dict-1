  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to feel ashamed; to be embarrassed; to feel disgrace",
      "explanation": "To feel shame about one's own actions, behavior, or shortcomings. A more introspective and literary word than 恥ずかしい."
