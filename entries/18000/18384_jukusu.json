  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to ripen; to mature (of fruit)",
      "explanation": "For fruit or crops to reach the stage where they are ready to eat or harvest. Used for the natural ripening process."
    },
    {
      "sense_number": 2,
      "gloss": "to mature; to come to fruition (figurative)",
      "explanation": "For a plan, idea, skill, or situation to develop to the point where it is ready or complete. A figurative extension of the ripening metaphor."
    }
  ],
