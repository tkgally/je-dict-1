  "definitions": [
    {
      "sense_number": 1,
      "gloss": "becoming manifest, becoming apparent, actualization",
      "explanation": "Something hidden or latent becoming visible, obvious, or real. The opposite of 潜在 (latent, potential)."
    }
  ],
