  "definitions": [
    {
      "sense_number": 1,
      "gloss": "sudden death; dying suddenly",
      "explanation": "Death that occurs abruptly and unexpectedly, without prior warning or prolonged illness. Used in both medical and general contexts."
    }
  ],
