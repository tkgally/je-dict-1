  "part_of_speech": "noun, suru verb",
  "gloss": "pacification; suppression; restoring order",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "pacification; suppression; restoring order",
      "explanation": "The act of quelling unrest, rebellion, or disturbance and restoring a state of peace and order. A formal term used in historical, military, and political contexts."
    }
  ],
  "examples": [
    {
      "id": "24740_chintei_ex1",
      "japanese": "{反乱|はんらん}を{鎮定|ちんてい}する。",
      "english": "To suppress a rebellion.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "24740_chintei_ex2",
      "japanese": "{騒乱|そうらん}の{鎮定|ちんてい}に{数日|すうじつ}かかった。",
      "english": "It took several days to pacify the disturbance.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "24740_chintei_ex3",
      "japanese": "{政府|せいふ}は{軍|ぐん}を{派遣|はけん}して{内乱|ないらん}を{鎮定|ちんてい}し、{秩序|ちつじょ}の{回復|かいふく}を{図|はか}った。",
      "english": "The government dispatched the military to suppress the civil war and attempted to restore order.",
