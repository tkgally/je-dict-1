  "part_of_speech": "verb (suru)",
  "gloss": "to propose, to suggest",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to propose, to suggest, to put forward",
      "explanation": "To offer an idea, plan, or course of action for consideration by others."
    }
  ],
  "examples": [
    {
      "id": "06057_teiansuru_ex1",
      "japanese": "{新|あたら}しい{案|あん}を{提案|ていあん}した。",
      "english": "I proposed a new idea.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "06057_teiansuru_ex2",
      "japanese": "{会議|かいぎ}で{改善策|かいぜんさく}を{提案|ていあん}する。",
