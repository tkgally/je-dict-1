  "reading": "かけこむ",
  "part_of_speech": "verb (godan, intransitive)",
  "gloss": "to rush in; to run into",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to rush in; to run into",
      "explanation": "To run quickly into a place, often in a hurry or to seek refuge."
    },
    {
      "sense_number": 2,
      "gloss": "to rush to (make a deadline)",
      "explanation": "To hurry to meet a deadline, often at the last minute."
    }
  ],
  "examples": [
