  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to spout; to gush out; to spray",
      "explanation": "For liquids or gases to suddenly emerge forcefully from an opening."
    },
    {
      "sense_number": 2,
      "gloss": "to burst out laughing; to crack up",
      "explanation": "To suddenly and involuntarily start laughing, often when trying to hold it in."
    }
  ],
