  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to economize, to cut back",
      "explanation": "To reduce expenses or consumption; to live frugally by cutting costs."
    },
    {
      "sense_number": 2,
      "gloss": "to shorten, to trim down",
      "explanation": "To make something shorter or smaller by cutting."
    }
  ],
  "examples": [
