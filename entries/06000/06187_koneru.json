  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to knead, to work (dough)",
      "explanation": "To press and fold dough or similar substances repeatedly to make them smooth and pliable."
    },
    {
      "sense_number": 2,
      "gloss": "to quibble, to nitpick",
      "explanation": "To make petty complaints or arguments (often in the form {理屈|りくつ}を{捏|こ}ねる)."
    }
  ],
  "examples": [
