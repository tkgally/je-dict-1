{
  "id": "06058_gironsuru",
  "headword": "{議論|ぎろん}する",
  "reading": "ぎろんする",
  "part_of_speech": "verb (suru)",
  "gloss": "to discuss, to debate",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to discuss, to debate, to argue",
      "explanation": "To exchange opinions on a topic, often involving different viewpoints. Can include formal debates or heated discussions."
    }
  ],
  "examples": [
    {
      "id": "06058_gironsuru_ex1",
      "japanese": "{活発|かっぱつ}に{議論|ぎろん}する。",
      "english": "To discuss actively.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "06058_gironsuru_ex2",
      "japanese": "この{問題|もんだい}について{議論|ぎろん}しましょう。",
      "english": "Let's discuss this issue.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "06058_gironsuru_ex3",
      "japanese": "{国会|こっかい}で{法案|ほうあん}が{議論|ぎろん}されている。",
