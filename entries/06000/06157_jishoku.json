  "gloss": "resignation; resigning from a position",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "resignation",
      "explanation": "The formal act of voluntarily leaving a job or position, especially a high-ranking one."
    }
  ],
  "examples": [
