{
  "id": "06345_tobiagaru",
  "headword": "{飛|と}び{上|あ}がる",
  "reading": "とびあがる",
  "part_of_speech": "verb (godan)",
  "gloss": "to jump up; to spring up; to leap up",
  "conjugation": {
    "type": "godan",
    "ending": "る",
