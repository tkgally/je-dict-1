  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to thank, to be grateful, to appreciate",
      "explanation": "To express or feel gratitude toward someone for something they have done."
    }
  ],
  "examples": [
    {
      "id": "06055_kanshasuru_ex1",
      "japanese": "{心|こころ}から{感謝|かんしゃ}します。",
      "english": "I'm sincerely grateful.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "06055_kanshasuru_ex2",
      "japanese": "{両親|りょうしん}に{感謝|かんしゃ}している。",
      "english": "I am grateful to my parents.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "06055_kanshasuru_ex3",
      "japanese": "ご{協力|きょうりょく}に{感謝|かんしゃ}します。",
      "english": "Thank you for your cooperation.",
      "notes": "Formal expression",
