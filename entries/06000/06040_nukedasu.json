  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to slip out, to sneak out",
      "explanation": "To leave a place quietly or secretly without being noticed."
    },
    {
      "sense_number": 2,
      "gloss": "to escape, to get out of",
      "explanation": "To free oneself from a difficult situation, bad habit, or state."
    }
  ],
