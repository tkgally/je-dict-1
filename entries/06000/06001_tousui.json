  "definitions": [
    {
      "sense_number": 1,
      "gloss": "intoxication; rapture; ecstasy",
      "explanation": "A state of being completely absorbed in something pleasurable, losing oneself in an experience. Can refer to alcohol intoxication or figurative intoxication with art, beauty, or ideas."
    }
  ],
  "examples": [
