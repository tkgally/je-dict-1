    {
      "sense_number": 1,
      "gloss": "lethargy; exhaustion; prostration",
      "explanation": "A state of complete physical and mental exhaustion, often following intense stress, effort, or shock. The feeling of having no energy left."
    }
  ],
  "examples": [
