{
  "id": "06270_nurikaeru",
  "headword": "{塗|ぬ}り{替|か}える",
  "reading": "ぬりかえる",
  "part_of_speech": "verb (ichidan)",
  "gloss": "to repaint, to rewrite (a record)",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to repaint, to paint over",
      "explanation": "To apply a new coat of paint over an existing surface; to change the color by repainting."
    },
    {
      "sense_number": 2,
      "gloss": "to rewrite, to break (a record)",
      "explanation": "(Figurative) To replace an existing record or history with a new one; to set a new record."
    }
  ],
  "examples": [
    {
