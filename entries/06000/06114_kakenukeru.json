{
  "id": "06114_kakenukeru",
  "headword": "{駆|か}け{抜|ぬ}ける",
  "reading": "かけぬける",
  "part_of_speech": "verb (ichidan, intransitive)",
  "gloss": "to run through; to dash through",
  "conjugation": {
    "type": "ichidan",
    "stem": "{駆|か}け{抜|ぬ}け"
  },
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to run through; to dash through",
      "explanation": "To run quickly through a place from one end to the other without stopping."
    },
    {
      "sense_number": 2,
      "gloss": "to race through (a period)",
      "explanation": "To pass through a period of time quickly, often used figuratively for busy or intense times."
    }
  ],
  "examples": [
