  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to pinch, to pick up with fingers",
      "explanation": "To grip something small between the thumb and fingers."
    },
    {
      "sense_number": 2,
      "gloss": "to snack on, to nibble",
      "explanation": "To eat small bites of food casually, especially snacks or finger food."
    }
