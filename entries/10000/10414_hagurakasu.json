  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to dodge, to evade, to deflect",
      "explanation": "To skillfully avoid answering a question or dealing with a topic by changing the subject, giving a vague response, or distracting the other person."
    }
  ],
