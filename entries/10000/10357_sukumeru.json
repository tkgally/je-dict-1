  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to shrug, to hunch",
      "explanation": "To draw in or raise one's shoulders, either as a gesture of uncertainty or to make oneself smaller. Most commonly used in the phrase {肩|かた}をすくめる (to shrug one's shoulders)."
    }
  ],
  "examples": [
