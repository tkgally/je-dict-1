  "definitions": [
    {
      "sense_number": 1,
      "gloss": "meeting face-to-face, in-person meeting",
      "explanation": "The act of meeting someone in person, especially for the first time or after a long separation. Also used as a modifier to mean 'in-person' as opposed to online."
    }
  ],
