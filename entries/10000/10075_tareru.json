  "reading": "たれる",
  "part_of_speech": "verb (ichidan)",
  "gloss": "to hang down, to drip",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to hang down, to dangle",
      "explanation": "For something to hang downward from a point of attachment."
    },
    {
      "sense_number": 2,
      "gloss": "to drip, to droop",
      "explanation": "For liquid to fall in drops, or for something to sag."
    }
  ],
  "examples": [
