  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to fit; to match; to suit; to agree",
      "explanation": "For things to correspond, be compatible, or be in agreement. Used for sizes fitting, colors matching, answers being correct, etc."
    },
    {
      "sense_number": 2,
      "gloss": "to do together (as a suffix)",
      "explanation": "When attached to the stem of another verb, indicates a mutual or reciprocal action."
    }
  ],
