  "reading": "きっちり",
  "part_of_speech": "adverb",
  "gloss": "precisely; exactly; tightly",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "precisely, exactly, punctually",
      "explanation": "With exactness and no room for error, especially regarding time, amounts, or measurements."
    },
    {
      "sense_number": 2,
      "gloss": "tightly, snugly, neatly",
      "explanation": "Fitting closely with no gaps or looseness."
    }
  ],
