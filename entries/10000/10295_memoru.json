  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to jot down, to take notes, to make a memo",
      "explanation": "A casual verb meaning to quickly write something down. Formed by adding the godan verb ending る to the noun メモ (memo)."
    }
  ],
