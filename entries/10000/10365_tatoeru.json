  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to compare, to liken, to use a metaphor",
      "explanation": "To describe something by drawing a comparison to something else. Used when making analogies or metaphors."
    }
  ],
  "examples": [
    {
      "id": "10365_tatoeru_ex1",
      "japanese": "{人生|じんせい}を{旅|たび}に{例|たと}える。",
      "english": "To liken life to a journey.",
