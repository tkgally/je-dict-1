  "headword": "{怪|あや}しい",
  "reading": "あやしい",
  "part_of_speech": "i-adjective",
  "gloss": "suspicious; dubious; uncertain",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "suspicious, shady",
      "explanation": "Describes a person or thing that seems untrustworthy or potentially dangerous."
    },
    {
      "sense_number": 2,
      "gloss": "dubious, uncertain, unreliable",
      "explanation": "Describes something of questionable quality, accuracy, or likelihood."
    }
  ],
  "examples": [
