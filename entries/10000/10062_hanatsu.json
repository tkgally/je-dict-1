  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to release, to let go, to set free",
      "explanation": "To allow something or someone to go free; to release from confinement."
    },
    {
      "sense_number": 2,
      "gloss": "to fire, to shoot, to launch",
      "explanation": "To discharge a projectile such as an arrow, bullet, or light."
    },
    {
      "sense_number": 3,
      "gloss": "to emit, to give off",
      "explanation": "To produce and send out light, smell, or other emanations."
    }
  ],
