  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to refrain from, to hold back, to moderate",
      "explanation": "To avoid doing something or to reduce the amount of something, often for health or social reasons."
    },
    {
      "sense_number": 2,
      "gloss": "to wait, to stand by",
      "explanation": "To wait in readiness, often in an official capacity or as a reserve."
    },
    {
      "sense_number": 3,
      "gloss": "to be imminent, to be approaching",
      "explanation": "Used to indicate that an event is near or upcoming."
    }
  ],
  "examples": [
