  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to shelter, to harbor, to hide (a person)",
      "explanation": "To conceal or protect a person, typically someone being pursued or in danger, by providing refuge."
    }
  ],
  "examples": [
