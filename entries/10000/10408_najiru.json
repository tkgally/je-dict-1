  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to reproach, to rebuke, to blame harshly",
      "explanation": "To strongly criticize or blame someone for a fault or wrongdoing, often with emotional intensity. More accusatory than simply scolding."
    }
  ],
  "examples": [
    {
      "id": "10408_najiru_ex1",
      "japanese": "{彼女|かのじょ}は{彼|かれ}の{無責任|むせきにん}さをなじった。",
      "english": "She reproached him for his irresponsibility.",
      "notes": null,
