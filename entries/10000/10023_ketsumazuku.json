  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to trip, to stumble over",
      "explanation": "To lose one's balance by catching one's foot on something, nearly falling."
    },
    {
      "sense_number": 2,
      "gloss": "to stumble (figuratively), to fail",
      "explanation": "To encounter an unexpected setback or obstacle in one's plans or progress."
    }
  ],
