  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to take advantage of, to exploit",
      "explanation": "To exploit someone's weakness, kindness, or a situation for one's own benefit. Carries a negative connotation of unfair or opportunistic behavior."
    }
  ],
  "examples": [
    {
