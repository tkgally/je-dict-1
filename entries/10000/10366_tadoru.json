  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to trace, to follow a path",
      "explanation": "To follow along a route, trail, or course, often with difficulty or while searching. Used both literally (following a road) and figuratively (tracing a history or process)."
    }
  ],
