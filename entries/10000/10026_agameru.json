  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to worship, to revere",
      "explanation": "To show deep religious devotion or veneration toward a deity or sacred figure."
    },
    {
      "sense_number": 2,
      "gloss": "to idolize, to admire greatly",
      "explanation": "To regard someone with excessive admiration or devotion, treating them almost like a deity."
    }
  ],
