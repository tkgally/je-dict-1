  "definitions": [
    {
      "sense_number": 1,
      "gloss": "clumsy, slow-witted, awkward",
      "explanation": "Describes someone who is physically clumsy, mentally slow, or generally inept. Originally from Kansai dialect but now widely understood."
    }
  ],
  "examples": [
    {
      "id": "10485_donkusai_ex1",
      "japanese": "どんくさいなあ、もう。",
      "english": "You're so clumsy, honestly.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "10485_donkusai_ex2",
      "japanese": "{自分|じぶん}でもどんくさいと{思|おも}う。",
      "english": "Even I think I'm clumsy.",
