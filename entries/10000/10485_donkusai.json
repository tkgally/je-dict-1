      "sense_numbers": [
        1
      ]
    },
    {
      "id": "10485_donkusai_ex3",
      "japanese": "どんくさくて{運動会|うんどうかい}ではいつも{最後|さいご}だった。",
      "english": "I was so clumsy that I always came in last at sports day.",
