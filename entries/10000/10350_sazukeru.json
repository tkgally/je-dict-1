  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to grant, to bestow, to confer",
      "explanation": "To give something of value (an award, title, blessing) from a position of authority or higher status."
    },
    {
      "sense_number": 2,
      "gloss": "to teach, to impart (knowledge, skills)",
      "explanation": "To pass on knowledge or skills, often from master to student."
    }
  ],
