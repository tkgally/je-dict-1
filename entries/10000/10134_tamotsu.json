  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to maintain; to keep; to preserve",
      "explanation": "To keep something in a certain state or condition over time. Used for maintaining health, relationships, appearances, or standards."
    }
  ],
  "examples": [
