      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "10362_sorasu_ex3",
      "japanese": "{都合|つごう}の{悪|わる}い{質問|しつもん}をされると、いつも{視線|しせん}を{逸|そ}らして{答|こた}えない。",
      "english": "Whenever asked an inconvenient question, he always looks away and doesn't answer.",
