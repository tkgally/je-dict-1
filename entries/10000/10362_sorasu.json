  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to turn away, to divert, to avert",
      "explanation": "To redirect one's gaze, attention, or a topic away from something. Used both for physical actions (averting one's eyes) and abstract ones (changing the subject)."
    }
  ],
  "examples": [
