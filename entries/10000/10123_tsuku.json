  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to take up (a position); to assume (a role)",
      "explanation": "To start occupying a position, job, or role. Often used for taking on new responsibilities or positions."
    },
    {
      "sense_number": 2,
      "gloss": "to go to (bed, sleep)",
      "explanation": "To settle into bed or go to sleep. Common in formal or literary contexts."
    }
  ],
