  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to correct; to straighten; to adjust",
      "explanation": "To fix something that is wrong or out of place. Often used for correcting posture, behavior, or errors."
    },
    {
      "sense_number": 2,
      "gloss": "to question; to inquire",
      "explanation": "To formally ask or inquire about something, especially to verify facts or seek clarification."
    }
  ],
