  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to loosen, to become loose, to slacken",
      "explanation": "For something tight to become less tight or firm."
    },
    {
      "sense_number": 2,
      "gloss": "to relax, to ease",
      "explanation": "For tension, strictness, or vigilance to decrease."
    }
  ],
