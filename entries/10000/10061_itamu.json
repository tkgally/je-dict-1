  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be damaged, to become worn",
      "explanation": "For something to become damaged, deteriorated, or worn through use or time."
    },
    {
      "sense_number": 2,
      "gloss": "to spoil, to go bad",
      "explanation": "For food to become rotten or unfit for consumption."
    }
  ],
  "examples": [
