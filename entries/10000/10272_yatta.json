  "part_of_speech": "interjection",
  "gloss": "yay!; I did it!; hooray!",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "yay!, hooray!, I did it!",
      "explanation": "An exclamation of joy or triumph when something good happens or a goal is achieved."
    }
  ],
  "examples": [
    {
      "id": "10272_yatta_ex1",
      "japanese": "やった！{合格|ごうかく}した！",
      "english": "Yay! I passed!",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "10272_yatta_ex2",
      "japanese": "やった、{試合|しあい}に{勝|か}ったぞ！",
      "english": "Yes! We won the game!",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
