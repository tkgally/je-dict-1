  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be particular about, to insist on, to have high standards for",
      "explanation": "To care deeply about quality or details of something, often used positively to describe dedication to craft or standards."
    },
    {
      "sense_number": 2,
      "gloss": "to be fixated on, to be hung up on, to dwell on",
      "explanation": "To be unable to let go of something, often used negatively to describe excessive attachment to trivial matters."
    }
  ],
