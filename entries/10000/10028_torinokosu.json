  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to leave behind, to abandon",
      "explanation": "To go ahead while leaving someone or something behind."
    },
    {
      "sense_number": 2,
      "gloss": "to leave out, to exclude",
      "explanation": "To fail to include someone or something when others are included."
    }
  ],
