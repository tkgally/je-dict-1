  "definitions": [
    {
      "sense_number": 1,
      "gloss": "basis, grounds, foundation",
      "explanation": "The reason or evidence upon which a belief, claim, or action is based."
    }
  ],
  "examples": [
    {
      "id": "10147_konkyo_ex1",
