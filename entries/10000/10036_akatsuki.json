  "definitions": [
    {
      "sense_number": 1,
      "gloss": "dawn, daybreak",
      "explanation": "The time when darkness begins to give way to light; early morning before sunrise."
    },
    {
      "sense_number": 2,
      "gloss": "occasion, time when (something happens)",
      "explanation": "Used in the pattern 〜の暁には to mean 'when (something happens)' or 'on the occasion of'."
    }
  ],
