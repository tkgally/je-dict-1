  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to kick down, to kick off",
      "explanation": "To physically kick someone or something and knock them down or off a surface."
    },
    {
      "sense_number": 2,
      "gloss": "to push aside, to defeat (competitors)",
      "explanation": "To outcompete or defeat rivals in a competitive situation, often with implications of ruthlessness."
    }
  ],
