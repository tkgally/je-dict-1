  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be associated with, to be named after, to derive from",
      "explanation": "To have a connection or origin related to something. Most commonly encountered in the form ちなんで (named after) or the set phrase ちなみに (incidentally, by the way)."
    }
  ],
  "examples": [
    {
      "id": "10386_chinamu_ex1",
      "japanese": "この{祭|まつ}りは{古|ふる}い{伝説|でんせつ}にちなんでいる。",
      "english": "This festival is based on an old legend.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "10386_chinamu_ex2",
      "japanese": "{桜|さくら}にちなんだ{名前|なまえ}を{付|つ}けた。",
      "english": "I gave a name associated with cherry blossoms.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "10386_chinamu_ex3",
      "japanese": "この{通|とお}りは、かつてここに{住|す}んでいた{有名|ゆうめい}な{作家|さっか}にちなんで{名|な}づけられた。",
      "english": "This street was named after a famous writer who once lived here.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    }
  ],
  "notes": "COMMON PATTERNS:\n- 〜にちなんで: named after ~, associated with ~\n- 〜にちなんだ + noun: ~ associated with, ~ named after\n\nRELATED: The common adverb ちなみに (by the way, incidentally) derives from this verb. It is used to add supplementary or related information to a conversation.\n\nUSAGE: Rarely used in its plain dictionary form. Almost always appears as ちなんで, ちなんだ, or in the adverbial form ちなみに.",
