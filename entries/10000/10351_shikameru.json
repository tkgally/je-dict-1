  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to frown, to grimace, to scowl, to knit one's brows",
      "explanation": "To contort one's face, especially the forehead and eyebrows, expressing displeasure, pain, or concentration."
    }
  ],
  "examples": [
