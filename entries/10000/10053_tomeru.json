  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to fasten, to fix, to secure",
      "explanation": "To attach or secure something in place using pins, clips, screws, or similar fasteners."
    },
    {
      "sense_number": 2,
      "gloss": "to pin up, to clip",
      "explanation": "To hold something in place, especially hair or fabric, with a pin or clip."
    }
  ],
