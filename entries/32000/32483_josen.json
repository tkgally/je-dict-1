  "definitions": [
    {
      "sense_number": 1,
      "gloss": "decontamination (especially of radioactive material)",
      "explanation": "Removing radioactive or other harmful contamination from land, buildings, or people. In Japan the word is tied above all to the cleanup after the 2011 Fukushima nuclear accident."
    }
  ],
