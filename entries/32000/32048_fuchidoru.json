  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to border; to edge; to outline",
      "explanation": "To put a line, band or trim around the edge of something, or (of a thing) to form its edge. Often in the passive, {縁取|ふちど}られた (edged with, framed by)."
    }
  ],
  "examples": [
