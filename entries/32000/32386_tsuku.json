  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to come on; to be switched on",
      "explanation": "Of a light, a screen, or a machine: to come on or be on."
    },
    {
      "sense_number": 2,
      "gloss": "to catch fire; to be lit",
      "explanation": "Of a fire or flame: to start burning."
    }
  ],
