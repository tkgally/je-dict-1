  "gloss": "to go for tea; to hang out at a café",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to go for tea; to have a coffee; to hang out at a café",
      "explanation": "To spend time at a café or tea shop, chatting over a drink. Casual spoken Japanese; the point is the socializing rather than the tea itself, so it covers coffee and cake just as well."
    }
  ],
  "examples": [
    {
      "id": "30177_ochasuru_ex1",
      "japanese": "ちょっとお{茶|ちゃ}しない?",
      "english": "Want to grab a coffee?",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
