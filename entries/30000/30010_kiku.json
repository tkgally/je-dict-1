  "part_of_speech": "verb (godan)",
  "gloss": "to listen (attentively); to appreciate (music)",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to listen attentively; to appreciate (music, a lecture)",
      "explanation": "To listen with focused attention and appreciation, especially to music, a concert, or a lecture — deliberate listening rather than merely hearing."
    }
  ],
  "examples": [
    {
      "id": "30010_kiku_ex1",
      "japanese": "{音楽|おんがく}を{聴|き}く。",
      "english": "To listen to music.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "30010_kiku_ex2",
      "japanese": "{毎朝|まいあさ}ラジオを{聴|き}いている。",
      "english": "I listen to the radio every morning.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "30010_kiku_ex3",
      "japanese": "{好|す}きなアーティストの{新曲|しんきょく}をじっくり{聴|き}いた。",
      "english": "I listened carefully to my favorite artist's new song.",
      "sense_numbers": [
