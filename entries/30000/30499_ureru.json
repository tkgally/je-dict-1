{
  "id": "30499_ureru",
  "headword": "{熟|う}れる",
  "reading": "うれる",
  "romaji": "ureru",
  "part_of_speech": "verb-ichidan",
  "gloss": "to ripen; to become ripe",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to ripen; to become ripe (of fruit or grain)",
      "explanation": "For fruit, grain, or seeds to reach full maturity, becoming sweet, soft, and ready to eat. Intransitive: the fruit is the subject, and there is no object."
    }
  ],
  "examples": [
    {
      "id": "30499_ureru_ex1",
      "japanese": "{柿|かき}がよく{熟|う}れている。",
      "english": "The persimmons are nicely ripe.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
