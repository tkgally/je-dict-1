{
  "id": "30048_douden",
  "headword": "導電",
  "reading": "どうでん",
  "romaji": "douden",
  "part_of_speech": "noun, suru verb",
  "gloss": "electrical conduction; conducting electricity",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "electrical conduction; conducting electricity",
      "explanation": "Allowing electric current to pass through a material. Usually appears in compounds such as {導電性|どうでんせい} (conductivity)."
    }
  ],
  "examples": [
    {
      "id": "30048_douden_ex1",
      "japanese": "{金属|きんぞく}は{電気|でんき}を{導電|どうでん}する。",
      "english": "Metals conduct electricity.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "30048_douden_ex2",
      "japanese": "この{素材|そざい}は{導電|どうでん}{性|せい}が{高|たか}い。",
      "english": "This material has high conductivity.",
      "sense_numbers": [
