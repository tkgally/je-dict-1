  "definitions": [
    {
      "sense_number": 1,
      "gloss": "electrical conduction; conducting electricity",
      "explanation": "Allowing electric current to pass through a material. Usually appears in compounds such as {導電性|どうでんせい} (conductivity)."
    }
  ],
  "examples": [
