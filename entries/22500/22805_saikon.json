  "gloss": "remarriage; second marriage",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "remarriage; second marriage",
      "explanation": "Marrying again after a divorce or the death of a spouse."
    }
  ],
  "examples": [
    {
      "id": "22805_saikon_ex1",
      "japanese": "{母|はは}が{再婚|さいこん}した。",
      "english": "My mother remarried.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "22805_saikon_ex2",
      "japanese": "{再婚|さいこん}を{考|かんが}えている。",
      "english": "I'm thinking about remarrying.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "22805_saikon_ex3",
      "japanese": "{彼女|かのじょ}は{離婚|りこん}してから{三|さん}{年後|ねんご}に{再婚|さいこん}した。",
      "english": "She remarried three years after her divorce.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "22805_saikon_ex4",
      "japanese": "{子|こ}どもがいると{再婚|さいこん}は{簡単|かんたん}ではない。",
