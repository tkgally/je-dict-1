  "part_of_speech": "verb (ichidan)",
  "gloss": "to watch; to view (a performance, show, or spectacle)",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to watch; to view (a performance, film, show, or spectacle)",
      "explanation": "To watch something as a spectator, particularly performances, movies, plays, and other forms of entertainment."
    }
  ],
  "examples": [
    {
