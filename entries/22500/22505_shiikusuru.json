  "reading": "しいくする",
  "romaji": "shiikusuru",
  "part_of_speech": "suru verb",
  "gloss": "to breed; to raise; to keep (animals)",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to breed; to raise; to keep (animals)",
      "explanation": "To care for and raise animals, whether domesticated pets or livestock."
    }
  ],
  "examples": [
    {
      "id": "22505_shiikusuru_ex1",
      "japanese": "{熱帯魚|ねったいぎょ}を{飼育|しいく}している。",
      "english": "I keep tropical fish.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "22505_shiikusuru_ex2",
      "japanese": "この{動物園|どうぶつえん}では{希少|きしょう}な{動物|どうぶつ}を{飼育|しいく}している。",
      "english": "This zoo keeps rare animals.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "22505_shiikusuru_ex3",
      "japanese": "{牛|うし}を{飼育|しいく}するには{広|ひろ}い{土地|とち}と{十分|じゅうぶん}な{飼料|しりょう}が{必要|ひつよう}だ。",
      "english": "Raising cattle requires ample land and sufficient feed.",
