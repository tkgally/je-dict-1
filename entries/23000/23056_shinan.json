  "definitions": [
    {
      "sense_number": 1,
      "gloss": "instruction; guidance; coaching; teaching",
      "explanation": "Providing expert instruction or guidance, especially in traditional arts, martial arts, or specialized skills. Carries a nuance of mentorship and hands-on teaching."
    }
  ],
  "examples": [
