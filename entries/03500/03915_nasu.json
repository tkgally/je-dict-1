      "sense_numbers": [
        2
      ]
    },
    {
      "id": "03915_nasu_ex6",
      "japanese": "{一|ひと}つ{一|ひと}つの{努力|どりょく}が{大|おお}きな{成果|せいか}を{為|な}す。",
