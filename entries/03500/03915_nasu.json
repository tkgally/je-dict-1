  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to accomplish, to achieve",
      "explanation": "To successfully complete or bring about something."
    },
    {
      "sense_number": 2,
      "gloss": "to form, to constitute",
      "explanation": "To make up or compose something."
    }
  ],
  "examples": [
    {
      "id": "03915_nasu_ex1",
      "japanese": "{彼|かれ}は{偉業|いぎょう}を{為|な}した。",
      "english": "He accomplished a great achievement.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
