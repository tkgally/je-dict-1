  "definitions": [
    {
      "sense_number": 1,
      "gloss": "ally, supporter, friend",
      "explanation": "Someone who supports you or is on your side."
    },
    {
      "sense_number": 2,
      "gloss": "to side with, to support",
      "explanation": "As a suru-verb, to take someone's side."
    }
  ],
  "examples": [
    {
      "id": "03743_mikata_ex1",
      "japanese": "{彼|かれ}は{私|わたし}の{味方|みかた}だ。",
      "english": "He is on my side.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "03743_mikata_ex2",
      "japanese": "{強|つよ}い{味方|みかた}がいる。",
      "english": "I have a strong ally.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "03743_mikata_ex3",
      "japanese": "{敵|てき}か{味方|みかた}かはっきりしてほしい。",
      "english": "I want you to make clear whether you're friend or foe.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "03743_mikata_ex4",
      "japanese": "{困|こま}ったときに{味方|みかた}になってくれる{友人|ゆうじん}は{大切|たいせつ}だ。",
      "english": "Friends who become your ally when you're in trouble are precious.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "03743_mikata_ex5",
      "japanese": "{彼女|かのじょ}はいつも{弱|よわ}い{者|もの}の{味方|みかた}で、{誰|だれ}からも{信頼|しんらい}されている。",
      "english": "She is always on the side of the weak, and is trusted by everyone.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "03743_mikata_ex6",
      "japanese": "{母|はは}が{味方|みかた}してくれた。",
      "english": "My mother sided with me.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        2
      ]
    },
    {
      "id": "03743_mikata_ex7",
      "japanese": "{誰|だれ}も{味方|みかた}してくれなかった。",
      "english": "Nobody sided with me.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        2
      ]
    },
    {
      "id": "03743_mikata_ex8",
      "japanese": "{兄|あに}はいつも{弟|おとうと}を{味方|みかた}する。",
      "english": "The older brother always sides with the younger brother.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        2
      ]
    },
    {
      "id": "03743_mikata_ex9",
      "japanese": "{親|おや}はどちらの{子|こ}も{味方|みかた}したくないものだ。",
      "english": "Parents don't want to take sides with either child.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        2
      ]
    },
    {
      "id": "03743_mikata_ex10",
      "japanese": "{会議|かいぎ}で{部長|ぶちょう}が{私|わたし}の{意見|いけん}を{味方|みかた}してくれたおかげで、{提案|ていあん}が{通|とお}った。",
