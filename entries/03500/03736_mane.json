  "reading": "まね",
  "part_of_speech": "noun / suru-verb",
  "gloss": "imitation, mimicry",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "imitation, mimicry, copying",
      "explanation": "The act of copying someone's actions, speech, or behavior."
    },
    {
      "sense_number": 2,
      "gloss": "behavior, action",
      "explanation": "Often used in negative expressions to criticize certain behavior."
    }
  ],
  "examples": [
    {
      "id": "03736_mane_ex1",
      "japanese": "{真似|まね}をする。",
      "english": "To imitate.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "03736_mane_ex2",
      "japanese": "{子供|こども}は{親|おや}の{真似|まね}をする。",
      "english": "Children imitate their parents.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "03736_mane_ex3",
      "japanese": "{猿真似|さるまね}では{上達|じょうたつ}しない。",
      "english": "You won't improve by just mindlessly copying.",
      "notes": "{猿真似|さるまね} = blind imitation",
