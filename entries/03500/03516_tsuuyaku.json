  "definitions": [
    {
      "sense_number": 1,
      "gloss": "interpretation (oral translation)",
      "explanation": "The act of translating spoken language from one language to another."
    },
    {
      "sense_number": 2,
      "gloss": "interpreter",
      "explanation": "A person who translates spoken language."
    }
  ],
  "examples": [
