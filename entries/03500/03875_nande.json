  "definitions": [
    {
      "sense_number": 1,
      "gloss": "why, for what reason",
      "explanation": "Used to ask the reason or cause for something."
    },
    {
      "sense_number": 2,
      "gloss": "how, by what means",
      "explanation": "Used to ask about the means or method."
    }
  ],
