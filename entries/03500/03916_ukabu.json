  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to float, to rise to the surface",
      "explanation": "To stay on the surface of water or other liquid without sinking."
    },
    {
      "sense_number": 2,
      "gloss": "to come to mind, to occur to",
      "explanation": "For an idea, thought, or image to suddenly appear in one's consciousness."
    },
    {
      "sense_number": 3,
      "gloss": "to appear (on one's face)",
      "explanation": "For an expression to show on someone's face."
    }
  ],
