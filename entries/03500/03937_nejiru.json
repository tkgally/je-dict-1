  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to twist; to wrench",
      "explanation": "To apply rotational force to something, often forcefully."
    },
    {
      "sense_number": 2,
      "gloss": "to turn; to screw",
      "explanation": "To rotate something like a knob or cap."
    },
    {
      "sense_number": 3,
      "gloss": "to distort; to twist (meaning)",
      "explanation": "To misrepresent or manipulate the meaning of something."
    }
  ],
