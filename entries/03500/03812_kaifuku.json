  "definitions": [
    {
      "sense_number": 1,
      "gloss": "recovery, recuperation",
      "explanation": "The process of returning to a normal state after illness, injury, or difficulty."
    },
    {
      "sense_number": 2,
      "gloss": "restoration, revival",
      "explanation": "The act of bringing something back to its former condition."
    }
  ],
