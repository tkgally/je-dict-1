  "definitions": [
    {
      "sense_number": 1,
      "gloss": "saturation (scientific)",
      "explanation": "The state where a substance cannot absorb or dissolve any more of another substance. Technical term in chemistry and physics."
    },
    {
      "sense_number": 2,
      "gloss": "saturation (market, capacity)",
      "explanation": "The state where something has reached its maximum capacity or limit. Used for markets, resources, or facilities."
    }
  ],
