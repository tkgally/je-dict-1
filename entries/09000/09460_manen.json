  "definitions": [
    {
      "sense_number": 1,
      "gloss": "spread, proliferation, prevalence",
      "explanation": "The widespread spread of something undesirable, particularly diseases, harmful practices, or negative phenomena. Implies something spreading widely like a vine and becoming difficult to control."
    }
  ],
  "examples": [
