  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to malfunction; to glitch",
      "explanation": "For a computer, software, or device to stop working properly or behave unexpectedly."
    },
    {
      "sense_number": 2,
      "gloss": "to go haywire; to act strangely",
      "explanation": "For a person to act erratically or for a situation to become chaotic (figurative usage)."
    }
  ],
