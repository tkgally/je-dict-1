  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be startled; to be scared",
      "explanation": "To feel sudden fear or shock, especially when frightened by something unexpected."
    },
    {
      "sense_number": 2,
      "gloss": "to get nervous; to lose one's nerve",
      "explanation": "To become intimidated or lose confidence in a situation."
    }
  ],
