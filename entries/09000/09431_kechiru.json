  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to skimp, to be stingy, to be cheap about",
      "explanation": "A casual verb meaning to be reluctant to spend money or resources on something, often implying it's unreasonable or petty to do so."
    }
  ],
