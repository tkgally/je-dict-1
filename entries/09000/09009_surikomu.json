  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to imprint; to instill (ideas, values)",
      "explanation": "To deeply embed ideas, beliefs, or behaviors through repeated exposure or conditioning, especially during formative periods."
    },
    {
      "sense_number": 2,
      "gloss": "to rub in; to work into",
      "explanation": "To physically rub something into a surface so it penetrates or absorbs."
    }
  ],
  "examples": [
    {
      "id": "09009_surikomu_ex1",
