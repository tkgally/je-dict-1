  "part_of_speech": "particle",
  "gloss": "sentence-ending particle (emphasis, assertion)",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "assertion, emphasis",
      "explanation": "Used to assert information that the speaker believes the listener doesn't know or to emphasize a point."
    },
    {
      "sense_number": 2,
      "gloss": "giving advice or commands",
      "explanation": "Adds emphasis to suggestions, advice, or gentle commands."
    }
  ],
