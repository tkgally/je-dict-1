  "definitions": [
    {
      "sense_number": 1,
      "gloss": "anguish, agony, torment",
      "explanation": "Deep mental suffering and distress, especially when troubled by difficult problems, moral dilemmas, or situations with no clear solution. Implies prolonged inner turmoil."
    }
  ],
  "examples": [
