  "definitions": [
    {
      "sense_number": 1,
      "gloss": "pardon, forgiveness, forbearance",
      "explanation": "The act of excusing someone's mistake or offense, or tolerating an inconvenience. Often used in requests asking someone to let something slide or spare the speaker from something unpleasant."
    }
  ],
  "examples": [
    {
      "id": "09443_kanben_ex1",
      "japanese": "{勘弁|かんべん}してください。",
      "english": "Please forgive me. / Give me a break.",
