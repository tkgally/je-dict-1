  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to skip; to cut (class/work)",
      "explanation": "To intentionally miss school, work, or an obligation."
    },
    {
      "sense_number": 2,
      "gloss": "to slack off; to shirk",
      "explanation": "To avoid doing one's duties or to do them half-heartedly."
    }
  ],
