  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to joke around; to fool around; to play",
      "explanation": "To behave in a playful or silly manner, not taking things seriously."
    },
    {
      "sense_number": 2,
      "gloss": "to mess around; to be ridiculous",
      "explanation": "To behave inappropriately or in an annoying way (often used critically)."
    }
  ],
