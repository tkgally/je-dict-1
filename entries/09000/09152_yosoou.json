  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to pretend, to feign, to act as if",
      "explanation": "To act as if something is true or to present a false appearance. Often used for pretending not to know something or putting on a facade."
    },
    {
      "sense_number": 2,
      "gloss": "to dress up, to adorn, to decorate",
      "explanation": "To dress oneself or decorate something in a certain way. Often used for putting on formal attire or decorating for occasions."
    }
  ],
