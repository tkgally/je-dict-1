  "definitions": [
    {
      "sense_number": 1,
      "gloss": "big; huge; large",
      "explanation": "Describing something of great size. A casual/emphatic alternative to 大きい."
    }
  ],
  "examples": [
    {
      "id": "09320_dekai_ex1",
      "japanese": "でかい⟦{犬|いぬ}→犬：00632_inu⟧だな。",
      "english": "That's a big dog.",
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "09320_dekai_ex2",
      "japanese": "⟦この→この：00962_kono⟧⟦{魚|さかな}→魚：00499_sakana⟧でかすぎ！",
      "english": "This fish is way too big!",
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "09320_dekai_ex3",
      "japanese": "でかい⟦{声|こえ}→声：02207_koe⟧⟦で→で：00502_de⟧⟦{話|はな}す→話す：00467_hanasu⟧な。",
