  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to writhe in pain, to suffer agony",
      "explanation": "To twist and turn one's body due to intense physical pain or emotional distress."
    },
    {
      "sense_number": 2,
      "gloss": "to agonize, to be tormented (emotionally)",
      "explanation": "To suffer intense emotional distress such as frustration, longing, or jealousy."
    }
  ],
