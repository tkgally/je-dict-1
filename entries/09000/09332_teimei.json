  "definitions": [
    {
      "sense_number": 1,
      "gloss": "stagnation, slump, sluggishness",
      "explanation": "A state of being stuck at a low level without improvement. Often used for economic conditions, business performance, or other measurable indicators that remain depressed."
    }
  ],
