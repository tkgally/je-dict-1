  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to marinate; to pickle; to soak in liquid",
      "explanation": "To immerse food in a marinade, brine, or other liquid for an extended period to add flavor or preserve it."
    }
  ],
  "examples": [
