  "definitions": [
    {
      "sense_number": 1,
      "gloss": "embezzlement; misappropriation of funds",
      "explanation": "The criminal act of taking money or property that has been entrusted to one's care, typically in a professional or fiduciary capacity."
    }
  ],
  "examples": [
