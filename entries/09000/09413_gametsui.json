  "definitions": [
    {
      "sense_number": 1,
      "gloss": "greedy, grasping, money-grubbing",
      "explanation": "Describes someone who is excessively focused on getting money or material gain, often at the expense of others. Has a strongly negative connotation."
    }
  ],
  "examples": [
    {
      "id": "09413_gametsui_ex1",
      "japanese": "あいつはがめついな。",
      "english": "That guy is so greedy.",
