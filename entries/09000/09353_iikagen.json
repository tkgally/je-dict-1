  "definitions": [
    {
      "sense_number": 1,
      "gloss": "irresponsible, sloppy, half-hearted",
      "explanation": "Describes careless, unreliable behavior or work done without proper attention."
    },
    {
      "sense_number": 2,
      "gloss": "enough already, cut it out",
      "explanation": "Used to express frustration and demand that someone stop what they're doing."
    },
    {
      "sense_number": 3,
      "gloss": "moderately, appropriately",
      "explanation": "Describes doing something to a reasonable degree, not too much or too little."
    }
  ],
