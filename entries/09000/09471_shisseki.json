  "definitions": [
    {
      "sense_number": 1,
      "gloss": "reprimand, scolding, rebuke",
      "explanation": "The act of severely scolding someone for their mistakes or wrongdoing. Used in both personal and professional contexts, typically by someone in a position of authority."
