  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to lose interest; to become bored",
      "explanation": "For enthusiasm or excitement to fade away."
    },
    {
      "sense_number": 2,
      "gloss": "to become awkward; to kill the mood",
      "explanation": "For a fun atmosphere to suddenly become uncomfortable or stale, often due to an inappropriate comment or action."
    }
  ],
