  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to bite into, to sink one's teeth into",
      "explanation": "To bite and hold onto something firmly. Literal meaning used for animals or aggressive biting."
    },
    {
      "sense_number": 2,
      "gloss": "to cling to, to pursue tenaciously, to stick with",
      "explanation": "To pursue something with determination and not give up. Figurative meaning emphasizing persistence."
    }
  ],
