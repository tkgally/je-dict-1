      "sense_number": 1,
      "gloss": "small; tiny; little",
      "explanation": "Describing something of small size. A casual/cute alternative to 小さい."
    }
  ],
  "examples": [
    {
      "id": "09321_chicchai_ex1",
      "japanese": "ちっちゃい{手|て}だね。",
      "english": "You have tiny hands.",
