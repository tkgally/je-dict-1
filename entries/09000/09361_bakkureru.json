  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to skip out on, ditch, bail on",
      "explanation": "To fail to show up for or abandon an obligation, often without notice or explanation."
    },
    {
      "sense_number": 2,
      "gloss": "to play dumb, feign ignorance",
      "explanation": "To pretend not to know about something, especially to avoid responsibility."
    }
  ],
