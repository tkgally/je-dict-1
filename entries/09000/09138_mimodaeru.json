  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to writhe (in pain), to squirm, to wriggle in agony",
      "explanation": "To twist and move one's whole body intensely due to pain, discomfort, or strong emotion. More emphatic than {悶|もだ}える."
