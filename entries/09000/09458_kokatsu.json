  "definitions": [
    {
      "sense_number": 1,
      "gloss": "exhaustion, depletion, drying up",
      "explanation": "The state of resources, supplies, or sources becoming completely used up or depleted. Used for both physical resources (water, oil) and abstract ones (ideas, energy, funds)."
    }
  ],
