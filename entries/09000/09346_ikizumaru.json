  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to reach a dead end, to come to an impasse",
      "explanation": "To find oneself unable to proceed further in a physical path, plan, or negotiation. The situation cannot move forward."
    },
    {
      "sense_number": 2,
      "gloss": "to get stuck, to stall, to be at a loss",
      "explanation": "To become unable to continue work or thinking because of difficulties. Often used for creative blocks or problem-solving."
    }
  ],
