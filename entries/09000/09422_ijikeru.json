  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to sulk, to become withdrawn, to be dejected",
      "explanation": "To become emotionally closed off or sulky, often in response to feeling hurt, disappointed, or insecure. Can also describe a timid or twisted personality that develops from such experiences."
    }
  ],
