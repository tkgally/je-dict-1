  "reading": "くだらない",
  "part_of_speech": "i-adjective",
  "gloss": "worthless, trivial, stupid",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "worthless, trivial, pointless",
      "explanation": "Describes something that has no value, importance, or meaning. Used to dismiss things as a waste of time."
    },
    {
      "sense_number": 2,
      "gloss": "stupid, silly, ridiculous",
      "explanation": "Describes something as foolish or not worthy of serious consideration."
    }
  ],
  "examples": [
    {
