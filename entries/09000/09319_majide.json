  "definitions": [
    {
      "sense_number": 1,
      "gloss": "seriously; really; truly",
      "explanation": "Used to emphasize that something is genuine or true, or to express strong feelings."
    },
    {
      "sense_number": 2,
      "gloss": "really? (question)",
      "explanation": "Used to express surprise or disbelief."
    }
  ],
