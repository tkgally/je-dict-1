  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to boil down; to simmer down; to reduce",
      "explanation": "To cook a liquid until it reduces in volume, concentrating flavors."
    },
    {
      "sense_number": 2,
      "gloss": "to thrash out; to finalize; to hammer out",
      "explanation": "To discuss something thoroughly until reaching a conclusion or final form."
    }
  ],
