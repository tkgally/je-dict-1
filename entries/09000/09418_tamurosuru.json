  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to hang around, to loiter, to gather (in a group)",
      "explanation": "To gather and stay in a place without any particular purpose, often implying a slightly negative nuance of loitering or being idle."
    }
  ],
  "examples": [
    {
      "id": "09418_tamurosuru_ex1",
      "japanese": "{若者|わかもの}がたむろしている。",
      "english": "Young people are hanging around.",
