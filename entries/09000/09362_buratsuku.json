{
  "id": "09362_buratsuku",
  "headword": "ぶらつく",
  "reading": "ぶらつく",
  "part_of_speech": "verb (godan)",
  "gloss": "to wander, stroll, hang around",
  "conjugation": {
    "type": "godan",
