    "stem": "ぶらつ"
  },
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to wander, stroll around aimlessly",
      "explanation": "To walk around without a specific destination, often for leisure or to kill time."
    },
    {
      "sense_number": 2,
      "gloss": "to hang around, loiter",
      "explanation": "To spend time in an area without doing anything particular."
    }
  ],
  "examples": [
