  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be timid, to flinch, to be daunted, to lose one's nerve",
      "explanation": "To feel intimidated or fearful, causing hesitation or loss of confidence. Often used in negative constructions to describe someone who doesn't back down."
