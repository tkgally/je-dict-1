  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to conform to; to apply correspondingly; to treat as equivalent",
      "explanation": "To follow a standard or model, or to apply rules/conditions in an analogous way. Often used in legal and formal contexts meaning 'the same applies' or 'mutatis mutandis'."
    }
  ],
  "examples": [
