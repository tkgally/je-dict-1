  "gloss": "shabby; pathetic; lame",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "shabby; rundown; poor quality",
      "explanation": "Describing something that looks worn out, cheap, or of low quality."
    },
    {
      "sense_number": 2,
      "gloss": "pathetic; lame; unimpressive",
      "explanation": "Describing something disappointing or someone who seems weak or pitiful."
    }
  ],
  "examples": [
