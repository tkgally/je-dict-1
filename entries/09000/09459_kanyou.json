  "definitions": [
    {
      "sense_number": 1,
      "gloss": "cultivation, nurturing, fostering",
      "explanation": "The gradual development and nurturing of qualities, abilities, or resources over time. Often used for developing character, skills, or replenishing natural resources like groundwater."
    }
  ],
