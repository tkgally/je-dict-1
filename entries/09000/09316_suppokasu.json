  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to stand someone up; to bail on",
      "explanation": "To fail to show up for an appointment or meeting without notice."
    },
    {
      "sense_number": 2,
      "gloss": "to skip; to neglect",
      "explanation": "To neglect or avoid doing something one should do."
    }
  ],
