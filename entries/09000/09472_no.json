  "part_of_speech": "particle",
  "gloss": "possessive marker, nominalizer, explanatory",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "possessive marker (of, 's)",
      "explanation": "Connects nouns to show possession, affiliation, or attribution. Similar to English \"of\" or \"'s\"."
    },
    {
      "sense_number": 2,
      "gloss": "nominalizer",
      "explanation": "Turns verbs and adjectives into noun phrases. Often used with が for emphasis on the nominalized clause."
    },
    {
      "sense_number": 3,
      "gloss": "explanatory (のだ/んだ)",
      "explanation": "Used in のです/のだ/んです/んだ patterns to give explanations, seek explanations, or add emotional emphasis."
    }
  ],
