  "definitions": [
    {
      "sense_number": 1,
      "gloss": "debauchery, dissipation, profligacy",
      "explanation": "A lifestyle of excessive indulgence in sensual pleasures, particularly drinking, gambling, and womanizing, often while squandering money. Implies moral corruption and neglect of responsibilities."
