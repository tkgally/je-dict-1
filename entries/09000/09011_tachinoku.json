  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to vacate; to move out; to evacuate",
      "explanation": "To leave and empty a place, especially a residence or property, often due to eviction, development, or emergency."
    }
  ],
  "examples": [
    {
      "id": "09011_tachinoku_ex1",
