  "definitions": [
    {
      "sense_number": 1,
      "gloss": "patience, tolerance, forbearance",
      "explanation": "The act of enduring or putting up with something difficult, or forgiving someone's offense. Has a somewhat old-fashioned or regional (especially Kansai) flavor compared to {勘弁|かんべん}."
    }
  ],
