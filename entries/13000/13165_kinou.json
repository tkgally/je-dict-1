  "definitions": [
    {
      "sense_number": 1,
      "gloss": "function, capability, role",
      "explanation": "The natural action or purpose that something is designed to perform. Used for the functions of organs, machines, systems, or organizations."
    },
    {
      "sense_number": 2,
      "gloss": "feature, functionality",
      "explanation": "A specific capability or feature of a device, software, or system. Common in technology and product descriptions."
    }
  ],
