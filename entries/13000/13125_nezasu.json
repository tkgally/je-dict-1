  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be rooted in, to be based on, to originate from",
      "explanation": "To have deep roots in something, to be firmly grounded in a particular source, culture, or origin. Almost always used figuratively for ideas, customs, feelings, or problems that stem from a deep underlying source."
    }
  ],
