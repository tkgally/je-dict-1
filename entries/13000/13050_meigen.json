  "definitions": [
    {
      "sense_number": 1,
      "gloss": "clear statement, explicit declaration",
      "explanation": "The act of stating something clearly and unambiguously, leaving no room for doubt or misinterpretation. Often used when someone takes a definitive stance or makes an official position clear."
    }
  ],
