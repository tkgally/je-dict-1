  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to worry, to be anxious about",
      "explanation": "To feel concerned or anxious about something. A somewhat literary or formal word for worrying. Often appears in the proverb {案|あん}ずるより{産|う}むが{易|やす}し."
    },
    {
      "sense_number": 2,
      "gloss": "to think of, to devise",
      "explanation": "To think about or come up with a plan or idea. A literary usage meaning to ponder or devise."
    }
  ],
