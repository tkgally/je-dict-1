  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to hesitate, to be reluctant, to balk",
      "explanation": "To show unwillingness or reluctance to do something, often while not outright refusing. Implies dragging one's feet or being unenthusiastic about cooperating."
    }
  ],
  "examples": [
    {
