  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to become clear, to be transparent",
      "explanation": "For water, air, or sky to become free of impurities and turn clear or transparent."
    },
    {
      "sense_number": 2,
      "gloss": "to be clear and pure (of sound or eyes)",
      "explanation": "For a sound to ring clearly and beautifully, or for eyes to appear bright and pure."
    }
  ],
