  "definitions": [
    {
      "sense_number": 1,
      "gloss": "rating, ranking, classification, grading",
      "explanation": "The act of assigning a rank, grade, or rating to something based on quality, creditworthiness, or other criteria. Widely used in finance for credit ratings, and in food and services for quality grading."
    }
  ],
