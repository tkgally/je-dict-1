  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to set afloat, to float",
      "explanation": "To place something on the surface of water or another liquid so that it floats."
    },
    {
      "sense_number": 2,
      "gloss": "to show, to wear (an expression)",
      "explanation": "To let a facial expression appear on one's face. Most commonly used with smiles, tears, or other emotional expressions."
    }
  ],
