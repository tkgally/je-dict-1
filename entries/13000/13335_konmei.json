  "definitions": [
    {
      "sense_number": 1,
      "gloss": "turmoil, confusion, chaos, bewilderment",
      "explanation": "A state of disorder and uncertainty where a clear direction or resolution is lacking. Typically used for political situations, economic conditions, or social affairs that are in disarray."
    }
  ],
