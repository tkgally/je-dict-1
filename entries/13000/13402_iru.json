  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to roast, to parch, to toast (dry heat)",
      "explanation": "To cook something using dry heat without oil, typically in a pan or over direct heat. Used for beans, seeds, nuts, and similar ingredients."
    }
