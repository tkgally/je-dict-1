  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to brew, to make (tea or coffee)",
      "explanation": "To prepare tea or coffee by pouring hot water over leaves or grounds. This kanji specifically refers to the process of brewing a beverage, as distinct from the general verb {入|い}れる (to put in)."
    }
  ],
