  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to master, to carry to perfection",
      "explanation": "To pursue something to the highest possible level; to achieve complete mastery of a skill, art, or discipline."
    },
    {
      "sense_number": 2,
      "gloss": "to reach the extreme of, to be extremely",
      "explanation": "To reach the utmost degree of a state or condition. Often used in the form を{極|きわ}める to express reaching the peak of something."
    }
  ],
  "examples": [
    {
