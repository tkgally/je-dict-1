  "definitions": [
    {
      "sense_number": 1,
      "gloss": "ignoring, disregarding, paying no attention to",
      "explanation": "Deliberately choosing not to acknowledge, respond to, or take into account something or someone. Can range from socially ignoring a person to professionally disregarding rules or facts."
    }
  ],
