  "definitions": [
    {
      "sense_number": 1,
      "gloss": "mimicry, impersonation, imitation",
      "explanation": "The act of imitating someone's voice, mannerisms, or appearance for entertainment. A popular form of comedy in Japan, where professional impersonators mimic celebrities on television shows."
    }
  ],
