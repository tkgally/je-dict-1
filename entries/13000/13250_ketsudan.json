  "definitions": [
    {
      "sense_number": 1,
      "gloss": "decision; resolution; determination",
      "explanation": "A firm, often weighty decision made after careful thought. Emphasizes the resolve and commitment behind the decision rather than the act of choosing itself."
    }
  ],
