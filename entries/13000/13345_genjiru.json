  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to reduce, to decrease, to diminish",
      "explanation": "To make something smaller in amount, degree, or intensity. A formal or written-style verb used in official, academic, and journalistic contexts. Can be used both transitively (to reduce something) and intransitively (for something to decrease)."
    }
  ],
