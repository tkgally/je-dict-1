  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to make (tea, esp. matcha)",
      "explanation": "To prepare tea, especially matcha, by whisking the powdered tea with hot water using a bamboo whisk. A term associated with tea ceremony and traditional tea preparation."
    }
  ],
