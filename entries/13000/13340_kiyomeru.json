  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to purify, to cleanse ritually",
      "explanation": "To make something spiritually or ritually clean. Strongly associated with Shinto purification rites such as sprinkling salt, washing hands at a shrine, or performing other purification rituals."
    },
    {
      "sense_number": 2,
      "gloss": "to clean, to make pure",
      "explanation": "To make something physically or morally clean. Used more broadly for cleaning a space or purifying one's heart or mind."
    }
  ],
