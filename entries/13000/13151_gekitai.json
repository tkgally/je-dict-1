  "definitions": [
    {
      "sense_number": 1,
      "gloss": "repelling, driving back, repulsing",
      "explanation": "The act of fighting off and forcing back an attacker, invader, or unwanted presence. Used for military repulsion, pest control, and figuratively for overcoming challenges."
    }
