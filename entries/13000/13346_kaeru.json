  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to exchange, to convert, to swap",
      "explanation": "To exchange one thing for another of equivalent or comparable value. Emphasizes conversion or swapping between things of the same category, such as currency exchange or converting units. Distinct from {変|か}える (to change the nature of something) and {代|か}える (to substitute one thing for another)."
    }
  ],
