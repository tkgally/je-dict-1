  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to deceive, to trick, to fool, to delude",
      "explanation": "To deliberately mislead someone by lies, disguise, or manipulation. A literary or formal word for deception, carrying a stronger moral weight than casual words like だます."
    }
  ],
  "examples": [
