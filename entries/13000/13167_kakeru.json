  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to chip, to crack, to break off",
      "explanation": "For a piece to break off from a hard object such as a dish, tooth, or stone. Describes the result of damage rather than the action of breaking."
    },
    {
      "sense_number": 2,
      "gloss": "to be lacking, to be missing, to be incomplete",
      "explanation": "For something essential to be absent or insufficient, making the whole incomplete. Used for members, qualities, or conditions that are missing."
    }
  ],
