  "definitions": [
    {
      "sense_number": 1,
      "gloss": "downfall, ruin, destruction, collapse",
      "explanation": "The complete destruction or collapse of a nation, civilization, dynasty, or organization. Implies a final, irreversible end. Used in historical contexts for the fall of empires and in fiction for apocalyptic scenarios."
    }
  ],
