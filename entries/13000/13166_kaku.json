  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to lack, to be without, to be missing",
      "explanation": "To not have something that is normally expected or necessary. Used for abstract qualities like manners, common sense, or essential conditions rather than physical objects."
    },
    {
      "sense_number": 2,
      "gloss": "to chip, to break off a piece",
      "explanation": "To break or chip off part of something, especially a hard object like a tooth, cup, or plate. The transitive counterpart of 欠ける."
    }
  ],
