  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to well up, to spring forth, to gush out",
      "explanation": "For water, hot springs, or other liquids to emerge naturally from the ground."
    },
    {
      "sense_number": 2,
      "gloss": "to surge, to well up (emotions, ideas)",
      "explanation": "For feelings, thoughts, motivation, or interest to arise spontaneously from within."
    }
  ],
