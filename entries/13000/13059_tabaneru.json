  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to bundle, to tie together, to gather into a bunch",
      "explanation": "To collect loose items and bind them together into a single bundle or bunch. Used for physical objects like hair, flowers, documents, or sticks."
    },
    {
      "sense_number": 2,
      "gloss": "to lead, to unite, to bring together (people or groups)",
      "explanation": "To organize and lead a group of people, or to bring diverse individuals or factions together under unified direction."
    }
  ],
