  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to come to a boil, to boil up",
      "explanation": "For a liquid to reach boiling point and begin bubbling vigorously. Used in cooking to describe soup, broth, or sauces coming to a boil."
