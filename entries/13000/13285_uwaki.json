  "definitions": [
    {
      "sense_number": 1,
      "gloss": "infidelity, cheating, having an affair",
      "explanation": "Romantic or sexual involvement with someone other than one's partner. Can refer to the act itself or the tendency toward such behavior."
    },
    {
      "sense_number": 2,
      "gloss": "fickleness, flightiness",
      "explanation": "A changeable, inconstant nature. Being easily attracted to new things and quickly losing interest. Less common than sense 1 in modern usage."
    }
  ],
