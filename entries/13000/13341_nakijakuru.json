  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to sob, to cry convulsively",
      "explanation": "To cry uncontrollably with gasping, hiccupping breaths. Describes intense, convulsive crying where the person can barely catch their breath. Most commonly describes children's crying but also used for adults overwhelmed by emotion."
    }
  ],
