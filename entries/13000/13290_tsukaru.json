  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to soak, to be submerged in liquid",
      "explanation": "To be partially or fully immersed in water or another liquid. Often used for bathing or soaking food."
    },
    {
      "sense_number": 2,
      "gloss": "to be steeped in, to be absorbed in",
      "explanation": "To be deeply immersed in a feeling, atmosphere, or activity. A figurative extension of the physical meaning."
    }
  ],
