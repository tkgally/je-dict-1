  "definitions": [
    {
      "sense_number": 1,
      "gloss": "establishment, founding, setting (a record)",
      "explanation": "To firmly establish something significant, such as a policy, record, or system. Carries a sense of creating something lasting and important. Commonly used for setting records in sports or establishing diplomatic relations."
    }
  ],
