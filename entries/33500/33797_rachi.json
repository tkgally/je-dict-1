  "gloss": "abduction; kidnapping",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "abduction; kidnapping; taking someone away by force",
      "explanation": "Seizing a person and carrying them off by force. In Japan the word is closely tied to the abductions of Japanese citizens by North Korea ({拉致|らち}{問題|もんだい})."
    }
  ],
  "examples": [
    {
      "id": "33797_rachi_ex1",
      "japanese": "⟦{男|おとこ}→男：00561_otoko⟧⟦が→が：00051_ga⟧{拉致|らち}⟦された→する：00392_suru⟧。",
      "english": "A man was abducted.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "33797_rachi_ex2",
      "japanese": "{拉致|らち}⟦{問題|もんだい}→問題：00797_mondai⟧⟦の→の：09472_no⟧⟦{解決|かいけつ}→解決：00136_kaiketsu⟧⟦を→を：00422_wo⟧⟦{求|もと}める→求める：02316_motomeru⟧。",
      "english": "They call for a resolution of the abduction issue.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "33797_rachi_ex3",
      "japanese": "⟦{犯人|はんにん}→犯人：03572_hannin⟧⟦グループ→グループ：03840_guruupu⟧⟦は→は：00079_ha⟧⟦{社長|しゃちょう}→社長：01428_shachou⟧⟦を→を：00422_wo⟧{拉致|らち}し、⟦{身代金|みのしろきん}→身代金：14302_minoshirokin⟧⟦を→を：00422_wo⟧⟦{要求|ようきゅう}した→要求する：25533_youkyuusuru⟧。",
      "english": "The gang abducted the company president and demanded a ransom.",
