  "definitions": [
    {
      "sense_number": 1,
      "gloss": "whitish; close to white; pale",
      "explanation": "Of a color near white but not pure white: pale, faded or cloudy. Formed from {白|しろ} and the suffix っぽい (-ish)."
    }
  ],
