  "definitions": [
    {
      "sense_number": 1,
      "gloss": "declaration, assertion, affirmation",
      "explanation": "A confident, definitive statement made without hesitation or qualification. Implies the speaker is certain of what they are saying and is willing to commit fully to the claim."
    }
  ],
  "examples": [
    {
