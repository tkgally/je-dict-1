  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to suppress, to restrain, to hold back",
      "explanation": "To keep feelings, impulses, or reactions from being expressed or from getting out of control."
    },
    {
      "sense_number": 2,
      "gloss": "to curb, to keep down, to limit",
      "explanation": "To prevent something from increasing or spreading, such as costs, inflation, or symptoms."
    }
  ],
  "examples": [
