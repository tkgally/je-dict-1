  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be indignant, to be furious, to be outraged",
      "explanation": "To feel intense anger or indignation, particularly in response to injustice, unfairness, or something morally wrong. Carries a sense of righteous anger rather than mere personal irritation."
    }
  ],
  "examples": [
    {
