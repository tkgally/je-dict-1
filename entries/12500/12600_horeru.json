  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to fall in love with, to be smitten by",
      "explanation": "To develop romantic feelings for someone, typically in a spontaneous and somewhat passionate way. More colloquial and direct than 恋をする."
    },
    {
      "sense_number": 2,
      "gloss": "to be captivated by, to be charmed by",
      "explanation": "To be deeply impressed or captivated by someone's skill, personality, or some quality of a thing. Not necessarily romantic."
    }
  ],
