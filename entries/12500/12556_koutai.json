  "definitions": [
    {
      "sense_number": 1,
      "gloss": "retreat, moving backward",
      "explanation": "Physical movement backward or withdrawal from a position. Used for troops, vehicles, or people stepping back."
    },
    {
      "sense_number": 2,
      "gloss": "setback, decline, regression",
      "explanation": "A figurative worsening or reversal of progress. Used for economic downturns, declining conditions, or loss of ground in negotiations or reforms."
    }
  ],
