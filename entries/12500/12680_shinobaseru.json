  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to hide, to conceal, to secretly carry",
      "explanation": "To secretly place or carry something hidden, typically on one's person or in a bag. Implies deliberate concealment with a purpose — the hidden item is kept ready for use."
