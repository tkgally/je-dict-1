  "definitions": [
    {
      "sense_number": 1,
      "gloss": "support, backing, boost, push from behind",
      "explanation": "Help or encouragement that gives someone the push they need to move forward or succeed. Originally from the literal act of pushing from behind, now primarily used figuratively."
    }
