  "schema_version": "2.0",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to set, to place, to install, to position",
      "explanation": "To place something firmly in a fixed position. Used for installing equipment, placing furniture, or positioning something with care."
    },
    {
      "sense_number": 2,
      "gloss": "to fix, to settle, to focus (one's eyes, resolve)",
      "explanation": "To fix or steady something abstract — one's gaze, one's resolve, or one's stomach. Often appears in set expressions."
    }
  ],
