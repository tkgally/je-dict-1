  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to point at, to indicate with one's finger",
      "explanation": "To extend one's finger toward a person, object, or direction to indicate it. Can also be used figuratively to mean singling someone out for criticism."
    }
  ],
