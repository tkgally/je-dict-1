  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to overcome, to triumph over, to conquer",
      "explanation": "To defeat or prevail against an opponent, difficulty, or adversity. Often used for overcoming internal struggles, hardships, or formidable challenges."
    }
  ],
  "examples": [
