  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be accompanied by, to have in tow, to lead",
      "explanation": "To have subordinates, attendants, or followers accompany you. Implies a hierarchical relationship where the subject is the leader or person of higher status."
    }
  ],
