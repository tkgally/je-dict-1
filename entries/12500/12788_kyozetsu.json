  "schema_version": "2.0",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "rejection, refusal, repudiation",
      "explanation": "A firm, definitive refusal to accept something — a request, a demand, a person, or an idea. Stronger and more absolute than a simple refusal."
    }
  ],
  "examples": [
