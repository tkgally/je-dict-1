  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to reveal, to disclose, to confess",
      "explanation": "To make something hidden or secret known. Often used for revealing one's identity, a secret, or the truth."
    },
    {
      "sense_number": 2,
      "gloss": "to spend (the night), to stay up all night",
      "explanation": "To pass the night doing something. Often used in the pattern 〜{明|あ}かす to mean spending the entire night engaged in an activity."
    }
  ],
