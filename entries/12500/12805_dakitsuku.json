  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to cling to, to embrace tightly, to throw one's arms around",
      "explanation": "To grab hold of someone or something tightly with both arms. Implies a sudden or emotional embrace, often out of joy, fear, or affection."
    }
  ],
  "examples": [
