  "definitions": [
    {
      "sense_number": 1,
      "gloss": "conquest, subjugation",
      "explanation": "The act of conquering a territory, people, or enemy by military force. Used in historical and political contexts."
    },
    {
      "sense_number": 2,
      "gloss": "conquest, mastery, overcoming",
      "explanation": "Figuratively, the act of overcoming a challenge or mastering something difficult, such as climbing a mountain, winning over an audience, or mastering a skill."
    }
  ],
