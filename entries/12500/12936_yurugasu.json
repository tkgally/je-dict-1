  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to shake, to rock",
      "explanation": "To cause something to shake or sway physically."
    },
    {
      "sense_number": 2,
      "gloss": "to undermine, to destabilize, to threaten",
      "explanation": "To shake the foundations of something figuratively — to threaten the stability of a system, belief, position, or relationship."
    }
  ],
