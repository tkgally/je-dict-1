  "definitions": [
    {
      "sense_number": 1,
      "gloss": "revenge, vengeance, retaliation",
      "explanation": "The act of inflicting harm or punishment on someone in return for a wrong or injury they have caused. A deliberate act of retribution motivated by a grievance."
    }
  ],
