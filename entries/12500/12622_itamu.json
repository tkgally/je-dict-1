  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to mourn, to grieve for, to lament someone's death",
      "explanation": "To feel and express sorrow over someone's death. Used specifically for mourning the deceased, not for general sadness."
    }
  ],
