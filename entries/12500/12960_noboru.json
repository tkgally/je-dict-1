  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to rise, to ascend",
      "explanation": "Used for things that rise naturally — the sun, moon, smoke, steam, etc. Describes upward motion of natural phenomena rather than physical climbing by a person."
    }
  ],
