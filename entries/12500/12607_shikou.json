  "definitions": [
    {
      "sense_number": 1,
      "gloss": "inclination, orientation, tendency toward",
      "explanation": "A direction of interest or aspiration. Describes what someone or something is oriented toward or aims for. Often used as a suffix-like element in compound expressions."
