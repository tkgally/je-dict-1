  "definitions": [
    {
      "sense_number": 1,
      "gloss": "exploitation, squeezing, extortion",
      "explanation": "The act of unfairly taking advantage of others for profit or benefit, especially in labor or economic relationships. A strongly negative term implying systematic unfairness."
    }
  ],
  "examples": [
    {
