  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to poke, to thrust, to stab",
      "explanation": "To push or strike something with a pointed or narrow object, or with a forward motion."
    },
    {
      "sense_number": 2,
      "gloss": "to prop, to lean on",
      "explanation": "To rest part of the body against a surface, or to use something as support. Often used for elbows on a table or walking with a cane."
    }
  ],
