  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to hand over, to deliver in person, to hand to",
      "explanation": "To give something directly to someone by hand, rather than sending it by mail or through an intermediary. Emphasizes the physical, face-to-face delivery."
    }
  ],
