  "definitions": [
    {
      "sense_number": 1,
      "gloss": "guess, conjecture, speculation, inference",
      "explanation": "The act of forming an opinion or conclusion based on incomplete information or indirect evidence. Less certain than a conclusion based on proof."
    }
  ],
