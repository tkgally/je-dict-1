  "definitions": [
    {
      "sense_number": 1,
      "gloss": "jumping to conclusions, hasty misunderstanding",
      "explanation": "Misunderstanding or misinterpreting something because of acting too quickly without confirming the facts. Can refer to both the act and the person who does it."
    }
  ],
