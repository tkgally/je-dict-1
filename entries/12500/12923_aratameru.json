  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to reform, to revise, to correct",
      "explanation": "To change something for the better, to amend or correct faults, habits, or systems."
    },
    {
      "sense_number": 2,
      "gloss": "to examine, to inspect, to check",
      "explanation": "To look at something carefully to verify or confirm it. Often used for formal inspections such as checking tickets or identification."
    }
  ],
