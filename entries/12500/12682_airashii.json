      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "12682_airashii_ex2",
      "japanese": "{庭|にわ}に{愛|あい}らしい{花|はな}が{咲|さ}いている。",
      "english": "Charming flowers are blooming in the garden.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "12682_airashii_ex3",
      "japanese": "{子猫|こねこ}が{小|ちい}さな{手|て}で{毛糸|けいと}の{玉|たま}を{転|ころ}がす{姿|すがた}は、{実|じつ}に{愛|あい}らしかった。",
      "english": "The sight of the kitten batting a ball of yarn with its tiny paws was truly endearing.",
