  "reading": "あいらしい",
  "part_of_speech": "i-adjective",
  "gloss": "lovely, charming, endearing",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "lovely, charming, endearing, adorable",
      "explanation": "Describes something or someone that is charmingly cute and inspires affection. Has a refined, slightly literary quality compared to the more casual かわいい."
    }
  ],
  "examples": [
    {
      "id": "12682_airashii_ex1",
