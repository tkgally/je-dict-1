  "definitions": [
    {
      "sense_number": 1,
      "gloss": "support, backing, sponsorship, patronage",
      "explanation": "Providing support or backing for a person, event, or organization, typically from behind the scenes. Often refers to institutional or organizational sponsorship rather than personal emotional support."
