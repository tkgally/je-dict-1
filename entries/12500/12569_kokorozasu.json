  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to aspire to, to aim for, to set one's heart on",
      "explanation": "To have a strong desire or ambition to achieve something or enter a particular field. Implies a serious, heartfelt commitment to a goal."
    }
  ],
