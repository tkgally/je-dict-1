  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to depart on a journey, to set out",
      "explanation": "To leave on a trip or journey. Carries a sense of embarking on something significant, not just a short outing."
    },
    {
      "sense_number": 2,
      "gloss": "to pass away, to depart this world",
      "explanation": "A euphemism for dying, likening death to setting out on a final journey."
    }
  ],
