  "schema_version": "2.0",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "hateful, detestable, odious",
      "explanation": "Describes a person or thing that one hates or finds detestable. Expresses strong negative emotion toward the target."
    },
    {
      "sense_number": 2,
      "gloss": "admirable, impressive (ironic praise)",
      "explanation": "Used as ironic or grudging praise to describe someone whose skill or success is so impressive that it provokes envy. Often used with a tone of reluctant admiration."
    }
  ],
  "examples": [
