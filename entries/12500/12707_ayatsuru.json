  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to operate, to handle, to control skillfully",
      "explanation": "To operate or handle something with skill, such as a vehicle, tool, instrument, or language."
    },
    {
      "sense_number": 2,
      "gloss": "to manipulate, to pull strings, to control (a person)",
      "explanation": "To control or influence someone behind the scenes, making them act according to one's will. Carries a negative connotation of deception or exploitation."
    }
  ],
