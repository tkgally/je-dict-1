  "definitions": [
    {
      "sense_number": 1,
      "gloss": "volunteering, applying (of one's own will)",
      "explanation": "The act of voluntarily offering oneself or applying for something, especially military service, a position, or an organization. Implies self-motivation and willingness, as opposed to being conscripted or assigned."
    }
  ],
