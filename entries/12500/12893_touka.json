  "definitions": [
    {
      "sense_number": 1,
      "gloss": "dropping, releasing from above",
      "explanation": "The act of dropping or releasing something from a height, such as dropping bombs from aircraft or dropping supplies by parachute."
    },
    {
      "sense_number": 2,
      "gloss": "investment, injection (of capital or resources)",
      "explanation": "Committing capital, resources, or effort into a project, business, or initiative. A figurative extension of the idea of 'throwing something in.'"
    }
  ],
