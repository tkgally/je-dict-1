  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to scatter, to sprinkle, to spread",
      "explanation": "To distribute something by scattering or sprinkling it over an area. Used for liquids (water), powders (salt), seeds, or other things spread broadly."
    },
    {
      "sense_number": 2,
      "gloss": "to shake off, to give the slip",
      "explanation": "To evade or lose a pursuer by running away or taking evasive action."
    }
  ],
