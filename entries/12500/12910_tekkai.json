  "definitions": [
    {
      "sense_number": 1,
      "gloss": "retraction, withdrawal, taking back",
      "explanation": "The act of officially withdrawing or taking back a statement, proposal, decision, or claim that was previously made. Used in formal, legal, and political contexts."
    }
  ],
