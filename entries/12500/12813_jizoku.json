  "definitions": [
    {
      "sense_number": 1,
      "gloss": "continuation, persistence, duration, sustainability",
      "explanation": "The act or state of maintaining something over a period of time without interruption. Often used for efforts, conditions, or systems that need to be kept going."
    }
  ],
