  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to trouble, to torment, to bother, to worry",
      "explanation": "To cause someone distress, worry, or difficulty. The subject is the person or thing causing the trouble, and the object is the person being troubled."
    }
  ],
