  "definitions": [
    {
      "sense_number": 1,
      "gloss": "abolition, repeal, removal",
      "explanation": "The act of formally abolishing, repealing, or doing away with a law, regulation, system, or restriction. Implies complete elimination rather than mere revision."
    }
  ],
