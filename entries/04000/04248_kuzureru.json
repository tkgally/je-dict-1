  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to collapse; to crumble",
      "explanation": "For a structure or pile to fall apart and lose its shape."
    },
    {
      "sense_number": 2,
      "gloss": "to break down; to deteriorate",
      "explanation": "For plans, order, health, or balance to fall apart."
    },
    {
      "sense_number": 3,
      "gloss": "to become disheveled; to lose form",
      "explanation": "For appearance, posture, or formation to become disordered."
    }
  ],
