  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to fit; to insert",
      "explanation": "To put something into a frame, slot, or opening so it fits precisely."
    },
    {
      "sense_number": 2,
      "gloss": "to put on (ring, gloves)",
      "explanation": "To put jewelry or accessories on one's fingers or hands."
    },
    {
      "sense_number": 3,
      "gloss": "to trap; to set up",
      "explanation": "To deceive or frame someone."
    }
  ],
