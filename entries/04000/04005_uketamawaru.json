  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to hear; to be told (humble)",
      "explanation": "Humble form of 聞く (to hear). Used when receiving information from someone of higher status."
    },
    {
      "sense_number": 2,
      "gloss": "to receive; to accept (humble)",
      "explanation": "Humble form of receiving orders, requests, or tasks. Used in business and formal contexts."
    }
  ],
  "examples": [
