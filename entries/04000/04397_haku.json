      "sense_number": 1,
      "gloss": "to exhale, to breathe out",
      "explanation": "To expel air from the lungs."
    },
    {
      "sense_number": 2,
      "gloss": "to vomit, to throw up",
      "explanation": "To eject the contents of the stomach through the mouth."
    },
    {
      "sense_number": 3,
      "gloss": "to spit out, to emit",
      "explanation": "To forcefully expel something from the mouth, or for something to emit."
    }
