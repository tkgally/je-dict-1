{
  "id": "04363_hagareru",
  "headword": "{剥|は}がれる",
  "reading": "はがれる",
  "part_of_speech": "verb (ichidan)",
  "gloss": "to come off, to peel off",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to come off, to peel off, to be stripped",
      "explanation": "For something adhered or attached to come detached from a surface."
    }
  ],
  "examples": [
    {
      "id": "04363_hagareru_ex1",
      "japanese": "シールが{剥|は}がれた。",
      "english": "The sticker came off.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
