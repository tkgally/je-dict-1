  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to wipe; to wipe clean",
      "explanation": "To clean a surface by rubbing with a cloth or paper."
    },
    {
      "sense_number": 2,
      "gloss": "to dry; to wipe dry",
      "explanation": "To remove moisture by wiping."
    }
  ],
  "examples": [
