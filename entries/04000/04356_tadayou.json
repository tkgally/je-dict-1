  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to drift, to float",
      "explanation": "To move slowly on water or in the air without direction or purpose."
    },
    {
      "sense_number": 2,
      "gloss": "to hang in the air, to pervade",
      "explanation": "For a scent, atmosphere, or feeling to be present and noticeable in a space."
    }
  ],
  "examples": [
