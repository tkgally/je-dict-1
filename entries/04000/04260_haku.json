  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to sweep",
      "explanation": "To clean a surface by brushing away dirt, dust, or debris with a broom."
    }
  ],
  "examples": [
    {
      "id": "04260_haku_ex1",
      "japanese": "{毎朝|まいあさ}{玄関|げんかん}を{掃|は}く。",
      "english": "I sweep the entrance every morning.",
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04260_haku_ex2",
      "japanese": "{落|お}ち{葉|ば}を{掃|は}いて{集|あつ}めた。",
      "english": "I swept up and gathered the fallen leaves.",
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04260_haku_ex3",
      "japanese": "{掃|は}いても{掃|は}いても{砂|すな}が{入|はい}ってくる。",
      "english": "No matter how much I sweep, sand keeps coming in.",
      "has_audio": false,
      "sense_numbers": [
