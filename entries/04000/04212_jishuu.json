  "definitions": [
    {
      "sense_number": 1,
      "gloss": "self-study, independent study",
      "explanation": "Studying by oneself without direct instruction from a teacher."
    }
  ],
  "examples": [
    {
      "id": "04212_jishuu_ex1",
      "japanese": "{先生|せんせい}が{休|やす}みなので{自習|じしゅう}だ。",
      "english": "It's self-study because the teacher is absent.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04212_jishuu_ex2",
      "japanese": "{図書館|としょかん}で{自習|じしゅう}している。",
      "english": "I'm studying on my own at the library.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04212_jishuu_ex3",
      "japanese": "{放課後|ほうかご}は{自習|じしゅう}{時間|じかん}を{設|もう}けている。",
      "english": "We have self-study time after school.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
