  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to sharpen, to grind, to whet",
      "explanation": "To make a blade sharp by rubbing against a stone or other abrasive."
    },
    {
      "sense_number": 2,
      "gloss": "to wash, to rinse (rice)",
      "explanation": "To wash rice by rubbing it in water before cooking."
    }
  ],
