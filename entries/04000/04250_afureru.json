  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to overflow; to spill over",
      "explanation": "For liquid or contents to exceed a container's capacity and spill out."
    },
    {
      "sense_number": 2,
      "gloss": "to be filled with; to brim with",
      "explanation": "To be full of an emotion, quality, or abundance of something."
    }
  ],
  "examples": [
