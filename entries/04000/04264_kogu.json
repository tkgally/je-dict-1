      "sense_numbers": [
        2
      ]
    },
    {
      "id": "04264_kogu_ex6",
      "japanese": "{授業中|じゅぎょうちゅう}に{舟|ふね}を{漕|こ}いでいる{学生|がくせい}がいた。",
      "english": "There was a student nodding off during class.",
      "has_audio": false,
