      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04264_kogu_ex2",
      "japanese": "{自転車|じてんしゃ}を{一生懸命|いっしょうけんめい}{漕|こ}いで{坂|さか}を{上|のぼ}った。",
      "english": "I pedaled hard and climbed the hill.",
      "has_audio": false,
