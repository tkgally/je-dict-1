  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to row; to paddle",
      "explanation": "To propel a boat through water using oars or paddles."
    },
    {
      "sense_number": 2,
      "gloss": "to pedal",
      "explanation": "To operate a bicycle or swing by moving one's legs."
    }
  ],
  "examples": [
    {
      "id": "04264_kogu_ex1",
      "japanese": "{湖|みずうみ}でボートを{漕|こ}いだ。",
