  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to jump, to leap, to hop",
      "explanation": "To spring up from the ground or a surface."
    },
    {
      "sense_number": 2,
      "gloss": "to bounce, to splash",
      "explanation": "For something to spring back or splatter."
    }
  ],
  "examples": [
