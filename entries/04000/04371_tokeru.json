  "gloss": "to come undone, to be solved",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to come undone, to come loose",
      "explanation": "For something tied or fastened to become unfastened."
    },
    {
      "sense_number": 2,
      "gloss": "to be solved, to be resolved",
      "explanation": "For a problem, riddle, or misunderstanding to be cleared up."
    },
    {
      "sense_number": 3,
      "gloss": "to be lifted, to be removed",
      "explanation": "For a ban, spell, or restriction to be lifted."
    }
  ],
