  "examples": [
    {
      "id": "04006_ryakusu_ex1",
      "japanese": "「⟦{国際連合|こくさいれんごう}→国際連合：18107_kokusairengou⟧」⟦を→を：00422_wo⟧「⟦{国連|こくれん}→国連：12035_kokuren⟧」⟦と→と：00512_to⟧{略|りゃく}す。",
      "english": "To abbreviate 'United Nations' to 'UN'.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04006_ryakusu_ex2",
      "japanese": "⟦{説明|せつめい}→説明：01449_setsumei⟧⟦を→を：00422_wo⟧{略|りゃく}して⟦{結論|けつろん}→結論：02704_ketsuron⟧⟦に→に：00314_ni⟧⟦{移|うつ}ります→移る：01232_utsuru⟧。",
