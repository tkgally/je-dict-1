{
  "id": "04385_matataku",
  "headword": "{瞬|またた}く",
  "reading": "またたく",
  "part_of_speech": "verb (godan)",
  "gloss": "to blink, to twinkle",
  "conjugation": {
    "type": "godan",
    "ending": "く",
    "stem": "{瞬|またた}"
  },
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to blink, to wink",
      "explanation": "To close and open one's eyes quickly."
    },
    {
      "sense_number": 2,
      "gloss": "to twinkle, to flicker",
      "explanation": "For stars or lights to shine with a flickering light."
    }
  ],
  "examples": [
    {
      "id": "04385_matataku_ex1",
      "japanese": "{彼女|かのじょ}は{驚|おどろ}いて{目|め}を{瞬|またた}いた。",
      "english": "She blinked in surprise.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04385_matataku_ex2",
      "japanese": "{星|ほし}が{瞬|またた}いている。",
      "english": "The stars are twinkling.",
      "notes": null,
