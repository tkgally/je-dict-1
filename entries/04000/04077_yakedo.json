      "sense_number": 1,
      "gloss": "burn, scald",
      "explanation": "An injury to the skin caused by heat, fire, hot liquids, or steam."
    }
  ],
  "examples": [
    {
      "id": "04077_yakedo_ex1",
      "japanese": "{熱|あつ}いお{湯|ゆ}で{火傷|やけど}した。",
      "english": "I got burned by hot water.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04077_yakedo_ex2",
      "japanese": "{火傷|やけど}には{冷|つめ}たい{水|みず}をかけてください。",
      "english": "Please run cold water over the burn.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04077_yakedo_ex3",
      "japanese": "{軽|かる}い{火傷|やけど}なら{薬|くすり}を{塗|ぬ}れば{大丈夫|だいじょうぶ}です。",
      "english": "If it's a minor burn, applying medicine should be fine.",
