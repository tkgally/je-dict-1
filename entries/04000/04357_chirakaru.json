  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be in disorder, to be messy, to be cluttered",
      "explanation": "For a space or area to be in a state of untidiness, with things scattered about."
    }
  ],
  "examples": [
    {
      "id": "04357_chirakaru_ex1",
      "japanese": "{部屋|へや}が{散|ち}らかっている。",
      "english": "The room is messy.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04357_chirakaru_ex2",
      "japanese": "{机|つくえ}の{上|うえ}が{書類|しょるい}で{散|ち}らかっている。",
