  "definitions": [
    {
      "sense_number": 1,
      "gloss": "news coverage, reporting",
      "explanation": "The act of gathering and broadcasting news to the public."
    },
    {
      "sense_number": 2,
      "gloss": "press, media",
      "explanation": "The news media collectively."
    }
  ],
  "examples": [
    {
      "id": "04438_houdou_ex1",
      "japanese": "{事件|じけん}が{大|おお}きく{報道|ほうどう}された。",
