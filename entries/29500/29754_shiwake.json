  "definitions": [
    {
      "sense_number": 1,
      "gloss": "journal entry; bookkeeping entry",
      "explanation": "In bookkeeping, recording a transaction by classifying it into debit and credit accounts; a journal entry. Takes する to mean to make such entries."
    }
  ],
  "examples": [
