{
  "id": "29846_henai",
  "headword": "{偏愛|へんあい}",
  "reading": "へんあい",
  "romaji": "henai",
  "part_of_speech": "noun, suru verb",
  "gloss": "partiality; favoritism; excessive fondness",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "partiality; favoritism; excessive fondness",
      "explanation": "Love or affection directed unfairly toward one particular person or thing, at the expense of others. Implies a lack of balance, as when a parent favors one child or a person is obsessively fond of one thing."
    }
  ],
  "examples": [
    {
      "id": "29846_henai_ex1",
      "japanese": "{父|ちち}の{偏愛|へんあい}を{感|かん}じた。",
      "english": "I sensed my father's favoritism.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29846_henai_ex2",
      "japanese": "{彼|かれ}は{古|ふる}い{時計|とけい}を{偏愛|へんあい}している。",
      "english": "He is excessively fond of old watches.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29846_henai_ex3",
      "japanese": "{親|おや}が{一人|ひとり}の{子|こ}を{偏愛|へんあい}すると、ほかの{兄弟|きょうだい}が{傷|きず}つくことがある。",
      "english": "When a parent shows favoritism to one child, the other siblings can get hurt.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "Composed of {偏|へん} (biased, leaning) + {愛|あい} (love). Denotes unbalanced affection toward one person or thing. Used both as a noun and, with する, as a verb ({偏愛|へんあい}する).\n\nCOMMON COLLOCATIONS:\n- {偏愛|へんあい}する: to be excessively fond of; to favor\n- {親|おや}の{偏愛|へんあい}: a parent's favoritism\n- ～への{偏愛|へんあい}: excessive fondness for ~\n\nSIMILAR WORDS:\n- えこひいき: favoritism — more colloquial; stresses unfair treatment of others\n- {溺愛|できあい}: doting; smothering love — excessive love that spoils, especially toward children",
