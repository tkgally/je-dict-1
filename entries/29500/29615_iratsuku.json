  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to get irritated; to get annoyed",
      "explanation": "To become irritated or annoyed, typically at something mildly frustrating. A casual, colloquial verb derived from the mimetic イライラ."
    }
  ],
  "examples": [
