{
  "id": "29751_mogomogo",
  "headword": "もごもご",
  "reading": "もごもご",
  "romaji": "mogomogo",
  "part_of_speech": "adverb, verb (suru)",
  "gloss": "mumbling; speaking indistinctly",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "mumbling; speaking indistinctly; mouthing",
      "explanation": "Mimetic word for speaking unclearly with the mouth barely moving, often from shyness or lack of confidence. Also describes chewing or moving something slowly inside a closed mouth."
    }
  ],
  "examples": [
    {
      "id": "29751_mogomogo_ex1",
      "japanese": "もごもごと{話|はな}す。",
      "english": "To speak in a mumble.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29751_mogomogo_ex2",
