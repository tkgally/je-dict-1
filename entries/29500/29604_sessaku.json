  "definitions": [
    {
      "sense_number": 1,
      "gloss": "cutting; machining",
      "explanation": "Shaping a workpiece by cutting away material with a tool, as in turning, milling, and drilling. A standard term in manufacturing and metalworking. Takes する to form a verb."
    }
  ],
  "examples": [
    {
      "id": "29604_sessaku_ex1",
      "japanese": "{金属|きんぞく}を{切削|せっさく}する。",
      "english": "To machine metal.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29604_sessaku_ex2",
      "japanese": "{切削|せっさく}のときには{油|あぶら}を{使|つか}う。",
      "english": "Oil is used during cutting.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29604_sessaku_ex3",
      "japanese": "この{機械|きかい}は{硬|かた}い{金属|きんぞく}でも{正確|せいかく}に{切削|せっさく}できる。",
