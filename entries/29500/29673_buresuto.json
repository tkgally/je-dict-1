{
  "id": "29673_buresuto",
  "headword": "ブレスト",
  "reading": "ぶれすと",
  "romaji": "buresuto",
  "part_of_speech": "noun",
  "gloss": "brainstorming (casual abbreviation)",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "brainstorming",
      "explanation": "A casual clipped form of ブレインストーミング, referring to freely generating many ideas in a group without criticizing them. Common in workplace and creative settings."
    }
  ],
  "examples": [
    {
      "id": "29673_buresuto_ex1",
      "japanese": "みんなでブレストしよう。",
      "english": "Let's brainstorm together.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29673_buresuto_ex2",
      "japanese": "{企画|きかく}のアイデアをブレストで{出|だ}し{合|あ}った。",
      "english": "We threw out ideas for the project through brainstorming.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29673_buresuto_ex3",
      "japanese": "{最初|さいしょ}のブレストでは、どんな{意見|いけん}も{否定|ひてい}せずに{書|か}き{出|だ}す。",
