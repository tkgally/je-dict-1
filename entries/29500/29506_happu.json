  "definitions": [
    {
      "sense_number": 1,
      "gloss": "promulgation; official proclamation",
      "explanation": "The official announcement of a law, ordinance, or constitution so that it becomes publicly known. A formal word, common in historical contexts such as the promulgation of the Meiji Constitution."
    }
  ],
  "examples": [
    {
