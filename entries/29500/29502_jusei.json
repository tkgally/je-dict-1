{
  "id": "29502_jusei",
  "headword": "{受精|じゅせい}",
  "reading": "じゅせい",
  "romaji": "jusei",
  "part_of_speech": "noun, suru verb",
  "gloss": "fertilization",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "fertilization",
      "explanation": "The union of a male and female reproductive cell—sperm and egg—that begins the development of a new organism. A biology term applying to both animals and plants."
    }
  ],
  "examples": [
    {
      "id": "29502_jusei_ex1",
      "japanese": "{卵|たまご}が{受精|じゅせい}する。",
      "english": "The egg is fertilized.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29502_jusei_ex2",
      "japanese": "{体外|たいがい}{受精|じゅせい}の{技術|ぎじゅつ}が{進歩|しんぽ}した。",
      "english": "In-vitro fertilization technology has advanced.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "29502_jusei_ex3",
      "japanese": "{受精|じゅせい}した{卵|らん}は、{細胞|さいぼう}{分裂|ぶんれつ}を{繰|く}り{返|かえ}しながら{成長|せいちょう}する。",
      "english": "A fertilized egg grows by repeatedly dividing into cells.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
