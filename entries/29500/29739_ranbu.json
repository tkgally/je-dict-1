  "definitions": [
    {
      "sense_number": 1,
      "gloss": "wild dancing; frenzied dancing; whirling about",
      "explanation": "Dancing wildly and without restraint, often out of great joy or excitement. Also used figuratively of things such as petals or snow whirling in the air."
    }
  ],
  "examples": [
    {
