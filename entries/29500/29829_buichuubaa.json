  "gloss": "VTuber; virtual YouTuber",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "VTuber; virtual YouTuber",
      "explanation": "An online entertainer who streams or posts videos using an animated avatar instead of appearing in person. A blend of \"virtual\" + \"YouTuber\"."
    }
  ],
  "examples": [
