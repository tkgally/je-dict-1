  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to urge, to press, to prompt",
      "explanation": "To encourage or push someone to take action, often by reminding them or applying gentle pressure."
    },
    {
      "sense_number": 2,
      "gloss": "to stimulate, to encourage, to facilitate",
      "explanation": "To bring about or speed up a process or change, used for abstract subjects like growth or development."
    }
  ],
