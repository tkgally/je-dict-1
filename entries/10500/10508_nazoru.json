  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to trace, to draw over",
      "explanation": "To follow the outline or lines of something by drawing or moving along them."
    },
    {
      "sense_number": 2,
      "gloss": "to follow, to retrace",
      "explanation": "To follow the same path, process, or sequence that someone or something took before."
    }
