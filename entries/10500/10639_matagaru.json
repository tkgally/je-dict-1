  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to straddle, to sit astride",
      "explanation": "To sit or mount something with one leg on each side."
    },
    {
      "sense_number": 2,
      "gloss": "to span, to extend across",
      "explanation": "To extend over or across a boundary, area, or period of time."
    }
  ],
