  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to blur, to be shaky, to be out of focus",
      "explanation": "For an image or camera to shake or become blurred due to movement."
    },
    {
      "sense_number": 2,
      "gloss": "to waver, to be inconsistent, to vacillate",
      "explanation": "For a person's opinions, principles, or stance to fluctuate or lack consistency."
    }
  ],
