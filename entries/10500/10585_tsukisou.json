  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to accompany, to attend to, to escort",
      "explanation": "To stay by someone's side to provide care, support, or supervision. Implies responsibility or concern for the person being accompanied."
    }
  ],
  "examples": [
