  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to stretch out, to throw out (limbs)",
      "explanation": "To extend one's legs or body casually or carelessly."
    },
    {
      "sense_number": 2,
      "gloss": "to give up, to abandon, to quit halfway",
      "explanation": "To abandon a task, responsibility, or commitment before completion."
    }
  ],
