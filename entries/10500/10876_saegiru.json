  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to block, to obstruct, to shield",
      "explanation": "To physically block or cut off something such as light, wind, or a path."
    },
    {
      "sense_number": 2,
      "gloss": "to interrupt, to cut off",
      "explanation": "To break into someone's speech or action, preventing them from continuing."
    }
  ],
  "examples": [
    {
      "id": "10876_saegiru_ex1",
      "japanese": "カーテンで{光|ひかり}を{遮|さえぎ}る。",
      "english": "To block the light with curtains.",
