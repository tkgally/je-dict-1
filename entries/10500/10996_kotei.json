    {
      "sense_number": 1,
      "gloss": "fixing in place, securing",
      "explanation": "Making something stationary or immovable by attaching or fastening it. Also used figuratively for establishing something as unchanging."
    }
  ],
  "examples": [
    {
      "id": "10996_kotei_ex1",
      "japanese": "ねじで{固定|こてい}する。",
      "english": "Secure it with screws.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "10996_kotei_ex2",
      "japanese": "{棚|たな}を{壁|かべ}に{固定|こてい}した。",
      "english": "I fixed the shelf to the wall.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "10996_kotei_ex3",
      "japanese": "この{席|せき}は{固定|こてい}されているので{動|うご}かせない。",
      "english": "These seats are fixed in place, so they can't be moved.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
