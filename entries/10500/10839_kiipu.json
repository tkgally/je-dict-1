  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to keep, to maintain, to hold onto",
      "explanation": "To maintain something in its current state or to reserve something for future use."
    },
    {
      "sense_number": 2,
      "gloss": "bottle keep, reserved bottle",
      "explanation": "A service at bars and restaurants in Japan where a customer's unfinished bottle is stored and kept for their next visit."
    }
