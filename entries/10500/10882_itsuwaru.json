  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to deceive, to lie, to misrepresent",
      "explanation": "To present false information or hide the truth, especially about oneself or one's identity."
    },
    {
      "sense_number": 2,
      "gloss": "to falsify, to forge, to fabricate",
      "explanation": "To alter or create false documents, records, or evidence."
    }
  ],
