  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to mix in, to intersperse, to include",
      "explanation": "To include or mix different elements together. Often used for mixing things like humor into speech, or different items into a group."
    },
    {
      "sense_number": 2,
      "gloss": "to exchange (words, blows)",
      "explanation": "To exchange words, glances, or blows with someone."
    }
  ],
  "examples": [
