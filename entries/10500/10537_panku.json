  "definitions": [
    {
      "sense_number": 1,
      "gloss": "flat tire, puncture, blowout",
      "explanation": "A tire that has lost air due to a hole or damage. From English 'puncture.'"
    },
    {
      "sense_number": 2,
      "gloss": "bursting, overflowing (figurative)",
      "explanation": "Used figuratively to describe something exceeding its capacity, such as a schedule or a venue."
    }
  ],
