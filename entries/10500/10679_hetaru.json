  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to wear out, to go flat, to lose firmness",
      "explanation": "For something cushioned or springy to lose its resilience or shape through use and age — pillows becoming flat, springs going soft, cushions losing their bounce."
    }
  ],
