  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to flick, to flip, to snap",
      "explanation": "To strike something with a quick, sharp motion of the finger or a similar small object."
    },
    {
      "sense_number": 2,
      "gloss": "to repel, to splash off, to shed",
      "explanation": "For a surface to cause water, dirt, or other substances to bounce off or not penetrate."
    },
    {
      "sense_number": 3,
      "gloss": "to calculate, to work out on an abacus",
      "explanation": "To do calculations, originally referring to using an abacus, now used more broadly for quick mental or rough calculations."
    }
  ],
