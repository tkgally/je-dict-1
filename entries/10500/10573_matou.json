  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to wear, to be clad in, to put on",
      "explanation": "To wrap oneself in or wear clothing, a robe, or an atmosphere. More literary and elegant than {着|き}る."
    }
  ],
  "examples": [
