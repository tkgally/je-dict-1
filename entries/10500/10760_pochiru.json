  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to click to buy, to order online",
      "explanation": "To make an online purchase by clicking the buy button. Coined from the onomatopoeia ポチ (the sound of pressing a button) plus the verb-forming suffix る."
    }
  ],
