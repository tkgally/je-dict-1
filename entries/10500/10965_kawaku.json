  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be thirsty, to be parched",
      "explanation": "To feel thirst. Used with 喉 (throat) in the pattern 喉が渇く. Written with 渇 to distinguish from 乾く (to dry physically)."
    },
    {
      "sense_number": 2,
      "gloss": "to thirst for, to crave",
      "explanation": "To strongly desire or crave something, used figuratively."
    }
  ],
