  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to swoop down, to descend gracefully, to flutter down",
      "explanation": "To come down from above in a light, graceful manner. Used for birds landing, snow falling gently, or angels descending. Conveys elegance or lightness in the descent, unlike plain 降りる which is neutral."
    }
  ],
