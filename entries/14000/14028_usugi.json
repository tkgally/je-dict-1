  "definitions": [
    {
      "sense_number": 1,
      "gloss": "light clothing; dressing lightly",
      "explanation": "Wearing thin or few layers of clothing. The opposite of 厚着 (dressing warmly in heavy layers). Can refer to both the state of wearing light clothes and the act of dressing lightly."
    }
  ],
  "examples": [
    {
      "id": "14028_usugi_ex1",
