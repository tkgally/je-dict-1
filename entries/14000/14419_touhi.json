  "definitions": [
    {
      "sense_number": 1,
      "gloss": "escape; evasion; avoidance",
      "explanation": "The act of running away from or avoiding something unpleasant such as responsibilities, problems, or reality. Often carries a negative connotation of avoiding what one should face."
    }
  ],
  "examples": [
