  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to show; to manifest; to be expressed",
      "explanation": "For something internal (emotions, effects, results, qualities) to become visible or evident on the surface. Unlike {現|あらわ}れる (to physically appear), {表|あらわ}れる focuses on abstract things becoming outwardly apparent."
    }
  ],
