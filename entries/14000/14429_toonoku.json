  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to recede; to become distant; to fade away",
      "explanation": "For something to move away or become more distant, either physically (sounds, figures) or figuratively (attention, visits). Often describes a gradual process of growing apart or becoming less frequent."
    }
  ],
  "examples": [
    {
      "id": "14429_toonoku_ex1",
      "japanese": "{足音|あしおと}が{遠|とお}のいていった。",
      "english": "The footsteps faded into the distance.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "14429_toonoku_ex2",
