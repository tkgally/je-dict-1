  "definitions": [
    {
      "sense_number": 1,
      "gloss": "request, demand, wish, desire",
      "explanation": "A formal or earnest request for something to be done. Stronger and more formal than お{願|ねが}い, often used when making requests to authorities, organizations, or in official contexts."
    }
  ],
