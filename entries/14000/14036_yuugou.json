  "definitions": [
    {
      "sense_number": 1,
      "gloss": "fusion, merger, blending, integration",
      "explanation": "The process of two or more things combining or melting together into one unified whole. Used for physical processes like nuclear fusion, cultural blending, and organizational mergers."
    }
  ],
