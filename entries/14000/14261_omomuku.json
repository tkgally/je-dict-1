  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to go to; to proceed to; to head for",
      "explanation": "To go to a place with a specific purpose, especially an important or formal destination. More literary and purposeful than simply 'to go.'"
    }
  ],
