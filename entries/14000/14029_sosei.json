  "definitions": [
    {
      "sense_number": 1,
      "gloss": "resuscitation, revival, coming back to life",
      "explanation": "The act of reviving or being revived from an unconscious, near-death, or dead state. Used both in medical contexts for resuscitation and more broadly for revival or restoration."
    }
  ],
