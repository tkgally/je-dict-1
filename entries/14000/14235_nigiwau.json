  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be bustling, to be lively, to be crowded with activity",
      "explanation": "Describes a place that is full of people and activity, creating a lively and prosperous atmosphere. Used for markets, streets, tourist spots, and events."
    }
  ],
