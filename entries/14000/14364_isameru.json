  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to admonish; to remonstrate; to counsel against",
      "explanation": "To earnestly advise someone, especially a person of higher status, against a wrong course of action. Carries a sense of respectful but firm persuasion, often used in historical or literary contexts."
    }
  ],
  "examples": [
    {
      "id": "14364_isameru_ex1",
      "japanese": "{家臣|かしん}が{殿様|とのさま}を{諌|いさ}めた。",
      "english": "The retainer admonished his lord.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "14364_isameru_ex2",
      "japanese": "{無謀|むぼう}な{計画|けいかく}を{諌|いさ}めたが、{聞|き}き{入|い}れてもらえなかった。",
      "english": "I remonstrated against the reckless plan, but was not heeded.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "14364_isameru_ex3",
      "japanese": "{部下|ぶか}が{上司|じょうし}の{判断|はんだん}を{諌|いさ}めるのは{勇気|ゆうき}がいることだ。",
      "english": "It takes courage for a subordinate to remonstrate with a superior about their judgment.",
