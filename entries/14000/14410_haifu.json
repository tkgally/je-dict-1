  "definitions": [
    {
      "sense_number": 1,
      "gloss": "distribution; handing out; circulation",
      "explanation": "The act of distributing printed materials, goods, or digital content to multiple recipients. Commonly used for flyers, documents, samples, and software."
    }
  ],
