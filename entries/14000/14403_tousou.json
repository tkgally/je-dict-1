  "definitions": [
    {
      "sense_number": 1,
      "gloss": "escape; flight; running away",
      "explanation": "Fleeing or running away from a pursuer, a dangerous situation, or confinement. Often used in the context of crime, prison breaks, or serious situations."
    }
