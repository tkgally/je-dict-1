  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to substantiate, to prove, to back up, to corroborate",
      "explanation": "To provide evidence or support that confirms the truth of a claim, theory, or statement."
    }
  ],
  "examples": [
    {
      "id": "14050_urazukeru_ex1",
      "japanese": "{証拠|しょうこ}が{彼|かれ}の{証言|しょうげん}を{裏付|うらづ}けた。",
      "english": "The evidence corroborated his testimony.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "14050_urazukeru_ex2",
      "japanese": "{調査|ちょうさ}{結果|けっか}が{仮説|かせつ}を{裏付|うらづ}ける{形|かたち}になった。",
