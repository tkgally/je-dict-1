  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to abandon, to forsake, to desert",
      "explanation": "To give up on someone or something and leave them without help or care. Carries a strong emotional connotation of betrayal or cold-heartedness."
    }
  ],
  "examples": [
    {
