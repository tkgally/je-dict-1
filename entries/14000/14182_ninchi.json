  "definitions": [
    {
      "sense_number": 1,
      "gloss": "cognition, perception, awareness",
      "explanation": "The mental process of perceiving, understanding, and knowing. Used in psychology and everyday contexts to refer to how people process and understand information."
    },
    {
      "sense_number": 2,
      "gloss": "recognition, acknowledgment",
      "explanation": "Officially or publicly recognizing the existence or legitimacy of something. In legal contexts, specifically refers to a father's formal acknowledgment of a child born out of wedlock."
    }
  ],
