  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to stretch in a row; to extend in a line",
      "explanation": "Describes things arranged or extending continuously in a line or series, such as mountains, buildings, or objects."
    },
    {
      "sense_number": 2,
      "gloss": "to attend; to take part in",
      "explanation": "To participate in a formal event or gathering, often as a member or attendee. More formal than 参加する."
    }
  ],
