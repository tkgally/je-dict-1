  "definitions": [
    {
      "sense_number": 1,
      "gloss": "linkage; interlocking; being linked together",
      "explanation": "A state where multiple things are connected so that movement or change in one causes a corresponding change in another. Used for mechanical, economic, or systemic connections."
    }
  ],
