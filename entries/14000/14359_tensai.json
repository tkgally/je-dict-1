  "definitions": [
    {
      "sense_number": 1,
      "gloss": "reposting; reprinting; reproduction",
      "explanation": "Reproducing or reposting content (articles, images, text) that was originally published elsewhere. Often used regarding copyright and permission issues online."
    }
  ],
