  "definitions": [
    {
      "sense_number": 1,
      "gloss": "supplementation, completion, complementing, filling in gaps",
      "explanation": "The act of adding what is missing or insufficient to make something complete or whole. Used for filling in gaps in knowledge, data, systems, or relationships where each part completes the other."
    }
  ],
