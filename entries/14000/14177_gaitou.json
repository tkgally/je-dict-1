  "definitions": [
    {
      "sense_number": 1,
      "gloss": "applicable, corresponding, relevant, falling under",
      "explanation": "Matching certain conditions, criteria, or categories. Used when something fits or applies to a particular case, rule, or description."
    }
  ],
