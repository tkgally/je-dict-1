  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to disparage; to demean; to look down on",
      "explanation": "To treat someone or something as inferior, to belittle, or to damage someone's reputation through words or actions."
    }
  ],
  "examples": [
    {
      "id": "14308_otoshimeru_ex1",
      "japanese": "{他人|たにん}を{貶|おとし}めてはいけない。",
      "english": "You must not disparage others.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "14308_otoshimeru_ex2",
      "japanese": "{相手|あいて}を{貶|おとし}めるような{発言|はつげん}は{慎|つつし}むべきだ。",
      "english": "One should refrain from making remarks that demean others.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
