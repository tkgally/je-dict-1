  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to pass through; to cut through",
      "explanation": "To move through and come out the other side of a space, passage, or area. Used for physically traversing tunnels, crowds, forests, and similar spaces."
    }
  ],
