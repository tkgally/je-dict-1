  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to cease; to be interrupted; to die out",
      "explanation": "For something that had been continuing to stop or come to an end. Used for communication, traditions, supplies, sounds, and other things that were ongoing."
    }
  ],
