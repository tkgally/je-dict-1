  "definitions": [
    {
      "sense_number": 1,
      "gloss": "dispersal; retreat; scattering; running away",
      "explanation": "Leaving or fleeing from a place, often in a hurry. Can describe a group scattering or a single person retreating. Often used with a slightly humorous or light tone."
    }
  ],
