  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to entrust, to leave in someone's care, to delegate",
      "explanation": "To entrust something important — such as a task, a hope, or one's future — to another person. Implies trust and often a sense of emotional weight or significance."
    }
  ],
