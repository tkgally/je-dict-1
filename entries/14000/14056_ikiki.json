  "definitions": [
    {
      "sense_number": 1,
      "gloss": "coming and going, back and forth, traffic",
      "explanation": "The movement of people going to and from a place. Refers to physical traffic of people or the ongoing mutual visits or exchanges between people or places."
    }
  ],
  "examples": [
