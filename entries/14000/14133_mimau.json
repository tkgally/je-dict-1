    },
    {
      "id": "14133_mimau_ex5",
      "japanese": "この{地域|ちいき}は{大|おお}きな{地震|じしん}に{見舞|みま}われた。",
      "english": "This region was struck by a major earthquake.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        2
      ]
    },
    {
      "id": "14133_mimau_ex6",
      "japanese": "{経済|けいざい}{危機|きき}に{見舞|みま}われた{国|くに}は、{復興|ふっこう}に{何年|なんねん}もかかった。",
