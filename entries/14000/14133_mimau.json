      "sense_numbers": [
        1
      ]
    },
    {
      "id": "14133_mimau_ex2",
      "japanese": "{花|はな}を{持|も}って{病院|びょういん}に{見舞|みま}いに{行|い}った。",
      "english": "I went to visit at the hospital with flowers.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "14133_mimau_ex3",
      "japanese": "{祖母|そぼ}が{退院|たいいん}するまで{毎日|まいにち}{見舞|みま}いに{通|かよ}った。",
      "english": "I visited every day until my grandmother was discharged from the hospital.",
