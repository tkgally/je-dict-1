  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to visit (a sick or injured person), to pay a sympathy call",
      "explanation": "To visit someone who is ill, injured, or has experienced misfortune, in order to offer comfort and support."
    },
    {
      "sense_number": 2,
      "gloss": "to strike, to hit, to befall",
      "explanation": "Used when a disaster, calamity, or blow strikes a person or place. Often appears in passive form (見舞われる)."
    }
  ],
  "examples": [
    {
      "id": "14133_mimau_ex1",
      "japanese": "{入院|にゅういん}した{友人|ゆうじん}を{見舞|みま}う。",
      "english": "I visit a hospitalized friend.",
