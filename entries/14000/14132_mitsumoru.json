  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to estimate, to assess, to calculate roughly",
      "explanation": "To roughly calculate the cost, amount, time, or value of something. Commonly used in business for making cost estimates and quotations."
    }
  ],
  "examples": [
