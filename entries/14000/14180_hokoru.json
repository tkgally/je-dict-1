  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be proud of, to take pride in",
      "explanation": "To feel pride in something, often a legitimate accomplishment, quality, or tradition. In this sense, the nuance is positive — having justified confidence or pride."
    },
    {
      "sense_number": 2,
      "gloss": "to boast, to brag",
      "explanation": "To speak proudly or show off about one's achievements or possessions. In this sense, the nuance can be negative, implying excessive self-promotion."
    }
  ],
  "examples": [
    {
      "id": "14180_hokoru_ex1",
      "japanese": "{日本|にほん}が{誇|ほこ}る{技術|ぎじゅつ}だ。",
      "english": "It's technology that Japan is proud of.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "14180_hokoru_ex2",
      "japanese": "この{地域|ちいき}は{長|なが}い{歴史|れきし}を{誇|ほこ}っている。",
      "english": "This region boasts a long history.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "14180_hokoru_ex3",
      "japanese": "{世界|せかい}に{誇|ほこ}れる{品質|ひんしつ}の{製品|せいひん}を{作|つく}りたい。",
      "english": "I want to make products of a quality we can be proud of to the world.",
