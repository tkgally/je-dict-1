  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to fade, to thin out, to grow faint",
      "explanation": "For something to become physically thinner, lighter, or less distinct over time. Used for colors, fog, light, and other sensory qualities."
    },
    {
      "sense_number": 2,
      "gloss": "to weaken, to diminish, to wane",
      "explanation": "For feelings, memories, awareness, or abstract qualities to gradually decrease in intensity or strength."
    }
  ],
