  "definitions": [
    {
      "sense_number": 1,
      "gloss": "replenishment, supplementing, restocking, filling up",
      "explanation": "The act of adding to something that has been depleted or is insufficient, in order to restore it to the required level. Used for supplies, personnel, and resources."
    }
  ],
