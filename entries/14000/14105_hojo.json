  "definitions": [
    {
      "sense_number": 1,
      "gloss": "assistance, aid, support",
      "explanation": "Help provided to supplement or support someone or something. Used broadly for physical assistance, supplementary functions, or auxiliary roles."
    },
    {
      "sense_number": 2,
      "gloss": "subsidy, financial aid, grant",
      "explanation": "Financial support provided by a government or organization to assist with costs. Commonly seen in compounds like {補助|ほじょ}{金|きん}."
    }
  ],
