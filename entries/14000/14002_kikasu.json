  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to tell; to let someone hear",
      "explanation": "To tell or relate something to someone. A causative-like form of 聞く, meaning to make or allow someone to hear information, a story, or music."
    }
  ],
