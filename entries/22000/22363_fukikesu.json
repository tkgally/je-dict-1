{
  "id": "22363_fukikesu",
  "headword": "{拭|ふ}き{消|け}す",
  "reading": "ふきけす",
  "romaji": "fukikesu",
  "part_of_speech": "verb (godan)",
  "gloss": "to wipe away; to erase completely",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to wipe away; to wipe off (writing, marks)",
      "explanation": "To completely remove or eliminate something by wiping. Used mainly for wiping writing or marks off a surface."
    }
  ],
  "examples": [
    {
      "id": "22363_fukikesu_ex1",
      "japanese": "⟦{涙|なみだ}→涙：02235_namida⟧⟦を→を：00422_wo⟧{拭|ふ}き{消|け}した。",
      "english": "She wiped away her tears.",
      "sense_numbers": [
        1
      ],
      "has_audio": true,
      "notes": null
    },
    {
      "id": "22363_fukikesu_ex2",
      "japanese": "⟦{黒板|こくばん}→黒板：02756_kokuban⟧⟦の→の：09472_no⟧⟦{字|じ}→字：01606_ji⟧⟦を→を：00422_wo⟧{拭|ふ}き{消|け}した。",
      "english": "I wiped the writing off the blackboard.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "22363_fukikesu_ex3",
      "japanese": "⟦{窓|まど}→窓：02254_mado⟧⟦ガラス→ガラス：01777_garasu⟧⟦に→に：00314_ni⟧ついた⟦{指|ゆび}→指：01518_yubi⟧⟦の→の：09472_no⟧⟦{跡|あと}→跡：02174_ato⟧⟦を→を：00422_wo⟧⟦{布|ぬの}→布：01489_nuno⟧⟦で→で：00502_de⟧⟦{丁寧|ていねい}→丁寧：00896_teinei⟧⟦に→に：00314_ni⟧{拭|ふ}き{消|け}した。",
      "english": "I carefully wiped the fingerprints off the window with a cloth.",
      "sense_numbers": [
        1
