  "definitions": [
    {
      "sense_number": 1,
      "gloss": "march; parade; procession; marching",
      "explanation": "An organized group of people walking together in formation, typically in a ceremonial, military, or protest context."
    }
  ],
  "examples": [
    {
      "id": "22196_koushin_ex1",
