      "has_audio": false,
      "notes": null
    },
    {
      "id": "22196_koushin_ex3",
      "japanese": "{市民|しみん}たちは{平和|へいわ}を{求|もと}めて{街|まち}の{中心|ちゅうしん}を{行進|こうしん}した。",
