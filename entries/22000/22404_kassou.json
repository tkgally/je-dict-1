  "gloss": "gliding; taxiing; sliding run",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "gliding; sliding; taxiing (of an aircraft)",
      "explanation": "The act of sliding or gliding along a surface. Most commonly used for aircraft taxiing on a runway, but also for skiing and skating."
    }
  ],
  "examples": [
