  "part_of_speech": "noun, suru verb",
  "gloss": "speed reading",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "speed reading; rapid reading",
      "explanation": "The skill or practice of reading text at an accelerated rate, often through specific techniques that train the eyes and brain to process information faster."
    }
  ],
