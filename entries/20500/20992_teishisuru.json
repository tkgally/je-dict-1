{
  "id": "20992_teishisuru",
  "headword": "{停止|ていし}する",
  "reading": "ていしする",
  "romaji": "teishisuru",
  "part_of_speech": "suru verb",
  "gloss": "to stop; to halt; to suspend",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to stop; to halt; to come to a standstill",
      "explanation": "To cease moving or operating. Used for machinery, vehicles, systems, and bodily functions."
    },
    {
      "sense_number": 2,
      "gloss": "to suspend; to discontinue; to put on hold",
      "explanation": "To officially halt or suspend an activity, service, or operation."
    }
  ],
  "examples": [
