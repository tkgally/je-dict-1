  "part_of_speech": "verb (godan)",
  "gloss": "to hint; to suggest; to insinuate",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to hint; to suggest; to insinuate; to imply",
      "explanation": "To communicate something indirectly without stating it explicitly."
    }
  ],
  "examples": [
    {
      "id": "20715_honomekasu_ex1",
