  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to gather; to pick; to collect; to harvest",
      "explanation": "To pick or gather natural things like plants, mushrooms, shellfish, or minerals from their environment."
    },
    {
      "sense_number": 2,
      "gloss": "to adopt; to choose; to employ",
      "explanation": "To select and adopt a plan, method, or person. Used for hiring, selecting candidates, or adopting approaches."
    }
  ],
