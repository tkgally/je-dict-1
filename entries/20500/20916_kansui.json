  "definitions": [
    {
      "sense_number": 1,
      "gloss": "flooding; submersion; inundation (of roads, fields, etc.)",
      "explanation": "The state of being covered or submerged by water, especially roads, farmland, or low-lying areas during heavy rain or typhoons."
    }
  ],
