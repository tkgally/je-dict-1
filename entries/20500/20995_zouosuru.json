{
  "id": "20995_zouosuru",
  "headword": "{憎悪|ぞうお}する",
  "reading": "ぞうおする",
  "romaji": "zouosuru",
  "part_of_speech": "suru verb",
  "gloss": "to hate; to detest; to abhor",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to hate; to detest; to abhor; to loathe",
      "explanation": "To feel intense hatred or strong aversion toward someone or something. Stronger and more literary than {嫌|きら}う or {憎|にく}む."
    }
  ],
  "examples": [
    {
      "id": "20995_zouosuru_ex1",
      "japanese": "{暴力|ぼうりょく}を{憎悪|ぞうお}する。",
      "english": "To detest violence.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "20995_zouosuru_ex2",
      "japanese": "{彼|かれ}は{不正|ふせい}を{憎悪|ぞうお}している。",
      "english": "He abhors injustice.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "20995_zouosuru_ex3",
      "japanese": "{戦争|せんそう}を{経験|けいけん}した{人々|ひとびと}は、{心|こころ}の{底|そこ}から{争|あらそ}いを{憎悪|ぞうお}している。",
      "english": "People who experienced war hate conflict from the bottom of their hearts.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "A する verb composed of {憎|ぞう} (hate) + {悪|お} (evil, loathe). Expresses deep, intense hatred — stronger than {嫌|きら}う or {憎|にく}む. Often used in literary, journalistic, or formal contexts.\n\nCOMMON COLLOCATIONS:\n- {憎悪|ぞうお}の{感情|かんじょう}: feelings of hatred\n- {憎悪|ぞうお}を{抱|いだ}く: to harbor hatred\n- {憎悪|ぞうお}{犯罪|はんざい}: hate crime\n- {人種|じんしゅ}{憎悪|ぞうお}: racial hatred\n\nSIMILAR WORDS:\n- {憎|にく}む: to hate — everyday word; less intense\n- {嫌|きら}う: to dislike, to hate — milder; common in daily conversation\n- {嫌悪|けんお}する: to feel disgust/aversion — emphasizes revulsion rather than hatred\n- {毛嫌|けぎら}いする: to have an irrational dislike for — instinctive, often unfounded dislike",
  "conjugation_type": "suru",
