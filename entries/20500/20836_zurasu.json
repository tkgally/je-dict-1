  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to shift; to slide; to move slightly",
      "explanation": "To move something a small distance from its original position."
    },
    {
      "sense_number": 2,
      "gloss": "to stagger; to offset",
      "explanation": "To adjust a schedule, timing, or arrangement so that things do not overlap or coincide."
    }
  ],
