{
  "id": "20927_hirousuru",
  "headword": "{披露|ひろう}する",
  "reading": "ひろうする",
  "romaji": "hirousuru",
  "part_of_speech": "suru verb",
  "gloss": "to announce; to present; to unveil",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to announce; to present; to unveil; to show off",
      "explanation": "To formally present or reveal something to others, such as a skill, achievement, or new product. Often carries a sense of pride or ceremony."
    }
  ],
  "examples": [
    {
      "id": "20927_hirousuru_ex1",
      "japanese": "{新曲|しんきょく}を{披露|ひろう}する。",
      "english": "To perform a new song.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "20927_hirousuru_ex2",
