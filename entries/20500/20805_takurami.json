  "definitions": [
    {
      "sense_number": 1,
      "gloss": "plot; scheme; design; intrigue",
      "explanation": "A secret or underhanded plan, usually with negative connotations. The noun form of the verb {企|たくら}む."
    }
  ],
  "examples": [
    {
      "id": "20805_takurami_ex1",
      "japanese": "{彼|かれ}の{企|たくら}みは{失敗|しっぱい}した。",
      "english": "His scheme failed.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "20805_takurami_ex2",
      "japanese": "{恐|おそ}ろしい{企|たくら}みが{進行|しんこう}していた。",
      "english": "A terrible plot was underway.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "20805_takurami_ex3",
      "japanese": "{彼女|かのじょ}は{相手|あいて}の{企|たくら}みを{見抜|みぬ}いて{先手|せんて}を{打|う}った。",
