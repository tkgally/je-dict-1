  "definitions": [
    {
      "sense_number": 1,
      "gloss": "under construction, construction in progress",
      "explanation": "A sign or notice indicating that construction work is currently taking place."
    }
  ],
  "examples": [
    {
      "id": "09625_koujichuu_ex1",
      "japanese": "この{道|みち}は{工事中|こうじちゅう}です。",
      "english": "This road is under construction.",
      "has_audio": false,
