  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to leave aside, to set aside, to ignore",
      "explanation": "To disregard someone or something, often giving priority to someone else or another matter."
    }
  ],
  "examples": [
    {
      "id": "09986_sashioku_ex1",
