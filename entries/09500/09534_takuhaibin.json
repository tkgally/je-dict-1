  "definitions": [
    {
      "sense_number": 1,
      "gloss": "home delivery service, parcel delivery",
      "explanation": "A courier service that delivers packages directly to homes or businesses. Major services in Japan include Yamato (Kuroneko), Sagawa, and Japan Post's Yu-Pack."
    }
  ],
  "examples": [
    {
      "id": "09534_takuhaibin_ex1",
