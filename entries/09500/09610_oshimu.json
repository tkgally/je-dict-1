  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to regret, to feel sorry about",
      "explanation": "To feel regret or sorrow about something lost or ending."
    },
    {
      "sense_number": 2,
      "gloss": "to be reluctant to part with, to value highly",
      "explanation": "To value something so much that one is reluctant to use or give it away."
    },
    {
      "sense_number": 3,
      "gloss": "to spare, to hold back",
      "explanation": "To refrain from using or giving something fully."
    }
  ],
