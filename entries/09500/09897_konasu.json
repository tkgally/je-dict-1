  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to handle; to manage; to deal with competently",
      "explanation": "To successfully handle or manage tasks or situations."
    },
    {
      "sense_number": 2,
      "gloss": "to master; to become proficient at",
      "explanation": "To become skilled at something through practice."
    }
  ],
