  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to yearn for, to adore, to long for",
      "explanation": "To feel deep affection, admiration, or longing for someone, often someone respected or loved."
    }
  ],
  "examples": [
    {
      "id": "09912_shitau_ex1",
