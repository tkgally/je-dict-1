  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to pickle, to preserve in brine/vinegar",
      "explanation": "To preserve food by soaking it in salt, vinegar, or other preserving liquids."
    },
    {
      "sense_number": 2,
      "gloss": "to soak, to steep",
      "explanation": "To immerse something in liquid."
    }
  ],
