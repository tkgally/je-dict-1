  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be due to, to result from",
      "explanation": "Indicates that something is caused by or results from a particular factor."
    },
    {
      "sense_number": 2,
      "gloss": "according to",
      "explanation": "Used to cite a source of information."
    }
  ],
  "examples": [
    {
      "id": "09857_yoru_ex1",
      "japanese": "{過失|かしつ}による{事故|じこ}で{訴|うった}えられた。",
