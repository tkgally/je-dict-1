  "definitions": [
    {
      "sense_number": 1,
      "gloss": "mediation, arrangement",
      "explanation": "Acting as an intermediary to help resolve disputes or arrange agreements between parties."
    },
    {
      "sense_number": 2,
      "gloss": "introduction, referral",
      "explanation": "Introducing or recommending someone for a job, service, or opportunity."
    }
  ],
