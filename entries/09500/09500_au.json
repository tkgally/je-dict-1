  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to encounter, to meet with (misfortune, accident, disaster)",
      "explanation": "To experience or be subjected to something unpleasant or unfortunate, such as an accident, disaster, or undesirable situation. Unlike {会|あ}う (to meet someone), this verb is used exclusively for negative encounters."
    }
  ],
