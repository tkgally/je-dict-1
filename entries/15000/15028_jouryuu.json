  "definitions": [
    {
      "sense_number": 1,
      "gloss": "upstream, upper reaches",
      "explanation": "The upper part of a river, closer to its source."
    },
    {
      "sense_number": 2,
      "gloss": "upper class, high society",
      "explanation": "The socially or economically privileged class."
    }
  ],
