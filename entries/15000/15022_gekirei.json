  "headword": "{激励|げきれい}",
  "reading": "げきれい",
  "part_of_speech": "noun, verb (suru)",
  "gloss": "encouragement, urging on",
  "conjugation": {
    "type": "suru",
    "prefix": "{激励|げきれい}"
