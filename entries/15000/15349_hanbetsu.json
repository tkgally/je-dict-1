  "definitions": [
    {
      "sense_number": 1,
      "gloss": "distinction; differentiation; discrimination",
      "explanation": "The act of telling things apart or distinguishing between similar items, concepts, or categories. Often used in technical, analytical, or perceptual contexts."
    }
  ],
