  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to swarm; to crowd; to flock; to throng",
      "explanation": "To gather in a large group around something, often in an eager or chaotic way. Used for people, animals, and insects."
    }
  ],
  "examples": [
