  "definitions": [
    {
      "sense_number": 1,
      "gloss": "being well-versed in; having expert knowledge of; thorough familiarity",
      "explanation": "Having deep, detailed knowledge of a particular subject or field. Used with する to indicate mastering or being thoroughly familiar with something."
    }
  ],
  "examples": [
