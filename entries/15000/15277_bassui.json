  "definitions": [
    {
      "sense_number": 1,
      "gloss": "extract; excerpt; selection; passage taken from a larger work",
      "explanation": "A portion selected from a longer text, document, speech, or other source. Also the act of selecting such a portion."
    }
  ],
  "examples": [
    {
      "id": "15277_bassui_ex1",
