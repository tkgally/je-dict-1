  "headword": "{断|た}ち{切|き}る",
  "reading": "たちきる",
  "part_of_speech": "verb (godan)",
  "gloss": "to cut off, to sever",
  "conjugation": {
    "type": "godan",
    "ending": "る",
    "stem": "{断|た}ち{切|き}"
  },
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to cut off, to sever",
      "explanation": "To physically cut something completely in two."
    },
    {
      "sense_number": 2,
      "gloss": "to sever, to break off (ties, feelings)",
      "explanation": "To decisively end a relationship, habit, or emotional attachment."
    }
  ],
  "examples": [
