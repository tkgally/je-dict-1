  "definitions": [
    {
      "sense_number": 1,
      "gloss": "suicide",
      "explanation": "A euphemistic term for taking one's own life. Preferred in journalism, government documents, and support organizations as a less blunt alternative to {自殺|じさつ}. Increasingly used in media style guides in Japan."
    }
  ],
