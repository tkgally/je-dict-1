  "definitions": [
    {
      "sense_number": 1,
      "gloss": "dressing warmly; wearing thick layers of clothing",
      "explanation": "Wearing multiple or thick layers of clothing to stay warm, typically in cold weather. The opposite is {薄着|うすぎ} (dressing lightly)."
    }
  ],
  "examples": [
    {
