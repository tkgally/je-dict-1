  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to save (a life); to hold on to life; to barely survive",
      "explanation": "To narrowly avoid death; to have one's life saved, typically after an accident or illness. Almost always used in the set phrase {命|いのち}を{取|と}り{留|と}める."
    }
  ],
