  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to cut open; to slash; to rip apart; to tear",
      "explanation": "To cut or tear something violently with a sharp instrument or forcefully. Can also be used figuratively for things that cut through silence, darkness, etc."
    }
