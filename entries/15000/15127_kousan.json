  "definitions": [
    {
      "sense_number": 1,
      "gloss": "surrender; giving in; giving up",
      "explanation": "Admitting defeat or yielding to an opponent or difficult situation. Used both in serious military/competitive contexts and in everyday situations where one gives up trying. Composed of 降 (descend, surrender) + 参 (go, come — humble)."
    }
  ],
  "examples": [
