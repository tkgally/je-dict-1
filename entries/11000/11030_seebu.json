  "definitions": [
    {
      "sense_number": 1,
      "gloss": "save (data, game progress)",
      "explanation": "To store or record data, especially saving progress in a video game or saving a file on a computer."
    },
    {
      "sense_number": 2,
      "gloss": "save (in sports)",
      "explanation": "A defensive play that prevents the opposing team from scoring, particularly in baseball (a relief pitcher's save) and soccer (a goalkeeper's save)."
    }
  ],
