  "reading": "ほーる",
  "part_of_speech": "noun",
  "gloss": "hall, auditorium, lobby",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "hall, auditorium, concert hall",
      "explanation": "A large room or building used for concerts, lectures, ceremonies, and other public events."
    },
    {
      "sense_number": 2,
      "gloss": "lobby, entrance hall, front-of-house area",
      "explanation": "The main public area of a hotel, restaurant, or building. In restaurants, the dining area as opposed to the kitchen."
    }
  ],
