  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to reveal, to expose, to spill (a secret)",
      "explanation": "To disclose information that was supposed to be kept secret, often carelessly or deliberately."
    },
    {
      "sense_number": 2,
      "gloss": "to dismantle, to take apart",
      "explanation": "To break something down into its component parts; to disassemble a machine or structure."
    }
  ],
