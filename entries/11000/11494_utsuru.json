  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be photographed, to come out (in a photo)",
      "explanation": "For a person or thing to appear in a photograph or image. Describes how well or clearly the subject is captured."
    },
    {
      "sense_number": 2,
      "gloss": "to be copied, to be reproduced",
      "explanation": "For something to be transcribed or reproduced onto paper or another surface."
    }
  ],
  "examples": [
