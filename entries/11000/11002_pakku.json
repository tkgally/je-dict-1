  "definitions": [
    {
      "sense_number": 1,
      "gloss": "pack, package, sealed container",
      "explanation": "A sealed package or container for food or other products. Also the act of packing or packaging something."
    },
    {
      "sense_number": 2,
      "gloss": "face pack, face mask",
      "explanation": "A skincare product applied to the face for treatment. Short for フェイスパック."
    }
  ],
