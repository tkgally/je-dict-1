  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to become vacant, to become free, to become available",
      "explanation": "For a space, seat, time slot, or person to become available or unoccupied."
    },
    {
      "sense_number": 2,
      "gloss": "to become empty, to be emptied",
      "explanation": "For a container, stomach, or space to become empty."
    }
  ],
