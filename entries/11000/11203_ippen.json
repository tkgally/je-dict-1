  "definitions": [
    {
      "sense_number": 1,
      "gloss": "sudden change, complete transformation",
      "explanation": "A dramatic and total change from one state to another. Emphasizes that the transformation is abrupt and comprehensive, not gradual."
    }
  ],
  "examples": [
    {
      "id": "11203_ippen_ex1",
      "japanese": "{状況|じょうきょう}が{一変|いっぺん}した。",
      "english": "The situation changed completely.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11203_ippen_ex2",
      "japanese": "あの{事件|じけん}をきっかけに、{彼|かれ}の{人生|じんせい}は{一変|いっぺん}した。",
      "english": "That incident completely transformed his life.",
      "notes": null,
