  "schema_version": "2.0",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "running parallel, concurrent, simultaneous",
      "explanation": "Doing multiple things at the same time or proceeding side by side. Often used for tasks, projects, or processes happening simultaneously."
    }
  ],
  "examples": [
    {
      "id": "11311_heikou_ex1",
      "japanese": "{二|ふた}つのプロジェクトを{並行|へいこう}して{進|すす}める。",
      "english": "Carry out two projects concurrently.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11311_heikou_ex2",
      "japanese": "{開発|かいはつ}とテストを{並行|へいこう}して{行|おこな}っている。",
      "english": "We're doing development and testing in parallel.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11311_heikou_ex3",
      "japanese": "{警察|けいさつ}は{複数|ふくすう}の{捜査|そうさ}ラインを{並行|へいこう}して{追|お}い、{容疑者|ようぎしゃ}の{特定|とくてい}を{急|いそ}いだ。",
      "english": "The police pursued multiple lines of investigation in parallel, rushing to identify the suspect.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
