  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to disturb, to disrupt, to throw into disorder",
      "explanation": "To cause something orderly to become disordered or confused. Used for both physical order and abstract concepts like peace, discipline, or rhythm."
