  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to volunteer; to apply; to enlist",
      "explanation": "To offer oneself for a task, position, or service of one's own will. Often used for military enlistment or applying for a challenging role."
    }
  ],
  "examples": [
