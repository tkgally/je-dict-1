  "definitions": [
    {
      "sense_number": 1,
      "gloss": "command, direction, leadership",
      "explanation": "Leading and directing a group of people in a coordinated effort, such as military operations, emergency response, or organizational activities."
    },
    {
      "sense_number": 2,
      "gloss": "conducting (music)",
      "explanation": "Directing an orchestra, band, or choir by guiding the tempo, dynamics, and expression of a musical performance."
    }
