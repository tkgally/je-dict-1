  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be finished, to be completed, to turn out",
      "explanation": "For something being made or prepared to reach its completed state. Describes the result of a process, often with a nuance of how well the result turned out."
    }
  ],
  "examples": [
    {
      "id": "11429_shiagaru_ex1",
      "japanese": "ケーキがきれいに{仕上|しあ}がった。",
      "english": "The cake turned out beautifully.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11429_shiagaru_ex2",
      "japanese": "{報告書|ほうこくしょ}がようやく{仕上|しあ}がった。",
      "english": "The report is finally finished.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11429_shiagaru_ex3",
      "japanese": "{思|おも}った{以上|いじょう}にいい{作品|さくひん}に{仕上|しあ}がって、{自分|じぶん}でも{驚|おどろ}いている。",
      "english": "It turned out to be a better piece than I expected, and even I'm surprised.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
