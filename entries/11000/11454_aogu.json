  "schema_version": "2.0",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to look up at, to gaze upward",
      "explanation": "To direct one's gaze upward at something above, such as the sky, a tall building, or a person's face."
    },
    {
      "sense_number": 2,
      "gloss": "to respect, to revere, to look up to",
      "explanation": "To regard someone with deep respect and admiration, treating them as a superior or mentor."
    },
    {
      "sense_number": 3,
      "gloss": "to seek, to ask for (guidance, instruction)",
      "explanation": "To request guidance, direction, or a decision from someone in authority."
    }
  ],
