      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "14612_aozameru_ex3",
      "japanese": "{青|あお}ざめた{顔|かお}で{病院|びょういん}から{出|で}てきた{彼|かれ}を{見|み}て、{何|なに}かあったのだと{悟|さと}った。",
