  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to turn pale; to go white; to blanch",
      "explanation": "To lose color in the face due to fear, shock, illness, or extreme emotion. The face takes on a pale, bloodless appearance. Almost always describes a visible physical reaction to something alarming."
    }
  ],
  "examples": [
    {
      "id": "14612_aozameru_ex1",
      "japanese": "{彼|かれ}は{恐怖|きょうふ}で{青|あお}ざめた。",
      "english": "He turned pale with fear.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "14612_aozameru_ex2",
      "japanese": "{事故|じこ}の{知|し}らせを{聞|き}いて、{彼女|かのじょ}の{顔|かお}が{青|あお}ざめた。",
      "english": "Her face went pale when she heard the news of the accident.",
