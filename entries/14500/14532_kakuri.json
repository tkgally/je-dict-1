  "definitions": [
    {
      "sense_number": 1,
      "gloss": "isolation; quarantine; segregation",
      "explanation": "The act of separating a person or thing from others. Used in medical contexts for quarantine, and more broadly for any forced separation or segregation."
    }
  ],
