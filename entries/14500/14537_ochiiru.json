  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to fall into; to lapse into; to be caught in",
      "explanation": "To end up in a bad state or difficult situation. Typically used with negative conditions like panic, confusion, crisis, or traps. The subject falls into the state involuntarily."
    }
  ],
