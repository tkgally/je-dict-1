  "definitions": [
    {
      "sense_number": 1,
      "gloss": "encouragement; inspiration; rallying",
      "explanation": "The act of inspiring or spurring someone on to greater effort or enthusiasm. Often used with する as a suru-verb meaning to encourage, inspire, or rally."
