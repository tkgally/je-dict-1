  "definitions": [
    {
      "sense_number": 1,
      "gloss": "closure; shutdown; closing down",
      "explanation": "The act of closing a facility, institution, road, or service, either temporarily or permanently. Used for factories, schools, roads, websites, and other operations."
    }
  ],
