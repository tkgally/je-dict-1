  "definitions": [
    {
      "sense_number": 1,
      "gloss": "heavy drinking; excessive drinking",
      "explanation": "Drinking alcohol to excess on a particular occasion. Implies going beyond a reasonable amount, often resulting in negative consequences the next day."
