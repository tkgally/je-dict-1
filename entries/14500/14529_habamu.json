  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to block; to obstruct; to prevent; to hinder",
      "explanation": "To stand in the way of something and prevent it from proceeding or being achieved. Used for both physical obstacles and abstract hindrances."
    }
  ],
  "examples": [
    {
      "id": "14529_habamu_ex1",
      "japanese": "{悪天候|あくてんこう}が{登山|とざん}を{阻|はば}んだ。",
      "english": "Bad weather blocked the mountain climb.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
