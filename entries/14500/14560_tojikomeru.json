  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to lock up; to confine; to shut in",
      "explanation": "To confine someone or something in an enclosed space by closing or locking doors, gates, or other barriers. Also used figuratively for trapping feelings, memories, or abstract things."
    }
  ],
  "examples": [
    {
