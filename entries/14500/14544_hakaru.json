  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to consult; to confer with; to refer to",
      "explanation": "To formally seek advice or a decision from a council, committee, or advisory body. Used in official, organizational, and governmental contexts."
    }
  ],
