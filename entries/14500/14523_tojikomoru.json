  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to shut oneself in; to seclude oneself; to withdraw",
      "explanation": "To stay indoors and avoid going out or meeting people. Can describe temporary withdrawal (e.g., staying home on a rainy day) or more serious social withdrawal."
    }
  ],
  "examples": [
    {
      "id": "14523_tojikomoru_ex1",
      "japanese": "{一日中|いちにちじゅう}{部屋|へや}に{閉|と}じこもっていた。",
      "english": "I stayed shut up in my room all day.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
