  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to run; to dash; to sprint",
      "explanation": "To run swiftly, often with a sense of urgency or energy. More literary and vivid than {走|はし}る."
    },
    {
      "sense_number": 2,
      "gloss": "to gallop; to ride at speed",
      "explanation": "For a horse or mounted rider to move at full speed. Used in historical and equestrian contexts."
    }
