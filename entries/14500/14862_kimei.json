  "definitions": [
    {
      "sense_number": 1,
      "gloss": "writing one's name; signing; putting one's name on something",
      "explanation": "The act of writing or printing one's name on a document, form, ballot, or object. Distinct from a signature or seal — it simply means that a name is recorded."
    }
  ],
