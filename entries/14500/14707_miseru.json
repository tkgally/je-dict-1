  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to fascinate; to captivate; to enchant",
      "explanation": "To charm or captivate an audience through an impressive performance, beauty, or skill. Written with {魅|み} (charm/bewitch) to distinguish it from the ordinary {見|み}せる (to show)."
    }
  ],
  "examples": [
