  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be skilled at; to excel in",
      "explanation": "To have a high level of ability or expertise in a particular field or skill. Almost always used in the form に長けている to describe someone's proficiency."
    }
  ],
