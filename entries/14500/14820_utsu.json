  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to strike down; to slay; to defeat in battle",
      "explanation": "To attack and kill or defeat an enemy, especially in a military or historical context. Often implies righteous punishment or vengeance."
    },
    {
      "sense_number": 2,
      "gloss": "to subjugate; to launch a campaign against",
      "explanation": "To mount a military expedition to conquer or suppress an enemy force or region."
    }
  ],
