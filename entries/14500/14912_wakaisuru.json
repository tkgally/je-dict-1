  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to reconcile; to make peace",
      "explanation": "To resolve a personal conflict or disagreement and restore a friendly relationship. Used for interpersonal reconciliation."
    },
    {
      "sense_number": 2,
      "gloss": "to settle (a dispute); to reach a settlement",
      "explanation": "To reach an agreement to resolve a legal dispute outside of a formal court judgment. A legal term for out-of-court settlement."
    }
  ],
