  "reading": "めもする",
  "romaji": "memosuru",
  "part_of_speech": "suru verb",
  "gloss": "to jot down; to take notes; to make a memo",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to jot down; to take notes; to make a memo",
      "explanation": "To write down something briefly for future reference, typically a quick note rather than a detailed record."
    }
  ],
  "examples": [
    {
      "id": "25501_memosuru_ex1",
      "japanese": "{電話|でんわ}{番号|ばんごう}をメモした。",
      "english": "I jotted down the phone number.",
      "sense_numbers": [
        1
