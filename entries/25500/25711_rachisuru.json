{
  "id": "25711_rachisuru",
  "headword": "{拉致|らち}する",
  "reading": "らちする",
  "romaji": "rachisuru",
  "part_of_speech": "verb",
  "gloss": "to abduct; to kidnap",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to abduct; to kidnap; to take away by force",
      "explanation": "To seize and carry someone away against their will, especially in a political or criminal context."
    }
  ],
  "examples": [
    {
      "id": "25711_rachisuru_ex1",
      "japanese": "{子供|こども}が{拉致|らち}された。",
      "english": "A child was abducted.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
