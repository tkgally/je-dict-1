{
  "id": "25670_imasugu",
  "headword": "{今|いま}すぐ",
  "reading": "いますぐ",
  "romaji": "imasugu",
  "part_of_speech": "adverb",
  "gloss": "right now; immediately",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "right now; immediately; at once",
      "explanation": "Without any delay, at this very moment. Emphasizes urgency or the desire for immediate action."
    }
  ],
  "examples": [
