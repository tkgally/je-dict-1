  "definitions": [
    {
      "sense_number": 1,
      "gloss": "stroll; walking for pleasure; promenade",
      "explanation": "Walking leisurely for enjoyment or relaxation, rather than for a specific destination or purpose."
    }
  ],
  "examples": [
