  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to knock (on a door)",
      "explanation": "To tap or rap on a door to announce one's presence or ask for permission to enter."
    },
    {
      "sense_number": 2,
      "gloss": "to hit practice balls (baseball)",
      "explanation": "In baseball, to hit ground balls or fly balls to fielders during practice. The person hitting is called the ノッカー."
    }
  ],
