{
  "id": "21759_funkisuru",
  "headword": "{奮起|ふんき}する",
  "reading": "ふんきする",
  "part_of_speech": "noun, suru verb",
  "gloss": "to rouse oneself; to rally; to summon one's energy",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to rouse oneself; to rally; to summon one's energy",
      "explanation": "To gather one's willpower and energy to take action, especially in the face of difficulty or after a setback. Implies a deliberate effort to motivate oneself."
    }
  ],
  "examples": [
    {
      "id": "21759_funkisuru_ex1",
      "japanese": "チームが{奮起|ふんき}した。",
      "english": "The team rallied.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "21759_funkisuru_ex2",
      "japanese": "{監督|かんとく}の{言葉|ことば}に{奮起|ふんき}して{逆転|ぎゃくてん}した。",
      "english": "Spurred by the coach's words, they made a comeback.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "21759_funkisuru_ex3",
      "japanese": "{失敗|しっぱい}を{糧|かて}に{奮起|ふんき}して、もう{一度|いちど}{挑戦|ちょうせん}することにした。",
      "english": "I used the failure as fuel to rouse myself and decided to try once more.",
