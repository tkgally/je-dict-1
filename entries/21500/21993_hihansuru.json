  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to criticize; to critique; to censure",
      "explanation": "To express disapproval of or point out faults in someone or something. Can range from constructive critique to harsh censure, depending on context."
    }
  ],
  "examples": [
    {
      "id": "21993_hihansuru_ex1",
      "japanese": "{政府|せいふ}の{対応|たいおう}を{批判|ひはん}する。",
      "english": "To criticize the government's response.",
      "sense_numbers": [
