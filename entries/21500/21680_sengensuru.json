{
  "id": "21680_sengensuru",
  "headword": "{宣言|せんげん}する",
  "reading": "せんげんする",
  "romaji": "sengensuru",
  "part_of_speech": "suru verb",
  "gloss": "to declare; to proclaim",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to declare; to proclaim; to announce officially",
      "explanation": "Used for formal, public declarations — political announcements, official statements, or personal declarations of intent."
    }
  ],
  "examples": [
    {
      "id": "21680_sengensuru_ex1",
      "japanese": "{独立|どくりつ}を{宣言|せんげん}する。",
      "english": "To declare independence.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "21680_sengensuru_ex2",
      "japanese": "{政府|せいふ}は{非常事態|ひじょうじたい}を{宣言|せんげん}した。",
      "english": "The government declared a state of emergency.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "21680_sengensuru_ex3",
      "japanese": "{彼|かれ}は{皆|みな}の{前|まえ}で{禁煙|きんえん}を{宣言|せんげん}したが、{三日|みっか}で{挫折|ざせつ}した。",
      "english": "He declared in front of everyone that he would quit smoking, but gave up after three days.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "Used for formal or emphatic declarations, from political contexts to personal pledges. The noun {宣言|せんげん} is also common on its own.\n\nCOMMON COLLOCATIONS:\n- {独立|どくりつ}{宣言|せんげん}: declaration of independence\n- {非常事態|ひじょうじたい}{宣言|せんげん}: state of emergency declaration\n- {勝利|しょうり}{宣言|せんげん}: victory declaration\n- {開会|かいかい}{宣言|せんげん}: opening declaration (of an event)\n\nSIMILAR WORDS:\n- {発表|はっぴょう}する: to announce (more general, less formal weight)\n- {表明|ひょうめい}する: to express clearly (one's position or intention)\n- {公言|こうげん}する: to state publicly (often personal opinions)",
  "schema_version": "2.0",
