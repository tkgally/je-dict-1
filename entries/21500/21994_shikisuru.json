  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to command; to direct; to lead (a group or operation)",
      "explanation": "To lead and give directions to a group of people in an organized activity, such as military operations, emergency response, or projects."
    },
    {
      "sense_number": 2,
      "gloss": "to conduct (an orchestra or musical ensemble)",
      "explanation": "To lead a musical performance by directing the musicians with gestures, typically using a baton."
    }
  ],
