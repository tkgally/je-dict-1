  "gloss": "descent; fall; drop",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "descent; fall; drop; coming down",
      "explanation": "The act of descending or falling from a higher position. Used for physical descent such as parachuting, as well as drops in temperature, blood pressure, or other measurable quantities."
    }
  ],
  "examples": [
    {
      "id": "21547_kouka_ex1",
