  "part_of_speech": "verb (godan, intransitive)",
  "gloss": "to become lower; to fall (in level)",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to become lower; to drop; to decrease",
      "explanation": "For a level, degree or position to go down. The intransitive partner of {低|ひく}める. Written and somewhat uncommon; in speech {低|ひく}くなる is far more usual."
    }
  ],
  "examples": [
