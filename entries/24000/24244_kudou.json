{
  "id": "24244_kudou",
  "headword": "{駆動|くどう}",
  "reading": "くどう",
  "romaji": "kudou",
  "part_of_speech": "noun, suru verb",
  "gloss": "drive; propulsion",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "drive; driving; propulsion",
      "explanation": "The mechanism or action of powering and moving a machine, vehicle, or device. Most commonly encountered in automotive and engineering contexts when describing how power is transmitted to wheels or other moving parts."
    }
  ],
  "examples": [
    {
      "id": "24244_kudou_ex1",
      "japanese": "この{車|くるま}は{四輪|よんりん}{駆動|くどう}だ。",
      "english": "This car is four-wheel drive.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "24244_kudou_ex2",
      "japanese": "モーターで{駆動|くどう}する{装置|そうち}を{開発|かいはつ}した。",
      "english": "We developed a motor-driven device.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "24244_kudou_ex3",
      "japanese": "{電気|でんき}{駆動|くどう}の{自動車|じどうしゃ}は{環境|かんきょう}にやさしいと{言|い}われている。",
      "english": "Electrically driven cars are said to be environmentally friendly.",
