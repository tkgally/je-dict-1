  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to open",
      "explanation": "To cause something closed to become open. A transitive verb - you open something. The intransitive pair is {開|あ}く (aku)."
    }
  ],
  "examples": [
    {
      "japanese": "{窓|まど}を{開|あ}けてください。",
      "english": "Please open the window.",
      "notes": null,
      "audio": ""
    },
    {
