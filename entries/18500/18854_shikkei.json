  "definitions": [
    {
      "sense_number": 1,
      "gloss": "rudeness; impoliteness",
      "explanation": "Behavior or words that are disrespectful or lacking in courtesy."
    },
    {
      "sense_number": 2,
      "gloss": "excuse me; pardon me",
      "explanation": "An interjection used when excusing oneself, typically by older men. Somewhat old-fashioned."
    }
