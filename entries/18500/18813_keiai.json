{
  "id": "18813_keiai",
  "headword": "{敬愛|けいあい}",
  "reading": "けいあい",
  "romaji": "keiai",
  "part_of_speech": "noun, verb-suru",
  "gloss": "respect and affection; reverence",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "respect and affection; reverence",
      "explanation": "A feeling that combines both deep respect and warm affection toward someone, typically a mentor, elder, or admired figure."
    }
  ],
  "examples": [
    {
      "id": "18813_keiai_ex1",
      "japanese": "{先生|せんせい}を{敬愛|けいあい}している。",
      "english": "I deeply respect and admire my teacher.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18813_keiai_ex2",
      "japanese": "{敬愛|けいあい}する{祖父|そふ}から{多|おお}くのことを{学|まな}んだ。",
      "english": "I learned many things from my beloved and respected grandfather.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18813_keiai_ex3",
      "japanese": "{彼|かれ}は{学生|がくせい}たちから{敬愛|けいあい}されている{教授|きょうじゅ}だ。",
      "english": "He is a professor who is both respected and loved by his students.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "Combines {敬|けい} (respect) and {愛|あい} (love/affection). Unlike {尊敬|そんけい} (respect) which focuses purely on admiration, {敬愛|けいあい} carries a warmer emotional component. Typically directed toward teachers, mentors, parents, and other admired elders. The pattern {敬愛|けいあい}する + noun is common as a modifier: {敬愛|けいあい}する{先輩|せんぱい} (a respected and beloved senior).",
