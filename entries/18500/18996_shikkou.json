{
  "id": "18996_shikkou",
  "headword": "{執行|しっこう}",
  "reading": "しっこう",
  "part_of_speech": "noun",
  "gloss": "execution; enforcement; carrying out",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "execution; enforcement; carrying out",
      "explanation": "Implementing or putting into effect a law, order, sentence, or plan. Used in legal, administrative, and organizational contexts."
    }
  ],
  "examples": [
    {
      "id": "18996_shikkou_ex1",
      "japanese": "{死刑|しけい}が{執行|しっこう}された。",
      "english": "The death sentence was carried out.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18996_shikkou_ex2",
      "japanese": "{予算|よさん}の{執行|しっこう}を{管理|かんり}する。",
      "english": "To manage budget execution.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18996_shikkou_ex3",
      "japanese": "{裁判所|さいばんしょ}の{命令|めいれい}に{基|もと}づいて{強制執行|きょうせいしっこう}が{行|おこな}われた。",
      "english": "Compulsory execution was carried out based on a court order.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "Used with する: {執行|しっこう}する (to execute/enforce). Common compounds: {執行猶予|しっこうゆうよ} (suspended sentence), {強制執行|きょうせいしっこう} (compulsory execution/foreclosure), {執行部|しっこうぶ} (executive committee), {執行役員|しっこうやくいん} (executive officer). Not to be confused with the homophone {失効|しっこう} (expiration/lapse of validity). {執行猶予|しっこうゆうよ} is a very common legal term in Japan, similar to probation.",
  "cross_references": [
    {
