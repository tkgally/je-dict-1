  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to wipe off; to wipe away; to clean by wiping",
      "explanation": "To remove dirt, liquid, or other substances from a surface by wiping with a cloth or tissue."
    }
  ],
  "examples": [
