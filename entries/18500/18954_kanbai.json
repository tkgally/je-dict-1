  "definitions": [
    {
      "sense_number": 1,
      "gloss": "sold out; completely sold",
      "explanation": "The state of all available items or tickets having been sold, with none remaining. Used for merchandise, tickets, and limited-edition products."
    }
  ],
  "examples": [
    {
      "id": "18954_kanbai_ex1",
      "japanese": "チケットは{完売|かんばい}した。",
      "english": "The tickets are sold out.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18954_kanbai_ex2",
      "japanese": "{限定|げんてい}{商品|しょうひん}は{発売|はつばい}{初日|しょにち}に{完売|かんばい}した。",
      "english": "The limited-edition product sold out on the first day of release.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18954_kanbai_ex3",
      "japanese": "{人気|にんき}のコンサートだったので、チケットは{発売|はつばい}{開始|かいし}{数分|すうふん}で{完売|かんばい}になった。",
      "english": "Since it was a popular concert, tickets sold out within minutes of going on sale.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "Composed of {完|かん} (complete) + {売|ばい} (sell). Can be used as {完売|かんばい}する (to sell out) or {完売|かんばい}になる (to become sold out). Often seen on signs and notices: {完売|かんばい}{御礼|おんれい} (thank you, sold out). Similar to {売|う}り{切|き}れ (sold out), which is more colloquial. {完売|かんばい} is more formal and often used in business and event contexts.",
