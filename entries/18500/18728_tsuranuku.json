  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to pierce through; to penetrate",
      "explanation": "To pass completely through something from one side to the other. Used for physical objects like arrows, bullets, or roads that run through an area."
    },
    {
      "sense_number": 2,
      "gloss": "to carry through; to stick to; to persist in",
      "explanation": "To maintain a belief, principle, or course of action without wavering. Implies strong determination and consistency."
    }
  ],
  "examples": [
