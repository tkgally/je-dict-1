  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to come untied; to come undone; to unravel",
      "explanation": "For something that was tied, knotted, or bound to become loose and come apart on its own."
    },
    {
      "sense_number": 2,
      "gloss": "to relax; to soften",
      "explanation": "For tension, a stiff expression, or a guarded attitude to ease and become relaxed. Used figuratively."
    }
  ],
