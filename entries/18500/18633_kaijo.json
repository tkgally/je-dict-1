  "definitions": [
    {
      "sense_number": 1,
      "gloss": "personal assistance; caregiving; physical support",
      "explanation": "Providing hands-on assistance to people who need help with daily activities due to age, disability, or illness. Focuses on physical support such as helping with movement, eating, and bathing."
    }
  ],
