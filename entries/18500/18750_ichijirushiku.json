{
  "id": "18750_ichijirushiku",
  "headword": "{著|いちじる}しく",
  "reading": "いちじるしく",
  "romaji": "ichijirushiku",
  "part_of_speech": "adverb",
  "gloss": "remarkably; significantly; conspicuously",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "remarkably; significantly; conspicuously; noticeably",
      "explanation": "To a striking or notable degree. The adverbial form of the i-adjective 著しい. Used in formal and written contexts to describe changes, differences, or developments that are clearly evident."
    }
  ],
  "examples": [
    {
      "id": "18750_ichijirushiku_ex1",
      "japanese": "{技術|ぎじゅつ}が{著|いちじる}しく{進歩|しんぽ}した。",
      "english": "Technology has advanced remarkably.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18750_ichijirushiku_ex2",
      "japanese": "{成績|せいせき}が{著|いちじる}しく{低下|ていか}している。",
      "english": "Academic performance has declined significantly.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18750_ichijirushiku_ex3",
      "japanese": "{公正|こうせい}さを{著|いちじる}しく{欠|か}く{判断|はんだん}だと{批判|ひはん}された。",
      "english": "It was criticized as a judgment that conspicuously lacked fairness.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "The adverbial form of {著|いちじる}しい (remarkable, conspicuous). Frequently appears in formal writing, news, and legal/academic texts. Common collocations: {著|いちじる}しく{増加|ぞうか}する (increase remarkably), {著|いちじる}しく{低下|ていか}する (decline significantly), {著|いちじる}しく{欠|か}く (conspicuously lack). In legal contexts, {著|いちじる}しく{不当|ふとう} means 'grossly unfair' and is a standard legal phrase.",
