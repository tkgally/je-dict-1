  "id": "18815_touji",
  "headword": "{湯治|とうじ}",
  "reading": "とうじ",
  "romaji": "touji",
  "part_of_speech": "noun, verb-suru",
  "gloss": "hot spring cure; therapeutic bathing",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "hot spring cure; therapeutic bathing at a hot spring",
      "explanation": "The practice of staying at a hot spring for an extended period to treat illness or promote health. A traditional Japanese form of convalescence."
    }
  ],
  "examples": [
    {
      "id": "18815_touji_ex1",
      "japanese": "{温泉|おんせん}で{湯治|とうじ}する。",
      "english": "To take a hot spring cure.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18815_touji_ex2",
      "japanese": "{祖母|そぼ}は{毎年|まいとし}{湯治|とうじ}に{行|い}っている。",
      "english": "My grandmother goes for a hot spring cure every year.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18815_touji_ex3",
      "japanese": "{湯治|とうじ}{場|ば}として{有名|ゆうめい}なこの{温泉|おんせん}には{長期|ちょうき}{滞在|たいざい}の{客|きゃく}が{多|おお}い。",
      "english": "This hot spring, famous as a therapeutic bathing destination, has many long-term guests.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "A traditional practice where people stay at hot springs ({温泉|おんせん}) for days or weeks to heal ailments. {湯治|とうじ}{場|ば} (therapeutic bathing spot) and {湯治|とうじ}{客|きゃく} (therapeutic bathing guest) are common compounds. Not to be confused with the homophones {冬至|とうじ} (winter solstice) or {当時|とうじ} (at that time). While modern day trips to hot springs are common, {湯治|とうじ} specifically implies extended stays for health purposes.",
