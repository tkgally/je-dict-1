{
  "id": "18846_fuusa",
  "headword": "{封鎖|ふうさ}",
  "reading": "ふうさ",
  "romaji": "fuusa",
  "part_of_speech": "noun",
  "gloss": "blockade; sealing off; lockdown",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "blockade; sealing off; lockdown",
      "explanation": "The act of closing off or blocking access to an area, border, account, or system to prevent entry, exit, or use."
    }
  ],
  "examples": [
    {
      "id": "18846_fuusa_ex1",
      "japanese": "{道路|どうろ}が{封鎖|ふうさ}された。",
      "english": "The road was blocked off.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18846_fuusa_ex2",
      "japanese": "{警察|けいさつ}が{現場|げんば}{周辺|しゅうへん}を{封鎖|ふうさ}している。",
      "english": "The police have sealed off the area around the scene.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18846_fuusa_ex3",
      "japanese": "{感染症|かんせんしょう}の{拡大|かくだい}を{防|ふせ}ぐため、{都市|とし}が{封鎖|ふうさ}された。",
      "english": "The city was locked down to prevent the spread of the infection.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "Used as both a noun and a suru-verb ({封鎖|ふうさ}する). Common collocations include {道路|どうろ}{封鎖|ふうさ} (road blockade), {国境|こっきょう}{封鎖|ふうさ} (border closure), {口座|こうざ}{封鎖|ふうさ} (account freeze), and {都市|とし}{封鎖|ふうさ} (city lockdown). The word gained wider usage during pandemic-related discussions as the Japanese equivalent of lockdown, though ロックダウン is also used.",
