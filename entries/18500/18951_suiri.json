      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18951_suiri_ex2",
      "japanese": "{探偵|たんてい}は{鋭|するど}い{推理|すいり}で{犯人|はんにん}を{突|つ}き{止|と}めた。",
      "english": "The detective identified the culprit through sharp deduction.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18951_suiri_ex3",
      "japanese": "{証拠|しょうこ}から{推理|すいり}すると、{犯行|はんこう}は{深夜|しんや}に{行|おこな}われたようだ。",
      "english": "Reasoning from the evidence, it appears the crime was committed late at night.",
