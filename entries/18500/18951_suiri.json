      "sense_number": 1,
      "gloss": "reasoning; deduction; inference",
      "explanation": "The process of drawing conclusions from evidence or known facts through logical thinking. Commonly associated with detective work and mystery fiction."
    }
  ],
  "examples": [
    {
      "id": "18951_suiri_ex1",
      "japanese": "{推理|すいり}{小説|しょうせつ}が{好|す}きだ。",
