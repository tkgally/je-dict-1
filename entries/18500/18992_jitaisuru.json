{
  "id": "18992_jitaisuru",
  "headword": "{辞退|じたい}する",
  "reading": "じたいする",
  "part_of_speech": "verb",
  "gloss": "to decline; to turn down; to withdraw",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to decline; to turn down; to withdraw",
      "explanation": "To politely refuse an offer, honor, or opportunity. Also used when withdrawing from a competition, candidacy, or position. More formal than {断|ことわ}る and implies a respectful refusal."
    }
  ],
  "examples": [
    {
      "id": "18992_jitaisuru_ex1",
      "japanese": "{出席|しゅっせき}を{辞退|じたい}する。",
      "english": "I decline to attend.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18992_jitaisuru_ex2",
      "japanese": "{体調不良|たいちょうふりょう}のため、{大会|たいかい}への{出場|しゅつじょう}を{辞退|じたい}した。",
      "english": "Due to poor health, I withdrew from the tournament.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18992_jitaisuru_ex3",
      "japanese": "せっかくのご{招待|しょうたい}ですが、{今回|こんかい}は{辞退|じたい}させていただきます。",
      "english": "Thank you for the kind invitation, but I must decline this time.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "A formal, polite way to refuse. Common collocations: {出席|しゅっせき}を{辞退|じたい}する (decline to attend), {受賞|じゅしょう}を{辞退|じたい}する (decline an award), {候補|こうほ}を{辞退|じたい}する (withdraw one's candidacy). The polite form {辞退|じたい}させていただきます is frequently used in business and formal situations. Distinguished from {断|ことわ}る (to refuse, more direct and everyday) and {遠慮|えんりょ}する (to hold back, softer and more about self-restraint).",
