  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to shrink; to contract; to become smaller",
      "explanation": "For something to decrease in size, length, or volume. Used for physical objects shrinking as well as abstract gaps or distances narrowing."
    }
  ],
  "examples": [
    {
      "id": "18725_chijimaru_ex1",
      "japanese": "セーターが{洗濯|せんたく}で{縮|ちぢ}まった。",
      "english": "The sweater shrank in the wash.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18725_chijimaru_ex2",
      "japanese": "{二人|ふたり}の{距離|きょり}が{縮|ちぢ}まってきた。",
      "english": "The distance between the two of them has been closing.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18725_chijimaru_ex3",
      "japanese": "{寒|さむ}さで{体|からだ}が{縮|ちぢ}まる{思|おも}いだった。",
      "english": "I felt like my body was shriveling up from the cold.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
