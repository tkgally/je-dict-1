  "gloss": "simmering; bubbling",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "simmering; bubbling; boiling gently",
      "explanation": "An onomatopoeic word describing the sound and appearance of liquid simmering or boiling in a pot. Suggests steady, continuous bubbling at moderate heat."
    }
  ],
  "examples": [
    {
      "id": "18531_gutsugutsu_ex1",
      "japanese": "スープがぐつぐつ{煮|に}えている。",
      "english": "The soup is simmering away.",
