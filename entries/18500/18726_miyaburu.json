  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to see through; to detect; to expose",
      "explanation": "To perceive or discover a hidden truth, lie, trick, or disguise. Implies successfully uncovering something that was meant to be concealed."
    }
  ],
  "examples": [
