{
  "id": "18857_jimetsu",
  "headword": "{自滅|じめつ}",
  "reading": "じめつ",
  "romaji": "jimetsu",
  "part_of_speech": "noun",
  "gloss": "self-destruction; self-ruin",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "self-destruction; self-ruin; bringing about one's own downfall",
      "explanation": "Destroying oneself or ruining one's own position through one's own actions or mistakes, rather than being defeated by an external force."
    }
  ],
  "examples": [
    {
      "id": "18857_jimetsu_ex1",
      "japanese": "{相手|あいて}の{自滅|じめつ}を{待|ま}つ。",
      "english": "I'll wait for my opponent to self-destruct.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18857_jimetsu_ex2",
      "japanese": "ミスが{続|つづ}いて{自滅|じめつ}してしまった。",
      "english": "A string of mistakes led to my own downfall.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18857_jimetsu_ex3",
      "japanese": "{自滅|じめつ}{的|てき}な{行動|こうどう}を{取|と}らないように、{冷静|れいせい}に{判断|はんだん}することが{大切|たいせつ}だ。",
      "english": "It's important to make calm decisions so as not to take self-destructive actions.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "Used as both a noun and a suru-verb ({自滅|じめつ}する). Frequently used in sports, games, business, and politics to describe losing not because the opponent was better, but because of one's own errors. Common expressions include {自滅|じめつ}する (to self-destruct), {自滅|じめつ}{的|てき} (self-destructive), and {相手|あいて}の{自滅|じめつ} (the opponent's self-destruction). Differs from {自殺|じさつ} (suicide), which is literal.",
