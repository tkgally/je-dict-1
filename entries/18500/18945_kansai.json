  "part_of_speech": "noun / する verb",
  "gloss": "full repayment; paying off (a debt)",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "full repayment; paying off a debt completely",
      "explanation": "The act of finishing payment on a loan, debt, or other financial obligation. Means paying the entire amount owed, with nothing remaining."
    }
  ],
  "examples": [
    {
      "id": "18945_kansai_ex1",
      "japanese": "ローンを{完済|かんさい}した。",
      "english": "I paid off the loan.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18945_kansai_ex2",
      "japanese": "{住宅|じゅうたく}ローンの{完済|かんさい}まであと{五年|ごねん}かかる。",
