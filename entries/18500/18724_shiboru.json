  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to squeeze out; to extract; to press out",
      "explanation": "To extract liquid or essence from something by applying pressure. Used for juicing fruit, pressing oil, extracting flavor, etc."
    },
    {
      "sense_number": 2,
      "gloss": "to milk",
      "explanation": "To draw milk from a cow or other animal."
    }
  ],
