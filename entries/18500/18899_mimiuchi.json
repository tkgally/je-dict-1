{
  "id": "18899_mimiuchi",
  "headword": "{耳打|みみう}ち",
  "reading": "みみうち",
  "romaji": "mimiuchi",
  "part_of_speech": "noun, verb-suru",
  "gloss": "whispering in someone's ear",
  "conjugation": {
    "type": "suru",
    "prefix": "{耳打|みみう}ち"
  },
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "whispering in someone's ear; telling someone something privately",
      "explanation": "The act of leaning close to someone and speaking quietly so others cannot hear. Often implies sharing a secret or confidential information."
    }
  ],
  "examples": [
    {
      "id": "18899_mimiuchi_ex1",
      "japanese": "{彼女|かのじょ}に{耳打|みみう}ちした。",
      "english": "I whispered in her ear.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18899_mimiuchi_ex2",
      "japanese": "{隣|となり}の{人|ひと}にそっと{耳打|みみう}ちする。",
      "english": "To quietly whisper to the person next to you.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18899_mimiuchi_ex3",
      "japanese": "{会議中|かいぎちゅう}に{部長|ぶちょう}が{秘書|ひしょ}に{何|なに}か{耳打|みみう}ちしていた。",
      "english": "During the meeting, the department head was whispering something to the secretary.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "Takes する to form a verb: {耳打|みみう}ちする. The person you whisper to is marked with に. Common collocations: そっと{耳打|みみう}ちする (to whisper quietly), {何|なに}か{耳打|みみう}ちする (to whisper something). Distinct from {囁|ささや}く (to whisper) in that {耳打|みみう}ち specifically implies leaning close to someone's ear, while {囁|ささや}く can describe any soft speech.",
