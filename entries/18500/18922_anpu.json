  "definitions": [
    {
      "sense_number": 1,
      "gloss": "playing from memory; memorizing a musical score; performing without sheet music",
      "explanation": "The act of memorizing a piece of music well enough to perform it without looking at the sheet music. A key skill for musicians, especially in classical music performance."
    }
  ],
