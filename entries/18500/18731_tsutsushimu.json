  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to respectfully do; to humbly offer",
      "explanation": "To perform an action with deep respect and humility. Used in very formal contexts such as official announcements, New Year's greetings, and formal letters. Almost always appears in the form 謹んで (respectfully)."
    }
  ],
  "examples": [
    {
      "id": "18731_tsutsushimu_ex1",
      "japanese": "{謹|つつし}んでお{受|う}けいたします。",
      "english": "I humbly accept.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18731_tsutsushimu_ex2",
      "japanese": "{謹|つつし}んで{新年|しんねん}のお{慶|よろこ}びを{申|もう}し{上|あ}げます。",
      "english": "I respectfully offer my New Year's congratulations.",
      "sense_numbers": [
