{
  "id": "18520_chikaku",
  "headword": "{知覚|ちかく}",
  "reading": "ちかく",
  "romaji": "chikaku",
  "part_of_speech": "noun / verb (suru)",
  "gloss": "perception; sensation",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "perception; sensation; awareness through the senses",
      "explanation": "The ability to perceive through the senses (sight, hearing, touch, taste, smell), or the act of perceiving something. Used in both everyday and scientific/medical contexts."
    }
  ],
  "examples": [
    {
      "id": "18520_chikaku_ex1",
      "japanese": "{痛|いた}みを{知覚|ちかく}する。",
      "english": "To perceive pain.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18520_chikaku_ex2",
      "japanese": "{知覚|ちかく}{過敏|かびん}で{冷|つめ}たいものが{歯|は}にしみる。",
      "english": "Due to tooth sensitivity, cold things sting my teeth.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18520_chikaku_ex3",
      "japanese": "{人間|にんげん}の{知覚|ちかく}には{限界|げんかい}があり、{見|み}えないものも{多|おお}い。",
      "english": "Human perception has its limits, and there are many things we cannot see.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "Not to be confused with homophones {地殻|ちかく} (earth's crust) or {近|ちか}く (nearby). In dentistry, {知覚|ちかく}{過敏|かびん} (tooth sensitivity / hypersensitivity) is a very common usage. In psychology and philosophy, {知覚|ちかく} refers to the cognitive process of interpreting sensory input. Common collocations: {知覚|ちかく}{神経|しんけい} (sensory nerve), {知覚|ちかく}{障害|しょうがい} (perceptual disorder), {視覚|しかく}{知覚|ちかく} (visual perception).",
