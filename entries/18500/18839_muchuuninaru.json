{
  "id": "18839_muchuuninaru",
  "headword": "{夢中|むちゅう}になる",
  "reading": "むちゅうになる",
  "romaji": "muchuuninaru",
  "part_of_speech": "expression",
  "gloss": "to become absorbed; to be engrossed",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to become absorbed in; to be engrossed in",
      "explanation": "To become so focused on or fascinated by something that one loses awareness of everything else."
    }
  ],
  "examples": [
    {
      "id": "18839_muchuuninaru_ex1",
      "japanese": "ゲームに{夢中|むちゅう}になる。",
      "english": "I get absorbed in games.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18839_muchuuninaru_ex2",
      "japanese": "{子|こ}どもたちは{砂|すな}{遊|あそ}びに{夢中|むちゅう}になっていた。",
      "english": "The children were engrossed in playing in the sand.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18839_muchuuninaru_ex3",
      "japanese": "{読書|どくしょ}に{夢中|むちゅう}になって、{電車|でんしゃ}を{乗|の}り{過|す}ごしてしまった。",
      "english": "I got so absorbed in reading that I missed my train stop.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "The pattern is ～に{夢中|むちゅう}になる, where に marks the object of fascination. {夢中|むちゅう} can also be used as a na-adjective: {夢中|むちゅう}で{走|はし}った (ran frantically). When used with で instead of に, it often conveys doing something desperately or without thinking, rather than being fascinated. The literal meaning of {夢中|むちゅう} is \"in a dream,\" reflecting the idea of being so absorbed that reality fades away.",
