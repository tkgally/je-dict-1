  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to back away; to step back; to retreat",
      "explanation": "To move backward, typically out of fear, surprise, or discomfort. Often implies an instinctive, involuntary reaction."
    }
  ],
  "examples": [
    {
      "id": "18853_atozusaru_ex1",
