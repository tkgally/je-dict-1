  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to start moving; to begin to move; to get into motion",
      "explanation": "To begin moving after being still. Used for physical objects, vehicles, and figuratively for projects, plans, or situations that begin to progress."
    }
  ],
