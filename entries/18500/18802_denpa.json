    "prefix": "{伝播|でんぱ}"
  },
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "propagation; spread; transmission",
      "explanation": "The spreading or transmission of something (disease, culture, ideas, waves) from one place or person to another. More formal and technical than {広|ひろ}がる."
    }
  ],
  "examples": [
    {
      "id": "18802_denpa_ex1",
      "japanese": "{感染症|かんせんしょう}が{急速|きゅうそく}に{伝播|でんぱ}した。",
      "english": "The infectious disease spread rapidly.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18802_denpa_ex2",
      "japanese": "{仏教|ぶっきょう}はインドから{東|ひがし}アジアに{伝播|でんぱ}した。",
      "english": "Buddhism spread from India to East Asia.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "18802_denpa_ex3",
      "japanese": "SNSを{通|つう}じて{情報|じょうほう}が{瞬時|しゅんじ}に{伝播|でんぱ}する{時代|じだい}になった。",
      "english": "We live in an era where information spreads instantly through social media.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "Not to be confused with the homophone {電波|でんぱ} (radio waves). {伝播|でんぱ} is used in formal and academic writing for the spread of diseases, cultures, technologies, and ideas. In scientific contexts, it also refers to wave propagation ({音|おと}の{伝播|でんぱ} — propagation of sound). The reading でんぱ is standard; the alternative reading でんぱん is also seen but less common.",
