{
  "id": "18802_denpa",
  "headword": "{伝播|でんぱ}",
  "reading": "でんぱ",
  "romaji": "denpa",
  "part_of_speech": "noun, verb-suru",
  "gloss": "propagation; spread; transmission",
  "conjugation": {
