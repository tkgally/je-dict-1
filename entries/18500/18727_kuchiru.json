  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to decay; to rot; to crumble away",
      "explanation": "For something (typically wood, buildings, or organic matter) to deteriorate over time and fall apart. Often carries a literary or evocative tone. Can also be used figuratively for reputations or names fading into obscurity."
    }
  ],
  "examples": [
