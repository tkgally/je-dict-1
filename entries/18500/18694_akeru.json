  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to empty; to make room; to clear out",
      "explanation": "To remove the contents of something, making it empty or creating space."
    },
    {
      "sense_number": 2,
      "gloss": "to vacate; to leave open",
      "explanation": "To leave a position, seat, or place unoccupied. Also used for making time available."
    }
  ],
