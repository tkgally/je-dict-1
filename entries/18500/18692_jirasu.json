  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to tease; to keep in suspense; to tantalize",
      "explanation": "To deliberately make someone wait or withhold something they want, causing them to feel impatient or frustrated."
    }
  ],
  "examples": [
    {
