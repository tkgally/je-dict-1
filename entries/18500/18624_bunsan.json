  "definitions": [
    {
      "sense_number": 1,
      "gloss": "dispersion; scattering; spreading out",
      "explanation": "The act or state of things being spread out or scattered across a wide area or among multiple points."
    },
    {
      "sense_number": 2,
      "gloss": "decentralization; distribution of resources or risk",
      "explanation": "Deliberately spreading out resources, functions, or risk across multiple locations or areas to reduce concentration."
    }
