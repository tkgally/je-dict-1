  "definitions": [
    {
      "sense_number": 1,
      "gloss": "savings; saving money",
      "explanation": "Money set aside for future use, or the act of accumulating money over time. More formal than {貯金|ちょきん} and often used in financial and economic contexts to refer to total accumulated assets, not just bank deposits."
    }
  ],
  "examples": [
    {
      "id": "18972_chochiku_ex1",
      "japanese": "{老後|ろうご}のために{貯蓄|ちょちく}する。",
      "english": "I save money for retirement.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
