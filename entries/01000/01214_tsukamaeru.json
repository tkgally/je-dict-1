  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to catch, to capture",
      "explanation": "To seize and hold something or someone, especially something that was trying to escape."
    },
    {
      "sense_number": 2,
      "gloss": "to arrest",
      "explanation": "To apprehend a criminal or suspect."
    }
