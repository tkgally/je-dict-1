  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be (honorific)",
      "explanation": "Honorific form of いる, used to show respect toward the subject."
    },
    {
      "sense_number": 2,
      "gloss": "to come; to go (honorific)",
      "explanation": "Honorific form of 来る or 行く."
    }
  ],
  "examples": [
