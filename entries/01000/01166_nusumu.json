{
  "id": "01166_nusumu",
  "headword": "{盗|ぬす}む",
  "reading": "ぬすむ",
  "part_of_speech": "verb (godan)",
  "gloss": "to steal",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to steal, to rob",
      "explanation": "To take something that belongs to someone else without permission."
    }
  ],
  "examples": [
    {
      "id": "01166_nusumu_ex1",
      "japanese": "⟦{財布|さいふ}→財布：00663_saifu⟧⟦を→を：00422_wo⟧{盗|ぬす}まれた。",
      "english": "My wallet was stolen.",
      "notes": "Passive form is common for victims",
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "01166_nusumu_ex2",
      "japanese": "⟦{泥棒|どろぼう}→泥棒：01688_dorobou⟧⟦が→が：00051_ga⟧⟦{宝石|ほうせき}→宝石：03619_houseki⟧⟦を→を：00422_wo⟧{盗|ぬす}んだ。",
      "english": "The thief stole the jewels.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "01166_nusumu_ex3",
      "japanese": "⟦{人|ひと}→人：00476_hito⟧⟦の→の：09472_no⟧⟦もの→物：02259_mono⟧⟦を→を：00422_wo⟧{盗|ぬす}んではいけない。",
      "english": "You must not steal other people's things.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
