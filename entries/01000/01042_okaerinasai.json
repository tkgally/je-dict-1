  "gloss": "welcome back",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "welcome back, welcome home",
      "explanation": "A set phrase said to someone who has just returned home or to a place. It is the standard response to ただいま."
    }
  ],
