  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to jump up and down; to hop; to bounce around",
      "explanation": "To make repeated jumping or hopping movements, typically expressing excitement, joy, or energetic movement."
    },
    {
      "sense_number": 2,
      "gloss": "to splatter; to splash up",
      "explanation": "For liquid or small particles to jump or fly up, as when something is dropped into water or when cooking oil splatters."
    }
  ],
