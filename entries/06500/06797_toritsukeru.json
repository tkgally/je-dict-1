  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to install, to attach, to fit",
      "explanation": "To install equipment or attach something to a fixed position. Often used for mounting devices, fixtures, or appliances."
    },
    {
      "sense_number": 2,
      "gloss": "to secure, to obtain (an appointment/promise)",
      "explanation": "To successfully obtain an appointment, meeting, or promise from someone."
    }
  ],
  "examples": [
