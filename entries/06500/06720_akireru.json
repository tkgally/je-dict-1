  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be amazed; to be appalled; to be dumbfounded",
      "explanation": "To be shocked or dismayed by something unexpected, usually in a negative way - left speechless by someone's behavior or a situation."
    }
  ],
  "examples": [
    {
      "id": "06720_akireru_ex1",
