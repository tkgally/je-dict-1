{
  "id": "06701_sashihiku",
  "headword": "{差|さ}し{引|ひ}く",
  "reading": "さしひく",
  "part_of_speech": "verb (godan, transitive)",
  "gloss": "to deduct; to subtract; to balance",
  "conjugation": {
    "type": "godan",
    "ending": "く",
