  "headword": "{貼|は}り{付|つ}ける",
  "reading": "はりつける",
  "part_of_speech": "verb (ichidan, transitive)",
  "gloss": "to paste; to stick on; to attach",
  "conjugation": {
    "type": "ichidan",
    "stem": "{貼|は}り{付|つ}け"
