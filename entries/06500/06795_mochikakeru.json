  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to propose, to suggest, to make overtures",
      "explanation": "To bring up a proposal or suggestion to someone, often implying an attempt to persuade or negotiate."
    }
  ],
  "examples": [
    {
      "id": "06795_mochikakeru_ex1",
      "japanese": "{彼|かれ}は{私|わたし}に{新|あたら}しいビジネスの{話|はなし}を{持|も}ちかけてきた。",
      "english": "He came to me with a new business proposal.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "06795_mochikakeru_ex2",
      "japanese": "{取引先|とりひきさき}から{共同|きょうどう}{開発|かいはつ}の{話|はなし}を{持|も}ちかけられた。",
      "english": "Our business partner proposed a joint development project.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "06795_mochikakeru_ex3",
      "japanese": "{怪|あや}しい{投資話|とうしばなし}を{持|も}ちかける{詐欺|さぎ}に{注意|ちゅうい}。",
      "english": "Be careful of scams that approach you with suspicious investment proposals.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
