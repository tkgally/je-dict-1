  "gloss": "to steal a glance at; to peek at",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to steal a glance at; to peek at",
      "explanation": "To look at someone or something secretly, so as not to be noticed."
    }
  ],
  "examples": [
    {
      "id": "33478_nusumimiru_ex1",
