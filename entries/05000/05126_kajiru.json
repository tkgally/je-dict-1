  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to gnaw, to nibble, to bite",
      "explanation": "To bite or chew repeatedly at something with the front teeth."
    },
    {
      "sense_number": 2,
      "gloss": "to dabble in, to have superficial knowledge",
      "explanation": "To have only partial or superficial knowledge of something (figurative usage)."
    }
  ],
