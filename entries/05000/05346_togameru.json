{
  "id": "05346_togameru",
  "headword": "{咎|とが}める",
  "reading": "とがめる",
  "part_of_speech": "ichidan verb",
  "gloss": "to blame; to reproach; to question",
  "conjugation": {
    "type": "ichidan",
    "stem": "{咎|とが}め"
  },
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to blame; to reproach; to find fault with",
      "explanation": "To criticize someone for their wrongdoing or mistake."
    },
    {
      "sense_number": 2,
      "gloss": "to question; to challenge",
      "explanation": "To question someone's actions or identity, often in a suspicious manner."
    }
  ],
  "examples": [
    {
      "id": "05346_togameru_ex1",
      "japanese": "{良心|りょうしん}が{咎|とが}める。",
      "english": "My conscience bothers me.",
      "notes": "Common idiomatic expression",
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "05346_togameru_ex2",
      "japanese": "{彼|かれ}の{行動|こうどう}を{咎|とが}めた。",
      "english": "I reproached him for his behavior.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "05346_togameru_ex3",
      "japanese": "{警備員|けいびいん}に{咎|とが}められた。",
      "english": "I was questioned by the security guard.",
