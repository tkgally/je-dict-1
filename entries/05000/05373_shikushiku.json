  "part_of_speech": "adverb",
  "gloss": "sobbing; whimpering; sniffling",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "sobbing; whimpering; sniffling",
      "explanation": "Crying softly with small sobs, often suppressing the sound."
    },
    {
      "sense_number": 2,
      "gloss": "aching dully",
      "explanation": "A mild, continuous ache (usually stomach)."
    }
  ],
  "examples": [
