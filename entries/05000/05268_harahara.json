    {
      "sense_number": 1,
      "gloss": "anxiously; nervously; on edge",
      "explanation": "Describes feeling anxious while watching something unfold, worried about the outcome."
    },
    {
      "sense_number": 2,
      "gloss": "fluttering down; falling gently",
      "explanation": "Describes light things like leaves, petals, or tears falling gently."
    }
  ],
