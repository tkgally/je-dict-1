  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to wilt; to shrivel; to wither",
      "explanation": "For flowers or plants to lose freshness and droop."
    },
    {
      "sense_number": 2,
      "gloss": "to deflate; to go flat",
      "explanation": "For something inflated to lose air and become smaller."
    },
    {
      "sense_number": 3,
      "gloss": "to dwindle; to fade (abstract)",
      "explanation": "For enthusiasm, hopes, or spirits to diminish."
    }
  ],
  "examples": [
