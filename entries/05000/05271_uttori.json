      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "05271_uttori_ex4",
      "japanese": "うっとりするような{香|かお}りだ。",
      "english": "It's an enchanting fragrance.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "05271_uttori_ex5",
