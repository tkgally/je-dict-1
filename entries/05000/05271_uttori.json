  "definitions": [
    {
      "sense_number": 1,
      "gloss": "entranced; captivated; enchanted",
      "explanation": "Describes being deeply absorbed in something beautiful or pleasant, in a dreamy state of admiration."
    }
  ],
  "examples": [
    {
      "id": "05271_uttori_ex1",
      "japanese": "うっとりする。",
      "english": "I'm entranced.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "05271_uttori_ex2",
      "japanese": "{彼女|かのじょ}の{歌声|うたごえ}にうっとりする。",
      "english": "I'm enchanted by her singing voice.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "05271_uttori_ex3",
      "japanese": "{夜景|やけい}をうっとり{眺|なが}めた。",
