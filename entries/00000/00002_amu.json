      "sense_number": 1,
      "gloss": "to knit, to crochet",
      "explanation": "To create fabric by interlocking loops of yarn with needles."
    },
    {
      "sense_number": 2,
      "gloss": "to braid, to plait",
      "explanation": "To weave strands together into a pattern."
    }
  ],
