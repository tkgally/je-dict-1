      "explanation": "To cut a shape or design into a hard material like wood or stone."
    },
    {
      "sense_number": 2,
      "gloss": "to engrave",
      "explanation": "To cut letters or designs into a surface."
    },
    {
      "sense_number": 3,
      "gloss": "to tattoo",
      "explanation": "To create permanent designs on skin."
    }
  ],
