{
  "id": "00001_amaru",
  "headword": "{余|あま}る",
  "reading": "あまる",
  "part_of_speech": "verb (godan)",
  "gloss": "to be left over, to remain, to be in excess",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be left over, to remain",
      "explanation": "To have a surplus after use or distribution."
    },
    {
      "sense_number": 2,
      "gloss": "to exceed, to be too much",
      "explanation": "To be more than what is needed or expected."
    }
  ],
  "examples": [
    {
