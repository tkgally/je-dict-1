      "sense_numbers": [
        2
      ]
    },
    {
      "id": "00001_amaru_ex4",
      "japanese": "パーティーの{料理|りょうり}がたくさん{余|あま}ったので、{近所|きんじょ}の{人|ひと}に{分|わ}けた。",
      "english": "There was a lot of food left over from the party, so I shared it with the neighbors.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "00001_amaru_ex5",
      "japanese": "この{仕事|しごと}は{私|わたし}の{手|て}に{余|あま}る。",
      "english": "This job is beyond my capability.",
