{
  "id": "00027_chijimu",
  "headword": "{縮|ちぢ}む",
  "reading": "ちぢむ",
  "part_of_speech": "godan verb",
  "gloss": "to shrink; to contract; to be reduced",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to shrink; to contract",
      "explanation": "To become smaller in size, typically of fabric, materials, or physical dimensions."
    },
    {
      "sense_number": 2,
      "gloss": "to be reduced; to decrease",
      "explanation": "To become smaller in scale, scope, or amount."
    },
    {
      "sense_number": 3,
      "gloss": "to cower; to cringe",
      "explanation": "To shrink back in fear or discomfort."
    }
  ],
