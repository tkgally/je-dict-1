  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to rub, to massage",
      "explanation": "To press and move hands over muscles to relieve tension."
    },
    {
      "sense_number": 2,
      "gloss": "to crumple, to wrinkle",
      "explanation": "To crush or squeeze paper or cloth."
    },
    {
      "sense_number": 3,
      "gloss": "to thrash out, to hash out (an issue)",
      "explanation": "To subject a plan or opinion to vigorous back-and-forth discussion. Most often met in the passive {揉|も}まれる, which also means to be knocked about by hardship or by a demanding environment."
    }
  ],
