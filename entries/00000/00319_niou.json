  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to smell; to give off a smell",
      "explanation": "To emit an odor, whether pleasant or unpleasant."
    },
    {
      "sense_number": 2,
      "gloss": "to be fragrant; to smell nice",
      "explanation": "To have a pleasant aroma."
    },
    {
      "sense_number": 3,
      "gloss": "to smack of; to hint at",
      "explanation": "To suggest or give an impression of something (figurative)."
    }
  ],
