  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to wait",
      "explanation": "To stay in place or delay action until something happens or someone arrives."
    },
    {
      "sense_number": 2,
      "gloss": "to look forward to, to await",
      "explanation": "To anticipate something with expectation. {楽|たの}しみに{待|ま}つ (to look forward to)."
    }
  ],
