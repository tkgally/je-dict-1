  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to dry, to air out",
      "explanation": "To expose something to air or sun to remove moisture."
    },
    {
      "sense_number": 2,
      "gloss": "to drain (a cup)",
      "explanation": "To drink up completely."
    }
  ],
