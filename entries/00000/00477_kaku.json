  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to write",
      "explanation": "To form letters, characters, or symbols on a surface. Used for writing by hand, typing, or composing text. Covers both the physical act of writing and the creative act of composing."
    },
    {
      "sense_number": 2,
      "gloss": "to draw, to paint",
      "explanation": "Can also mean to draw or paint pictures, though {描|えが}く/{描|か}く is more specific for artistic drawing."
    }
  ],
