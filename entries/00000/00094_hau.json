  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to crawl, to creep",
      "explanation": "To move close to the ground on hands and knees, or like a snake or insect."
    },
    {
      "sense_number": 2,
      "gloss": "to spread, to creep (plants)",
      "explanation": "For plants or vines to grow along the ground or a surface."
    }
  ],
