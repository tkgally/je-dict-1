  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to eat",
      "explanation": "The most common verb for eating. Used for consuming food by putting it in the mouth and swallowing. This is the neutral form without politeness implications, unlike {召|め}し{上|あ}がる (meshiagaru) which is honorific or いただく (itadaku) which is humble."
    }
  ],
