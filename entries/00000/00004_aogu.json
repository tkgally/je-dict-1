{
  "id": "00004_aogu",
  "headword": "{扇|あお}ぐ",
  "reading": "あおぐ",
  "part_of_speech": "verb (godan)",
  "gloss": "to fan; to incite, to stir up",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to fan",
      "explanation": "To move air with a fan or similar object to create a breeze."
    },
    {
      "sense_number": 2,
      "gloss": "to incite, to stir up",
      "explanation": "To provoke or encourage (feelings, actions)."
    }
  ],
  "examples": [
    {
      "id": "00004_aogu_ex1",
      "japanese": "⟦うちわ→団扇：04544_uchiwa⟧⟦で→で：00502_de⟧⟦{顔|かお}→顔：00558_kao⟧⟦を→を：00422_wo⟧{扇|あお}ぐ。",
      "english": "I fan my face with a paper fan.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "00004_aogu_ex2",
      "japanese": "⟦{火|ひ}→火：02248_hi⟧⟦を→を：00422_wo⟧{扇|あお}いで⟦{燃|も}やす→燃やす：02318_moyasu⟧。",
      "english": "I fan the fire to make it burn.",
      "notes": null,
