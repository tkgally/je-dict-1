  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to act tough; to put on a brave face; to pretend to be strong",
      "explanation": "To behave as if one is stronger or braver than one actually feels. Implies hiding vulnerability or weakness behind a show of toughness."
    }
  ],
