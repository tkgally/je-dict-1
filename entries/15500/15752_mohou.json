  "definitions": [
    {
      "sense_number": 1,
      "gloss": "imitation; copying; mimicry",
      "explanation": "The act of copying or imitating someone or something, whether in art, behavior, or technique. Often carries a neutral or slightly negative nuance, suggesting a lack of originality. Can be used as a suru-verb. Composed of 模 (model/pattern) + 倣 (emulate)."
    }
  ],
  "examples": [
    {
      "id": "15752_mohou_ex1",
      "japanese": "{子供|こども}は{大人|おとな}を{模倣|もほう}して{学|まな}ぶ。",
      "english": "Children learn by imitating adults.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "15752_mohou_ex2",
