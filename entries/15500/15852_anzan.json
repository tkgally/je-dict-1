  "definitions": [
    {
      "sense_number": 1,
      "gloss": "mental arithmetic; mental calculation; calculating in one's head",
      "explanation": "Performing mathematical calculations without using a calculator, pen and paper, or abacus — purely in one's mind."
    }
  ],
