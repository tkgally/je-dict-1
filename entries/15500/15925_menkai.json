  "definitions": [
    {
      "sense_number": 1,
      "gloss": "visit; meeting; interview",
      "explanation": "A face-to-face visit, especially to see someone in a hospital, prison, or other institution. Also used for formal meetings with officials or important figures."
    }
  ],
