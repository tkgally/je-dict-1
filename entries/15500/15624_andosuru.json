  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be relieved; to feel reassured",
      "explanation": "To experience a feeling of relief after worry or anxiety has been resolved. Commonly used to describe the emotional release when a feared outcome does not occur."
    }
