  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to rewind; to wind back",
      "explanation": "To wind something back to an earlier position. Originally used for tape and film, now also used figuratively for going back in time or reversing progress in digital contexts."
    }
  ],
