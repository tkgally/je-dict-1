  "definitions": [
    {
      "sense_number": 1,
      "gloss": "decisive action; carrying out resolutely; pushing through",
      "explanation": "Carrying out a plan or action with determination, especially when there is opposition or difficulty. Implies boldness and resolve."
    }
  ],
