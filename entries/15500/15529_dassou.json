  "definitions": [
    {
      "sense_number": 1,
      "gloss": "escape; desertion; running away",
      "explanation": "The act of fleeing from confinement, captivity, or a place where one is expected to stay. Used for escaping from prison, military desertion, or animals running away. Composed of 脱 (escape, remove) + 走 (run)."
    }
  ],
  "examples": [
