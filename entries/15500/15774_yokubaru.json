  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be greedy; to want too much; to be grasping",
      "explanation": "To try to get more than one's fair share or more than is reasonable. Composed of 欲 (desire) + 張る (to stretch/extend). Often used as a warning or criticism."
    }
  ],
