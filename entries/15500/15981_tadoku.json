  "definitions": [
    {
      "sense_number": 1,
      "gloss": "extensive reading; reading a large quantity of material",
      "explanation": "A reading approach that emphasizes quantity and breadth, reading many books or texts rather than studying each one in depth. Widely used in language learning contexts to describe reading large amounts of comprehensible material for fluency development."
