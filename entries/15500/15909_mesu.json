  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to eat; to drink (honorific)",
      "explanation": "An honorific verb used to describe someone of high status eating or drinking. More elevated than {食|た}べる or {飲|の}む."
    },
    {
      "sense_number": 2,
      "gloss": "to wear; to put on (honorific)",
      "explanation": "An honorific verb for wearing clothes or accessories. Often heard in retail settings as お{召|め}しになる."
    },
    {
      "sense_number": 3,
      "gloss": "to summon; to call for (honorific)",
      "explanation": "An honorific verb meaning to summon or call someone. Used in formal or historical contexts."
    }
  ],
