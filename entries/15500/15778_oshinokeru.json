  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to push aside; to shove out of the way",
      "explanation": "To physically move someone or something out of one's path by pushing. A compound of 押す (to push) + のける (to move aside)."
    },
    {
      "sense_number": 2,
      "gloss": "to brush aside; to override",
      "explanation": "To disregard or overcome opposition, objections, or rivals in order to proceed. Used figuratively for pushing past obstacles."
    }
  ],
  "examples": [
