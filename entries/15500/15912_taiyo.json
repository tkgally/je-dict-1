  "definitions": [
    {
      "sense_number": 1,
      "gloss": "lending; loaning; provision on loan",
      "explanation": "The formal act of lending something to someone, often with the expectation of return. Used in official, institutional, and business contexts for equipment, scholarships, and other items provided on loan."
    }
  ],
