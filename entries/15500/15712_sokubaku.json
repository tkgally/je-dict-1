  "definitions": [
    {
      "sense_number": 1,
      "gloss": "restraint; restriction; binding; constraint",
      "explanation": "The act of restricting someone's freedom of action or movement, whether physically, socially, or emotionally. Often used for controlling behavior in relationships or oppressive rules."
    }
  ],
