  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to stir; to mix up",
      "explanation": "To stir or mix something by moving it around vigorously, typically with a utensil or by hand. Used for cooking (stirring ingredients), mixing liquids, or figuratively for throwing things into disorder."
    }
  ],
