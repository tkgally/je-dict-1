{
  "id": "28292_hakaru",
  "headword": "{計|はか}る",
  "reading": "はかる",
  "romaji": "hakaru",
  "part_of_speech": "verb (godan)",
  "gloss": "to measure (time); to plan; to scheme",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to measure (time, intervals)",
      "explanation": "To measure time, duration, or numerical intervals — typically using a clock, stopwatch, or counter."
    },
    {
      "sense_number": 2,
      "gloss": "to plan; to plot; to scheme",
      "explanation": "To devise or attempt something, often with a calculated or strategic intent. In set phrases this sense can carry either neutral or negative connotations."
    }
  ],
  "examples": [
    {
      "id": "28292_hakaru_ex1",
