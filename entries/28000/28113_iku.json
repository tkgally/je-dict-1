{
  "id": "28113_iku",
  "headword": "{逝|い}く",
  "reading": "いく",
  "romaji": "iku",
  "part_of_speech": "verb (godan)",
  "gloss": "to pass away; to die",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to pass away; to die",
      "explanation": "A softer, more literary way of saying that someone has died. Often carries a tone of quiet acceptance or respect. Also read {逝|ゆ}く."
    }
  ],
  "examples": [
    {
      "id": "28113_iku_ex1",
      "japanese": "{祖父|そふ}が{逝|い}った。",
      "english": "My grandfather passed away.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "28113_iku_ex2",
      "japanese": "{彼|かれ}は{眠|ねむ}るように{逝|い}った。",
      "english": "He passed away as if falling asleep.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "28113_iku_ex3",
      "japanese": "{長|なが}い{闘病|とうびょう}の{末|すえ}、{父|ちち}は{家族|かぞく}に{見守|みまも}られて{逝|い}った。",
      "english": "After a long fight with illness, my father passed away surrounded by family.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "{逝|い}く is an intransitive verb, a euphemistic and literary alternative to {死|し}ぬ (to die). It softens the bluntness of death and is typically used for people one respects or feels close to. Also read {逝|ゆ}く.\n\nUSAGE:\n- It carries emotional or literary weight and is not used for plain, neutral statements the way {死|し}ぬ is.\n- The kanji {逝|い}く is distinct from {行|い}く (to go), though pronounced the same; the て-form is likewise {逝|い}って.\n\nSIMILAR WORDS:\n- {死|し}ぬ: to die — direct and neutral\n- {亡|な}くなる: to pass away — the standard polite euphemism",
  "schema_version": "2.0",
