{
  "id": "28436_kaku",
  "headword": "{描|か}く",
  "reading": "かく",
  "romaji": "kaku",
  "part_of_speech": "verb (godan)",
  "gloss": "to draw; to paint; to depict",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to draw; to paint",
      "explanation": "To produce a picture or image with lines, brushes, or a pen. The everyday reading of {描|か}く; the kanji is the same as {描|えが}く, but かく is more colloquial and used for concrete acts of drawing."
    }
  ],
  "examples": [
    {
      "id": "28436_kaku_ex1",
      "japanese": "{絵|え}を{描|か}く。",
      "english": "Draw a picture.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "28436_kaku_ex2",
      "japanese": "{子供|こども}が{画用紙|がようし}に{家|いえ}を{描|か}いた。",
      "english": "The child drew a house on the drawing paper.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "28436_kaku_ex3",
      "japanese": "{鏡|かがみ}を{見|み}ながら{丁寧|ていねい}に{眉|まゆ}を{描|か}いた。",
      "english": "Looking in the mirror, I carefully drew on my eyebrows.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
