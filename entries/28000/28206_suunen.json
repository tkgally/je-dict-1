  "definitions": [
    {
      "sense_number": 1,
      "gloss": "several years; a few years",
      "explanation": "An unspecified span of a few years, typically two to five or so. The prefix {数|すう} means 'several' or 'a number of'."
    }
  ],
  "examples": [
    {
      "id": "28206_suunen_ex1",
      "japanese": "{数年|すうねん}{前|まえ}に{引|ひ}っ{越|こ}した。",
      "english": "I moved several years ago.",
