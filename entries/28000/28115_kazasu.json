{
  "id": "28115_kazasu",
  "headword": "かざす",
  "reading": "かざす",
  "romaji": "kazasu",
  "part_of_speech": "verb (godan)",
  "gloss": "to hold up; to hold out; to wave (over a reader)",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to hold up; to hold out over something",
      "explanation": "To hold something up or out, especially over or toward something — over a fire for warmth, over one's eyes to shield them, or over a card reader. Now commonly used for tapping an IC card to a reader."
    }
  ],
  "examples": [
    {
      "id": "28115_kazasu_ex1",
      "japanese": "{手|て}を{火|ひ}にかざす。",
      "english": "I hold my hands over the fire.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "28115_kazasu_ex2",
      "japanese": "ICカードをかざして{改札|かいさつ}を{通|とお}る。",
      "english": "I tap my IC card and go through the ticket gate.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "28115_kazasu_ex3",
      "japanese": "{日差|ひざ}しが{強|つよ}いので、{手|て}を{額|ひたい}にかざして{遠|とお}くを{見|み}た。",
      "english": "The sun was strong, so I held my hand to my forehead and looked into the distance.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "かざす is a transitive verb meaning to hold something up or out, typically over or toward something. The thing held is marked with を and the target with に.\n\nCOMMON COLLOCATIONS:\n- {手|て}をかざす: to hold up one's hand (over a fire, eyes, etc.)\n- カードをかざす: to tap/hold up a card (to a reader)\n- {傘|かさ}をかざす: to hold an umbrella up over someone\n\nUSAGE:\nWith IC cards and smartphones, かざす is the standard verb for the touch-and-go gesture at ticket gates and payment terminals.",
