  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to get excited; to be worked up; to be on edge",
      "explanation": "Of emotions or nerves, to become heightened or aroused, often in a way that is hard to calm. Also written {昂|たか}ぶる."
    }
  ],
  "examples": [
