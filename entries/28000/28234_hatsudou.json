{
  "id": "28234_hatsudou",
  "headword": "{発動|はつどう}",
  "reading": "はつどう",
  "romaji": "hatsudou",
  "part_of_speech": "noun, suru verb",
  "gloss": "activation; invoking; putting into effect",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "activation; invocation; bringing (a power or rule) into effect",
      "explanation": "Setting a power, authority, right, or special rule into operation. Used for invoking legal powers and emergency measures, and in games for triggering an effect or skill. Used with する as a verb."
    }
  ],
  "examples": [
    {
      "id": "28234_hatsudou_ex1",
      "japanese": "{特別|とくべつ}な{権限|けんげん}が{発動|はつどう}された。",
      "english": "A special authority was invoked.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "28234_hatsudou_ex2",
      "japanese": "{政府|せいふ}は{緊急|きんきゅう}{措置|そち}を{発動|はつどう}した。",
      "english": "The government put emergency measures into effect.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "28234_hatsudou_ex3",
      "japanese": "{一定|いってい}の{条件|じょうけん}を{満|み}たすと、カードの{効果|こうか}が{発動|はつどう}する。",
      "english": "When certain conditions are met, the card's effect is triggered.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "Used as a noun or with する ({発動|はつどう}する). Frequently appears in legal, political, and gaming contexts.\n\nCOMMON COLLOCATIONS:\n- {権利|けんり}を{発動|はつどう}する: to exercise a right\n- {効果|こうか}が{発動|はつどう}する: an effect activates\n- {制裁|せいさい}を{発動|はつどう}する: to impose sanctions",
