{
  "id": "28313_daiyaru",
  "headword": "ダイヤル",
  "reading": "だいやる",
  "romaji": "daiyaru",
  "part_of_speech": "noun, suru verb",
  "gloss": "dial; rotary control",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "dial; rotary control",
      "explanation": "A circular control that is rotated to make a selection — historically on telephones, and still on radios, safes, ovens, and other equipment. Also used as a verb (suru) for dialing a phone number."
    }
  ],
  "examples": [
    {
      "id": "28313_daiyaru_ex1",
      "japanese": "ダイヤルを{回|まわ}した。",
      "english": "I turned the dial.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "28313_daiyaru_ex2",
      "japanese": "{番号|ばんごう}をダイヤルしてください。",
      "english": "Please dial the number.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "28313_daiyaru_ex3",
      "japanese": "{昔|むかし}の{電話|でんわ}はダイヤルを{回|まわ}して{電話|でんわ}をかけた。",
      "english": "Old telephones were used by turning the dial to make calls.",
      "sense_numbers": [
