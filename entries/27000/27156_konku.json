  "gloss": "hardship; privation; suffering",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "hardship; privation; suffering",
      "explanation": "Severe difficulty, distress, or suffering, especially over a prolonged period. A literary and formal word emphasizing endurance through difficult circumstances."
    }
  ],
  "examples": [
