  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to catch; to capture; to seize",
      "explanation": "To catch and hold a person or an animal, such as a criminal or prey."
    }
  ],
  "examples": [
    {
      "id": "31761_toraeru_ex1",
