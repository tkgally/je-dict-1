      "sense_number": 1,
      "gloss": "return; coming back home; repatriation",
      "explanation": "Coming back from a distant or dangerous place, such as space, a battlefield or an expedition."
    }
  ],
  "examples": [
    {
      "id": "31750_kikan_ex1",
