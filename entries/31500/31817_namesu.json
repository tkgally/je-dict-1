  "gloss": "to tan (leather)",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to tan (leather or hides)",
      "explanation": "To process an animal skin with tannin or chemicals so that it becomes soft, durable leather. Usually written in kana."
    }
  ],
  "examples": [
    {
      "id": "31817_namesu_ex1",
      "japanese": "⟦{牛|うし}→牛：01857_ushi⟧⟦の→の：09472_no⟧⟦{皮|かわ}→皮：02187_kawa⟧⟦を→を：00422_wo⟧なめす。",
      "english": "To tan cowhide.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "31817_namesu_ex2",
      "japanese": "なめした⟦{革|かわ}→革：19310_kawa⟧⟦で→で：00502_de⟧⟦{財布|さいふ}→財布：00663_saifu⟧⟦を→を：00422_wo⟧⟦{作|つく}る→作る：00481_tsukuru⟧。",
      "english": "To make a wallet from tanned leather.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "31817_namesu_ex3",
      "japanese": "⟦この→この：00962_kono⟧⟦{工房|こうぼう}→工房：12418_koubou⟧⟦で→で：00502_de⟧⟦は→は：00079_ha⟧、⟦{植物|しょくぶつ}→植物：03248_shokubutsu⟧⟦の→の：09472_no⟧{渋|しぶ}⟦を→を：00422_wo⟧⟦{使|つか}って→使う：00473_tsukau⟧⟦{時間|じかん}→時間：00468_jikan⟧⟦を→を：00422_wo⟧かけて⟦{革|かわ}→革：19310_kawa⟧⟦を→を：00422_wo⟧なめして⟦いる→いる：00495_iru⟧。",
      "english": "At this workshop they take their time tanning leather with plant tannins.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
