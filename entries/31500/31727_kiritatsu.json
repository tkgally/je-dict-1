  "part_of_speech": "verb (godan)",
  "gloss": "to rise steeply; to be sheer (of a cliff)",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to rise steeply; to be sheer",
      "explanation": "Of a cliff, rock face or mountain: to rise almost vertically, as if cut with a blade."
    }
  ],
  "examples": [
