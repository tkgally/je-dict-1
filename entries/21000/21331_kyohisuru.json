{
  "id": "21331_kyohisuru",
  "headword": "{拒否|きょひ}する",
  "reading": "きょひする",
  "part_of_speech": "noun, suru verb (transitive)",
  "gloss": "to refuse; to reject; to deny",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to refuse; to reject; to deny; to turn down",
      "explanation": "To firmly decline a request, demand, or offer. Stronger and more formal than {断|ことわ}る."
    }
  ],
  "examples": [
    {
      "id": "21331_kyohisuru_ex1",
      "japanese": "{入国|にゅうこく}を{拒否|きょひ}された。",
      "english": "I was denied entry into the country.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "21331_kyohisuru_ex2",
      "japanese": "{彼|かれ}は{取材|しゅざい}を{拒否|きょひ}した。",
      "english": "He refused the interview.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "21331_kyohisuru_ex3",
      "japanese": "{会社|かいしゃ}は{労働|ろうどう}{組合|くみあい}の{要求|ようきゅう}を{拒否|きょひ}する{姿勢|しせい}を{崩|くず}さなかった。",
      "english": "The company maintained its stance of refusing the labor union's demands.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "Compound of {拒|きょ} (refuse) + {否|ひ} (deny). A strong, formal word for refusal. Implies a firm, definitive rejection rather than a polite decline.\n\nCOMMON COLLOCATIONS:\n- {拒否|きょひ}{反応|はんのう}: rejection reaction (medical)\n- {拒否|きょひ}{権|けん}: right to refuse; veto\n- {着信|ちゃくしん}{拒否|きょひ}: call blocking\n- {受|う}け{取|と}り{拒否|きょひ}: refusal to accept delivery\n- {入国|にゅうこく}{拒否|きょひ}: denial of entry\n\nSIMILAR WORDS:\n- {断|ことわ}る: to decline, to turn down (everyday, can be polite)\n- {却下|きゃっか}する: to reject (official decisions — applications, proposals)\n- {否認|ひにん}する: to deny (facts, allegations — legal contexts)",
  "schema_version": "2.0",
