  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to divide; to split; to partition",
      "explanation": "To separate something into two or more parts or sections, often in a planned or systematic way."
    }
  ],
  "conjugation_class": "suru verb",
  "transitivity": "transitive",
  "examples": [
