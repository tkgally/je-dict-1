{
  "id": "21027_hasshasuru",
  "headword": "{発射|はっしゃ}する",
  "reading": "はっしゃする",
  "romaji": "hasshasuru",
  "part_of_speech": "noun, suru verb, transitive",
  "gloss": "to fire; to launch; to shoot",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to fire; to shoot; to discharge",
      "explanation": "To fire a weapon such as a gun, cannon, or bow."
    },
    {
      "sense_number": 2,
      "gloss": "to launch; to blast off",
      "explanation": "To launch a rocket, missile, or similar projectile into the air."
    }
  ],
  "examples": [
