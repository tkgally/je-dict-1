{
  "id": "21330_kaifukusuru",
  "headword": "{回復|かいふく}する",
  "reading": "かいふくする",
  "part_of_speech": "noun, suru verb (transitive/intransitive)",
  "gloss": "to recover; to regain; to restore",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to recover; to get better (health, economy, condition)",
      "explanation": "To return to a normal or good state after illness, decline, or damage. Often intransitive."
    },
    {
      "sense_number": 2,
      "gloss": "to regain; to restore (something lost)",
      "explanation": "To get back something that was lost, such as trust, reputation, or strength. Transitive usage."
    }
  ],
  "examples": [
