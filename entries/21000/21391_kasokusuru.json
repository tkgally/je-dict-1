{
  "id": "21391_kasokusuru",
  "headword": "{加速|かそく}する",
  "reading": "かそくする",
  "romaji": "kasokusuru",
  "part_of_speech": "suru verb",
  "gloss": "to accelerate; to speed up",
  "conjugation_class": "suru",
  "transitivity": "both",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to accelerate; to speed up; to gain momentum",
      "explanation": "To increase speed or rate, either physically (a vehicle, movement) or figuratively (a process, trend, change)."
    }
  ],
  "examples": [
    {
      "id": "21391_kasokusuru_ex1",
      "japanese": "{車|くるま}が{加速|かそく}した。",
      "english": "The car accelerated.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
