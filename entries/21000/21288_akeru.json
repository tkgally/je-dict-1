  "romaji": "akeru",
  "part_of_speech": "verb (ichidan)",
  "gloss": "to dawn; to end (a period)",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to dawn; to break (day)",
      "explanation": "Used when night ends and day begins. The subject is typically {夜|よる} (night), {朝|あさ} (morning), or {空|そら} (sky)."
    },
    {
      "sense_number": 2,
      "gloss": "to end; to be over (a period or season)",
      "explanation": "Used when a defined period such as the rainy season, mourning, or a year comes to an end."
    }
  ],
  "examples": [
