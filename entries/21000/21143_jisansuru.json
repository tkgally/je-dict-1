{
  "id": "21143_jisansuru",
  "headword": "{持参|じさん}する",
  "reading": "じさんする",
  "romaji": "jisansuru",
  "part_of_speech": "suru verb",
  "gloss": "to bring; to carry with oneself",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to bring; to carry with oneself; to take along",
      "explanation": "To bring something along when going somewhere. More formal than {持|も}っていく."
    }
  ],
  "conjugation_class": "suru verb",
  "transitivity": "transitive",
  "examples": [
    {
      "id": "21143_jisansuru_ex1",
      "japanese": "{昼食|ちゅうしょく}を{持参|じさん}する。",
      "english": "To bring one's own lunch.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "21143_jisansuru_ex2",
      "japanese": "{身分証明書|みぶんしょうめいしょ}をご{持参|じさん}ください。",
      "english": "Please bring your identification.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "21143_jisansuru_ex3",
      "japanese": "{参加者|さんかしゃ}は{各自|かくじ}で{飲|の}み{物|もの}を{持参|じさん}することになっている。",
      "english": "Participants are expected to bring their own drinks.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "A formal way to say \"bring\" or \"carry with oneself.\" Commonly seen in official notices, event instructions, and business communications. In everyday speech, {持|も}っていく or {持|も}ってくる are more natural.\n\nCOMMON COLLOCATIONS:\n- {弁当|べんとう}{持参|じさん}: bringing one's own lunch (BYOL)\n- ご{持参|じさん}ください: please bring (polite)\n- {各自|かくじ}{持参|じさん}: each person bringing their own\n\nSIMILAR WORDS:\n- {持|も}っていく: to take (something) along — everyday equivalent\n- {持|も}ってくる: to bring (something) here — everyday, direction toward speaker\n- {携帯|けいたい}する: to carry on one's person — more formal, implies keeping something readily accessible",
  "schema_version": "2.0",
