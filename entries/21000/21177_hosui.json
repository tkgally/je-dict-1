      ]
    },
    {
      "id": "21177_hosui_ex2",
      "japanese": "{運動|うんどう}{中|ちゅう}の{補水|ほすい}は{大切|たいせつ}だ。",
      "english": "Rehydrating during exercise is important.",
      "notes": null,
