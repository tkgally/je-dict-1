      "sense_numbers": [
        1
      ]
    },
    {
      "id": "21177_hosui_ex3",
      "japanese": "{熱中症|ねっちゅうしょう}を{防|ふせ}ぐために{早|はや}めの{補水|ほすい}を{心|こころ}がけましょう。",
