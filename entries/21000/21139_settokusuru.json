{
  "id": "21139_settokusuru",
  "headword": "{説得|せっとく}する",
  "reading": "せっとくする",
  "romaji": "settokusuru",
  "part_of_speech": "suru verb",
  "gloss": "to persuade; to convince",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to persuade; to convince; to talk someone into",
      "explanation": "To use reasoning or argument to bring someone around to a particular viewpoint or course of action."
    }
  ],
  "conjugation_class": "suru verb",
  "transitivity": "transitive",
  "examples": [
    {
      "id": "21139_settokusuru_ex1",
      "japanese": "{彼|かれ}を{説得|せっとく}した。",
      "english": "I persuaded him.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "21139_settokusuru_ex2",
      "japanese": "{親|おや}を{説得|せっとく}するのに{苦労|くろう}した。",
      "english": "I had a hard time persuading my parents.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "21139_settokusuru_ex3",
      "japanese": "{何度|なんど}も{説得|せっとく}したが、{彼女|かのじょ}は{考|かんが}えを{変|か}えなかった。",
      "english": "I tried to persuade her many times, but she wouldn't change her mind.",
      "sense_numbers": [
        1
