      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "26941_nukarumu_ex3",
      "japanese": "{長雨|ながあめ}が{続|つづ}いて{田|た}んぼの{周|まわ}りの{道|みち}がひどくぬかるんでしまった。",
