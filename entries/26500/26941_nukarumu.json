  "part_of_speech": "verb (godan)",
  "gloss": "to become muddy; to turn into a quagmire",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to become muddy; to turn into a quagmire",
      "explanation": "Describes the ground becoming soft and muddy, typically from rain or water saturation. The ground loses firmness and becomes difficult to walk on."
    }
  ],
  "examples": [
