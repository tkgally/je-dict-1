{
  "id": "26971_keizokusuru",
  "headword": "{継続|けいぞく}する",
  "reading": "けいぞくする",
  "romaji": "keizokusuru",
  "part_of_speech": "noun, suru verb",
  "gloss": "to continue; to persist; to carry on",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to continue; to persist; to carry on; to maintain",
      "explanation": "To keep doing something or to maintain a state without interruption. Often used in formal or written contexts for sustained activities, policies, or conditions."
    }
  ],
  "examples": [
    {
      "id": "26971_keizokusuru_ex1",
      "japanese": "{努力|どりょく}を{継続|けいぞく}する。",
      "english": "To continue one's efforts.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "26971_keizokusuru_ex2",
