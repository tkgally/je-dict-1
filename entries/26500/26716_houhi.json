  "definitions": [
    {
      "sense_number": 1,
      "gloss": "flatulence; passing gas; breaking wind",
      "explanation": "The act of releasing intestinal gas. A formal or medical term for what is colloquially called おなら."
    }
  ],
  "examples": [
    {
      "id": "26716_houhi_ex1",
      "japanese": "{放屁|ほうひ}は{自然|しぜん}な{生理現象|せいりげんしょう}です。",
      "english": "Flatulence is a natural physiological phenomenon.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "26716_houhi_ex2",
      "japanese": "{手術|しゅじゅつ}{後|ご}、{放屁|ほうひ}があれば{腸|ちょう}が{動|うご}いている{証拠|しょうこ}だ。",
      "english": "After surgery, flatulence is evidence that the intestines are functioning.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "26716_houhi_ex3",
      "japanese": "{頻繁|ひんぱん}な{放屁|ほうひ}の{原因|げんいん}として、{食事|しょくじ}の{内容|ないよう}やストレスが{考|かんが}えられる。",
      "english": "Diet and stress are considered possible causes of frequent flatulence.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
