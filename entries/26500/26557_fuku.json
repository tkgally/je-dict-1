{
  "id": "26557_fuku",
  "headword": "{噴|ふ}く",
  "reading": "ふく",
  "romaji": "fuku",
  "part_of_speech": "verb",
  "gloss": "to spout; to gush; to erupt",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to spout; to gush; to spray",
      "explanation": "For liquid, steam, or gas to burst out forcefully from an opening or source."
    },
    {
      "sense_number": 2,
      "gloss": "to erupt; to spew",
      "explanation": "For a volcano to discharge lava, ash, or gas. Also used figuratively for emotions or situations that burst out uncontrollably."
    }
  ],
  "examples": [
