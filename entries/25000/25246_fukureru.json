{
  "id": "25246_fukureru",
  "headword": "{膨|ふく}れる",
  "reading": "ふくれる",
  "romaji": "fukureru",
  "part_of_speech": "verb (ichidan)",
  "gloss": "to swell; to expand; to puff up",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to swell; to expand; to puff up",
      "explanation": "to increase in size or volume by filling with air, gas, or liquid; to become bloated or distended"
    },
    {
      "sense_number": 2,
      "gloss": "to pout; to sulk",
      "explanation": "to show displeasure or annoyance by puffing out the cheeks or becoming silent and moody"
    }
  ],
  "examples": [
