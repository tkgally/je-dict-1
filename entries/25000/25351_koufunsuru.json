{
  "id": "25351_koufunsuru",
  "headword": "{興奮|こうふん}する",
  "reading": "こうふんする",
  "romaji": "koufunsuru",
  "part_of_speech": "noun, suru verb",
  "gloss": "to get excited; to be agitated; to be aroused",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to get excited; to be thrilled",
      "explanation": "To become emotionally stimulated or worked up, often with enthusiasm or anticipation."
    },
    {
      "sense_number": 2,
      "gloss": "to be agitated; to be upset",
      "explanation": "To become emotionally overwrought, angry, or worked up in a negative sense."
    }
  ],
  "examples": [
    {
      "id": "25351_koufunsuru_ex1",
      "japanese": "{試合|しあい}に{興奮|こうふん}した。",
      "english": "I got excited about the game.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "25351_koufunsuru_ex2",
      "japanese": "{子|こ}どもたちは{遠足|えんそく}の{前|まえ}の{日|ひ}に{興奮|こうふん}していた。",
      "english": "The children were excited the day before the field trip.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "25351_koufunsuru_ex3",
      "japanese": "{初|はじ}めてのコンサートで{観客|かんきゃく}は{興奮|こうふん}して{立|た}ち{上|あ}がった。",
      "english": "At their first concert, the audience got excited and stood up.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "25351_koufunsuru_ex4",
      "japanese": "そんなに{興奮|こうふん}しないで。",
      "english": "Don't get so worked up.",
