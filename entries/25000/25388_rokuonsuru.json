  "gloss": "to record (audio); to make a recording",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to record (audio); to make a recording",
      "explanation": "To capture sound onto a medium for later playback. Applies to recording music, voice, conversations, or any audio."
    }
  ],
  "examples": [
