      "sense_number": 1,
      "gloss": "caress; tender stroking; fondling",
      "explanation": "The act of touching or stroking someone gently and lovingly."
    }
  ],
  "examples": [
    {
      "id": "25199_aibu_ex1",
      "japanese": "{母|はは}は{子|こ}どもを{愛撫|あいぶ}した。",
      "english": "The mother caressed her child.",
      "has_audio": false,
