  "definitions": [
    {
      "sense_number": 1,
      "gloss": "protection; kind treatment; caring for",
      "explanation": "Treating something with care and protecting it from harm. Most commonly used in the context of animal welfare and nature conservation, but can also apply to people or cultural properties."
    }
