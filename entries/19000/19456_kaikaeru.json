  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to replace (by buying a new one), to buy a replacement",
      "explanation": "To purchase something new to replace an old or broken item. Implies discarding the old and obtaining a new version."
    }
  ],
  "examples": [
