  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to fascinate, to charm, to captivate, to enchant",
      "explanation": "To attract and hold someone's attention or admiration powerfully. Used for performances, beauty, personalities, or anything that deeply impresses."
    }
  ],
  "examples": [
