  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to peel off; to come off; to flake off",
      "explanation": "For skin, bark, paint, or a surface layer to come off naturally or due to damage. An intransitive verb — the peeling happens on its own."
    }
  ],
