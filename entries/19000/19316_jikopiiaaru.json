  "definitions": [
    {
      "sense_number": 1,
      "gloss": "self-promotion; self-introduction; personal pitch",
      "explanation": "Presenting one's own strengths, skills, and qualities, especially in job interviews, resumes, or academic applications. A standard part of the Japanese job-hunting process."
