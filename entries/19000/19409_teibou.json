  "definitions": [
    {
      "sense_number": 1,
      "gloss": "embankment; levee; dike",
      "explanation": "An artificial wall or bank, typically of earth or concrete, built along a river or coast to prevent flooding."
    }
  ],
  "examples": [
    {
      "id": "19409_teibou_ex1",
