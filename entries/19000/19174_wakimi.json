  "definitions": [
    {
      "sense_number": 1,
      "gloss": "looking away; looking to the side; being distracted",
      "explanation": "The act of looking away from what one should be paying attention to. Most commonly used in the context of driving, where it means taking one's eyes off the road."
    }
