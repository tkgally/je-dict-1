  "definitions": [
    {
      "sense_number": 1,
      "gloss": "acceptance; resignation; submitting to",
      "explanation": "Accepting something unpleasant or difficult without resistance. Implies willingly or resignedly enduring hardship, punishment, or unfavorable circumstances."
    }
  ],
  "examples": [
