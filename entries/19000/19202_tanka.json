  "definitions": [
    {
      "sense_number": 1,
      "gloss": "carbonization; charring; turning to carbon",
      "explanation": "The process of converting organic material into carbon or charcoal through heating, or the state of something having been charred. Used in chemistry, cooking, and fire investigation."
