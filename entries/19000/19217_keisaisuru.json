    {
      "sense_number": 1,
      "gloss": "to publish; to post; to carry (an article)",
      "explanation": "To print or display content in a newspaper, magazine, website, or other media. Used for articles, advertisements, photos, and other published material."
    }
  ],
  "examples": [
    {
      "id": "19217_keisaisuru_ex1",
      "japanese": "{記事|きじ}を{掲載|けいさい}する。",
      "english": "To publish an article.",
