  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to cure; to heal; to remedy",
      "explanation": "To restore someone to health by treating a disease or injury. The subject is the person or thing doing the healing (a doctor, medicine, etc.)."
    }
  ],
  "examples": [
    {
      "id": "19371_naosu_ex1",
      "japanese": "{医者|いしゃ}が{病気|びょうき}を{治|なお}した。",
      "english": "The doctor cured the illness.",
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "19371_naosu_ex2",
      "japanese": "この{薬|くすり}で{風邪|かぜ}を{治|なお}すことができる。",
      "english": "You can cure a cold with this medicine.",
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "19371_naosu_ex3",
