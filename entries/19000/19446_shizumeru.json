  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to calm, to quiet, to pacify",
      "explanation": "To make something that is agitated, noisy, or turbulent become calm and quiet. Used for emotions, noise, or disturbances."
    },
    {
      "sense_number": 2,
      "gloss": "to suppress, to subdue, to put down",
      "explanation": "To bring something under control by force or authority, such as a rebellion or unrest."
    }
  ],
