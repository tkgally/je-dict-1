  "definitions": [
    {
      "sense_number": 1,
      "gloss": "formation; lineup; strategic deployment",
      "explanation": "The arrangement of troops, players, or personnel in strategic positions. Originally a military term, now commonly used in sports, business, and politics to describe how people or resources are positioned."
    }
  ],
  "examples": [
