  "definitions": [
    {
      "sense_number": 1,
      "gloss": "autopsy; postmortem examination; coroner's inquest",
      "explanation": "The examination of a dead body to determine the cause and manner of death. Includes both external examination by police/prosecutors and internal examination (autopsy) by a medical examiner."
    }
  ],
  "examples": [
