{
  "id": "19236_hakkousuru",
  "headword": "{発行|はっこう}する",
  "reading": "はっこうする",
  "romaji": "hakkousuru",
  "part_of_speech": "verb (suru)",
  "gloss": "to issue; to publish; to release",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to issue; to publish; to release officially",
      "explanation": "To officially produce and distribute documents, cards, certificates, books, newspapers, stamps, or currency. Used for both physical and digital issuance."
    }
  ],
  "examples": [
    {
      "id": "19236_hakkousuru_ex1",
      "japanese": "パスポートを{発行|はっこう}する。",
      "english": "To issue a passport.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "19236_hakkousuru_ex2",
      "japanese": "{新|あたら}しいクレジットカードが{発行|はっこう}された。",
      "english": "A new credit card was issued.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "19236_hakkousuru_ex3",
      "japanese": "この{雑誌|ざっし}は{毎月|まいつき}{一日|ついたち}に{発行|はっこう}されている。",
      "english": "This magazine is published on the first of every month.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    }
  ],
  "notes": "Composed of {発|はつ} (emit/send out) + {行|こう} (go/carry out). Common collocations: パスポートを{発行|はっこう}する (to issue a passport), {証明書|しょうめいしょ}を{発行|はっこう}する (to issue a certificate), {株|かぶ}を{発行|はっこう}する (to issue shares). The noun form {発行|はっこう} is also common: {発行日|はっこうび} (date of issue), {発行部数|はっこうぶすう} (circulation/number of copies issued), {発行元|はっこうもと} (issuer/publisher).",
