  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to take at face value, to take seriously, to believe literally",
      "explanation": "To accept what someone says as true without questioning or considering that it might be a joke, exaggeration, or sarcasm. Often used as a warning or in a negative context."
    }
  ],
  "examples": [
    {
      "id": "19010_maniukeru_ex1",
