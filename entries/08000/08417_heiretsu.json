  "definitions": [
    {
      "sense_number": 1,
      "gloss": "parallel; side by side",
      "explanation": "arranged or occurring alongside each other, not in sequence"
    },
    {
      "sense_number": 2,
      "gloss": "parallel (electrical/computing)",
      "explanation": "a circuit or process where components are connected side by side or operations happen simultaneously"
    }
  ],
