    },
    {
      "id": "08183_wabishii_ex3",
      "japanese": "{古|ふる}い{旅館|りょかん}に{一人|ひとり}で{泊|と}まると{侘|わび}しい{気持|きも}ちになる。",
      "english": "Staying alone at an old inn makes me feel forlorn.",
