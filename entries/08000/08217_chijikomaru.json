  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to huddle up; to curl up (from cold)",
      "explanation": "to make oneself small, typically from cold"
    },
    {
      "sense_number": 2,
      "gloss": "to shrink; to cower",
      "explanation": "to become smaller from fear or nervousness"
    }
  ],
