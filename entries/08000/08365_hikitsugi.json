      "gloss": "handover; succession; taking over duties",
      "explanation": "the process of transferring responsibilities, work, or duties from one person to another"
    }
  ],
  "examples": [
    {
      "id": "08365_hikitsugi_ex1",
      "japanese": "{引|ひ}き{継|つ}ぎ{資料|しりょう}を{作成|さくせい}する。",
      "english": "I'll prepare the handover documents.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "08365_hikitsugi_ex2",
      "japanese": "{前任者|ぜんにんしゃ}からの{引|ひ}き{継|つ}ぎが{不十分|ふじゅうぶん}だった。",
      "english": "The handover from my predecessor was insufficient.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "08365_hikitsugi_ex3",
      "japanese": "{退職|たいしょく}{前|まえ}に{引|ひ}き{継|つ}ぎを{完了|かんりょう}させなければならない。",
      "english": "I need to complete the handover before I leave the company.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
