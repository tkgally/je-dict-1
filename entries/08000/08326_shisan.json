  "definitions": [
    {
      "sense_number": 1,
      "gloss": "trial calculation; preliminary estimate; tentative computation",
      "explanation": "a preliminary calculation made to check or estimate figures before making a final determination; often used in business and financial planning"
    }
  ],
  "examples": [
