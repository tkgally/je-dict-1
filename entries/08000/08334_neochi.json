  "definitions": [
    {
      "sense_number": 1,
      "gloss": "falling asleep unintentionally; dozing off while doing something",
      "explanation": "the act of falling asleep without meaning to, often while using a phone, watching TV, or chatting online"
    }
  ],
  "examples": [
