  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to drown out (sound); to overwhelm",
      "explanation": "to make a sound inaudible by producing a louder sound"
    },
    {
      "sense_number": 2,
      "gloss": "to vanish; to disappear (as if erased)",
      "explanation": "to disappear suddenly and completely, as if wiped away"
    }
  ],
  "examples": [
    {
