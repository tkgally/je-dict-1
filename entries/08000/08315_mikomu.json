  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to expect; to anticipate; to forecast",
      "explanation": "to predict or expect something to happen or be the case based on available information"
    },
    {
      "sense_number": 2,
      "gloss": "to see potential in; to have high hopes for",
      "explanation": "to recognize someone's potential or ability and expect great things from them"
    }
  ],
  "examples": [
    {
