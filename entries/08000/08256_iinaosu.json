  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to rephrase; to say again; to correct oneself",
      "explanation": "to say something again in different words, or to correct what one has said"
    }
  ],
  "examples": [
    {
      "id": "08256_iinaosu_ex1",
      "japanese": "{言|い}い{間違|まちが}えたので{言|い}い{直|なお}した。",
      "english": "I misspoke so I corrected myself.",
