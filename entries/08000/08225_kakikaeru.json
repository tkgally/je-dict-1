  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to rewrite; to write over again",
      "explanation": "to write something again, replacing the original content"
    },
    {
      "sense_number": 2,
      "gloss": "to renew; to update (documents, records)",
      "explanation": "to issue a new version of an official document"
    }
  ],
