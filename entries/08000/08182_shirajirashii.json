  "part_of_speech": "i-adjective",
  "gloss": "feigned; unconvincing; blatant",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "feigned; unconvincing; obviously fake",
      "explanation": "describes behavior or words that are clearly pretended or insincere"
    }
  ],
  "examples": [
    {
