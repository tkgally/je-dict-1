  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be shy; to be embarrassed; to feel awkward",
      "explanation": "to feel self-conscious or bashful, typically when receiving praise or attention"
    }
  ],
  "examples": [
    {
      "id": "08152_tereru_ex1",
      "japanese": "{褒|ほ}められて{照|て}れた。",
      "english": "I was embarrassed when they praised me.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "08152_tereru_ex2",
      "japanese": "{彼|かれ}は{照|て}れながら{返事|へんじ}をした。",
