  "part_of_speech": "i-adjective",
  "gloss": "steep; rugged; harsh",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "steep; precipitous",
      "explanation": "having a sharp incline; difficult to climb or traverse"
