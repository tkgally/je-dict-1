  "definitions": [
    {
      "sense_number": 1,
      "gloss": "summary, overall review, wrap-up, summing up",
      "explanation": "A comprehensive summary or review that brings together the key points of a discussion, project, or period. Often done at the end of a meeting, event, or fiscal period."
