  "definitions": [
    {
      "sense_number": 1,
      "gloss": "payment, delivery, remittance",
      "explanation": "The act of paying or delivering money that is owed, typically taxes, fees, insurance premiums, or other official obligations. More formal than 支払い and used specifically for payments to government or institutional bodies."
