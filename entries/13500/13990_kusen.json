  "definitions": [
    {
      "sense_number": 1,
      "gloss": "hard fight, tough struggle, uphill battle",
      "explanation": "A difficult struggle where one is at a disadvantage or facing strong opposition. Used both for literal battles and figuratively for any challenging situation such as business competition, elections, or sports matches."
    }
  ],
