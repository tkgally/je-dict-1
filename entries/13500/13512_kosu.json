  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to strain, to filter, to sieve",
      "explanation": "To pass a liquid or mixture through a cloth, sieve, or other filter to separate solids from liquids or to achieve a smoother texture. Common in cooking and traditional crafts."
    }
  ],
