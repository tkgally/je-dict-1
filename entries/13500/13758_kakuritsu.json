  "definitions": [
    {
      "sense_number": 1,
      "gloss": "establishment, firm founding",
      "explanation": "The act of firmly establishing something — such as a system, method, position, or identity — so that it is solid and reliable. Emphasizes the firmness and permanence of what is established."
    }
  ],
