  "definitions": [
    {
      "sense_number": 1,
      "gloss": "benefit, allowance, payment, provision",
      "explanation": "Money or services provided by the government, an insurance system, or an organization to eligible individuals. Commonly used for welfare payments, insurance benefits, and government subsidies."
    }
  ],
