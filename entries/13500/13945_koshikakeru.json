  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to sit down, to take a seat",
      "explanation": "To sit on a chair, bench, or other raised surface. Unlike 座る which covers sitting on the floor or any sitting posture, 腰掛ける specifically implies sitting on something with a seat — a chair, bench, edge, or similar surface."
    }
  ],
