  "definitions": [
    {
      "sense_number": 1,
      "gloss": "fatigue, weariness, exhaustion",
      "explanation": "Physical or mental tiredness resulting from exertion or stress. A somewhat formal or technical term compared to the everyday {疲|つか}れ. Also used in medical and material science contexts (metal fatigue, etc.)."
    }
  ],
