  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to throw on, to drape over one's shoulders, to wear loosely",
      "explanation": "To put on an outer garment casually, draping it over the shoulders without buttoning or fastening it properly. Implies a quick, informal action rather than careful dressing."
    }
  ],
  "examples": [
