  "definitions": [
    {
      "sense_number": 1,
      "gloss": "alienation, estrangement, exclusion",
      "explanation": "The state of being isolated or excluded from a group, or the act of pushing someone away. Used in both everyday and academic contexts, including sociological and philosophical discussions."
    }
  ],
