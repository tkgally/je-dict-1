  "definitions": [
    {
      "sense_number": 1,
      "gloss": "organ or tissue transplant",
      "explanation": "The surgical transfer of an organ or tissue from one body to another, or from one part of the body to another."
    },
    {
      "sense_number": 2,
      "gloss": "transplanting plants, porting software",
      "explanation": "Moving a plant from one location to another for replanting, or adapting software to run on a different platform."
    }
