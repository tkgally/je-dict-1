  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to enjoy, to amuse oneself with, to indulge in",
      "explanation": "To take pleasure in an activity and become absorbed in it. Often used with games, conversations, and leisure activities. Carries a nuance of whiling away time pleasurably."
    }
  ],
  "examples": [
