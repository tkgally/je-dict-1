  "definitions": [
    {
      "sense_number": 1,
      "gloss": "formation, organization, founding",
      "explanation": "The act of bringing people together to form a group, team, party, or organization. Emphasizes the deliberate creation of a collective body for a shared purpose."
    }
  ],
