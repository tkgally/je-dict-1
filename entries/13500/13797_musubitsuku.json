  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be connected, to be linked, to be tied together",
      "explanation": "For two or more things to be joined or associated with each other, either physically or conceptually. Often implies a meaningful or significant connection."
    }
  ],
