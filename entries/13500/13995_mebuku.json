  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to bud, to sprout, to put forth new shoots",
      "explanation": "For plants to produce new buds or sprouts, typically in spring. Also used figuratively for the beginning or emergence of something new, such as feelings, talent, or ideas."
    }
  ],
  "examples": [
    {
      "id": "13995_mebuku_ex1",
