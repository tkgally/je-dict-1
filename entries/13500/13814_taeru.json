  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to cease, to come to an end, to be cut off",
      "explanation": "For something that was continuing to stop completely. Often used for communication, sound, supply, or a continuous state being interrupted."
    },
    {
      "sense_number": 2,
      "gloss": "to die out, to become extinct, to be discontinued",
      "explanation": "For a lineage, species, tradition, or practice to completely disappear, with no continuation remaining."
    }
  ],
