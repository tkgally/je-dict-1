  "definitions": [
    {
      "sense_number": 1,
      "gloss": "migration, relocation, immigration",
      "explanation": "Moving one's residence to a different place, especially to a different country or region, with the intention of settling there permanently or for an extended period."
    }
  ],
  "examples": [
