  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to exorcise, to purify, to cleanse of evil spirits",
      "explanation": "To perform a ritual purification to drive away evil spirits, impurities, or bad luck. Primarily associated with Shinto practices and traditional Japanese beliefs."
    }
