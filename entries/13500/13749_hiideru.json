  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to excel, to surpass others, to stand out",
      "explanation": "To be superior to others in ability, skill, or quality. A literary and somewhat formal verb, often used in the form {秀|ひい}でた (excelling, outstanding) as a modifier."
    }
  ],
