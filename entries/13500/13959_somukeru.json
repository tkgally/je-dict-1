  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to turn away, to avert",
      "explanation": "To turn one's face, eyes, or body away from something, typically to avoid looking at or facing something unpleasant, embarrassing, or frightening."
    }
  ],
  "examples": [
    {
      "id": "13959_somukeru_ex1",
      "japanese": "{彼女|かのじょ}は{顔|かお}を{背|そむ}けた。",
      "english": "She turned her face away.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "13959_somukeru_ex2",
      "japanese": "{現実|げんじつ}から{目|め}を{背|そむ}けてはいけない。",
