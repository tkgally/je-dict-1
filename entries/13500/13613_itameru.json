  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to hurt; to injure (a body part)",
      "explanation": "To cause physical injury or pain to a part of the body, especially through strain or overuse."
    },
    {
      "sense_number": 2,
      "gloss": "to trouble; to worry; to agonize over",
      "explanation": "To cause mental or emotional distress. Used in the set expression 頭を痛める (to worry over something) and 心を痛める (to be pained by something)."
    }
  ],
