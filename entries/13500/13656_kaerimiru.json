  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to reflect on, to examine oneself",
      "explanation": "To look back on one's own actions, behavior, or past and think critically about them. Implies self-examination and introspection."
    }
  ],
  "examples": [
    {
      "id": "13656_kaerimiru_ex1",
      "japanese": "{自分|じぶん}の{行動|こうどう}を{省|かえり}みる。",
      "english": "To reflect on one's own behavior.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "13656_kaerimiru_ex2",
      "japanese": "{過去|かこ}を{省|かえり}みて、{同|おな}じ{失敗|しっぱい}を{繰|く}り{返|かえ}さないようにしたい。",
