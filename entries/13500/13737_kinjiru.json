  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to prohibit, to forbid, to ban",
      "explanation": "To officially or authoritatively forbid something. Used for rules, laws, and regulations."
    },
    {
      "sense_number": 2,
      "gloss": "to suppress, to hold back (an emotion)",
      "explanation": "To restrain oneself from expressing a feeling. Most commonly appears in the set phrase ...を{禁|きん}じ{得|え}ない (cannot help but feel...)."
    }
  ],
  "examples": [
