  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to pass through, to go via, to go through (a process or place)",
      "explanation": "To go through a particular route, process, stage, or intermediary on the way to a destination or result."
    },
    {
      "sense_number": 2,
      "gloss": "to elapse, to pass (of time)",
      "explanation": "For time to pass or elapse. Often used in the pattern 〜を経て (after going through, having passed through)."
    }
  ],
