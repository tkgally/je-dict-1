  "definitions": [
    {
      "sense_number": 1,
      "gloss": "meditation",
      "explanation": "The practice of calming the mind, closing one's eyes, and focusing inward. Encompasses both religious meditation (Buddhist, etc.) and modern mindfulness practices."
    }
  ],
