  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to keep secret, to hide within oneself, to harbor",
      "explanation": "To conceal something — often feelings, thoughts, or intentions — within oneself rather than expressing or revealing them. Frequently used in literary and emotional contexts."
    }
  ],
