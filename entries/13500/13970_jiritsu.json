  "definitions": [
    {
      "sense_number": 1,
      "gloss": "independence, self-reliance, standing on one's own",
      "explanation": "The state or act of becoming independent and supporting oneself, whether financially, emotionally, or practically. Often used when discussing young adults leaving home or people becoming self-sufficient."
    }
  ],
