{
  "id": "27529_kaabu",
  "headword": "カーブ",
  "reading": "かーぶ",
  "romaji": "kaabu",
  "part_of_speech": "noun, suru verb",
  "gloss": "curve; bend; (baseball) curveball",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "curve; bend",
      "explanation": "A non-straight line, or the curve of a road, river, or graph."
    },
    {
      "sense_number": 2,
      "gloss": "curveball (baseball pitch)",
      "explanation": "In baseball, a pitch thrown with spin that makes the ball curve downward and to one side."
    }
  ],
  "examples": [
    {
      "id": "27529_kaabu_ex1",
      "japanese": "{急|きゅう}なカーブが{続|つづ}く。",
      "english": "Sharp curves continue.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "27529_kaabu_ex2",
      "japanese": "{道|みち}が{大|おお}きくカーブしている。",
      "english": "The road curves widely.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "27529_kaabu_ex3",
      "japanese": "グラフのカーブを{見|み}れば、{気温|きおん}の{変化|へんか}が{一目|ひとめ}でわかる。",
      "english": "Looking at the curve on the graph, you can see the temperature change at a glance.",
