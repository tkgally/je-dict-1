  "part_of_speech": "verb (ichidan)",
  "gloss": "to study; to master; to cultivate",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to study; to master; to cultivate (learning, conduct)",
      "explanation": "To pursue a field of study to completion, or to cultivate and discipline one's skills or moral conduct. Written {修|おさ}める for the senses of learning and self-cultivation."
    }
  ],
  "examples": [
    {
      "id": "27839_osameru_ex1",
