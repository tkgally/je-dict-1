  "definitions": [
    {
      "sense_number": 1,
      "gloss": "narrator; voice-over artist",
      "explanation": "A person who provides the spoken narration for a program, film, or documentary, usually off-screen. From English 'narrator'."
    }
  ],
  "examples": [
    {
      "id": "27961_nareetaa_ex1",
