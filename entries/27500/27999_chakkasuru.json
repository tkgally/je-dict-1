  "gloss": "to ignite; to catch fire; to light",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to ignite; to catch fire; to light",
      "explanation": "To start burning, or to set something burning. Used for fires, fuel, fireworks, burners, and the like."
    }
  ],
  "examples": [
    {
      "id": "27999_chakkasuru_ex1",
      "japanese": "マッチで{薪|まき}に{着火|ちゃっか}した。",
