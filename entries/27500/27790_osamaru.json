  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to subside; to die down; to calm down",
      "explanation": "Of pain, fever, anger, bad weather, or social unrest: to grow calm and come to a quiet, stable state."
    }
  ],
  "examples": [
