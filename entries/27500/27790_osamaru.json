  "part_of_speech": "verb (godan)",
  "gloss": "to subside; to die down; to be settled",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to subside; to die down; to calm down",
      "explanation": "Of pain, fever, anger, bad weather, or social unrest: to grow calm and come to a quiet, stable state."
    }
  ],
  "examples": [
    {
      "id": "27790_osamaru_ex1",
      "japanese": "{痛|いた}みが{治|おさ}まった。",
      "english": "The pain subsided.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "27790_osamaru_ex2",
      "japanese": "{薬|くすり}を{飲|の}んだら{熱|ねつ}が{治|おさ}まった。",
      "english": "After I took the medicine, my fever went down.",
      "sense_numbers": [
        1
      ],
      "has_audio": false,
      "notes": null
    },
    {
      "id": "27790_osamaru_ex3",
