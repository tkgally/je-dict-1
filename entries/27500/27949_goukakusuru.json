  "part_of_speech": "suru verb",
  "gloss": "to pass (an exam); to qualify",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to pass (an exam, inspection); to qualify",
      "explanation": "To pass a test, examination, or inspection by meeting the required standard. Used for school and license exams, job screenings, and quality checks."
    }
  ],
  "examples": [
    {
