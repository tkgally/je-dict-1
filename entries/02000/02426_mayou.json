  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to get lost, to lose one's way",
      "explanation": "To not know where one is or how to proceed."
    },
    {
      "sense_number": 2,
      "gloss": "to be puzzled, to hesitate",
      "explanation": "To be uncertain about a decision."
    }
  ],
