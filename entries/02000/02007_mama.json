  "definitions": [
    {
      "sense_number": 1,
      "gloss": "as is, as it is",
      "explanation": "Indicates something remains in its current state."
    },
    {
      "sense_number": 2,
      "gloss": "while (in a state)",
      "explanation": "Indicates doing something while in a particular state."
    }
  ],
