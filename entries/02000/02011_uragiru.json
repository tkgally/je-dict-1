  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to betray, to turn traitor",
      "explanation": "To act disloyally to someone who trusts you."
    },
    {
      "sense_number": 2,
      "gloss": "to disappoint, to let down",
      "explanation": "To fail to meet expectations."
    }
  ],
