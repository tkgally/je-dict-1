  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to weaken, to grow weak",
      "explanation": "To lose strength."
    },
    {
      "sense_number": 2,
      "gloss": "to be troubled, to be at a loss",
      "explanation": "To not know what to do."
    }
  ],
