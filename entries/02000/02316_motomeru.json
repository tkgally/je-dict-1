  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to seek, to search for",
      "explanation": "To look for something desired."
    },
    {
      "sense_number": 2,
      "gloss": "to request, to demand",
      "explanation": "To ask for something formally."
    },
    {
      "sense_number": 3,
      "gloss": "to buy, to purchase",
      "explanation": "To obtain by paying (formal)."
    }
  ],
