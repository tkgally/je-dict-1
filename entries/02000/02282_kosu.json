  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to cross, to go over; to get through (a period or difficulty)",
      "explanation": "To pass over something like a mountain or a border. By extension, to come out the other side of a stretch of time or a hardship: {冬|ふゆ}⟦を→を：00422_wo⟧{越|こ}す (to get through the winter), {危機|きき}⟦を→を：00422_wo⟧{越|こ}す (to get past a crisis)."
    },
    {
      "sense_number": 2,
      "gloss": "to move (residence)",
      "explanation": "To relocate to a new home."
    },
    {
      "sense_number": 3,
      "gloss": "to exceed, to surpass",
      "explanation": "To go beyond a certain point or amount."
    }
  ],
