  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to accustom, to get used to",
      "explanation": "To make someone or oneself familiar with something."
    },
    {
      "sense_number": 2,
      "gloss": "to train, to break in",
      "explanation": "To prepare something for use through repeated practice."
    }
