  "headword": "{越|こ}える",
  "reading": "こえる",
  "part_of_speech": "verb (ichidan)",
  "gloss": "to cross, to exceed, to surpass",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to cross, to go over",
      "explanation": "To pass over or across something."
    },
    {
      "sense_number": 2,
      "gloss": "to exceed, to surpass",
      "explanation": "To go beyond a limit or amount."
    }
  ],
  "examples": [
