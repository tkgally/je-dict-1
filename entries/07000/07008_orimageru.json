      "sense_numbers": [
        1
      ]
    },
    {
      "id": "07008_orimageru_ex3",
      "japanese": "{針金|はりがね}を{折|お}り{曲|ま}げて{形|かたち}を{作|つく}った。",
      "english": "I bent the wire and shaped it.",
