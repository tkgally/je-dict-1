  "reading": "せんにゅうかん",
  "part_of_speech": "noun",
  "gloss": "preconception; prejudice; preconceived notion",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "preconception; preconceived notion",
      "explanation": "An opinion or idea formed beforehand without adequate evidence or experience."
    }
  ],
  "examples": [
    {
      "id": "07312_sennyuukan_ex1",
      "japanese": "{先入観|せんにゅうかん}を{捨|す}てて{話|はな}を{聞|き}こう。",
      "english": "Let's listen without preconceptions.",
      "has_audio": false,
