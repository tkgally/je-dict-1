  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to complain; to grumble; to mutter",
      "explanation": "To express dissatisfaction or displeasure in a quiet, often mumbling manner. More subdued than formal complaints."
    }
  ],
  "examples": [
