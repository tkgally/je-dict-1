  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to store up; to hoard; to accumulate; to stockpile",
      "explanation": "To collect and keep things over time, often implying saving more than necessary or keeping things that could be discarded. Can refer to physical objects, money, or abstract things like stress."
    }
  ],
