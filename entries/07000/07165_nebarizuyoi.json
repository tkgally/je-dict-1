  "definitions": [
    {
      "sense_number": 1,
      "gloss": "tenacious; persistent; persevering; dogged",
      "explanation": "Not giving up easily; continuing to try despite difficulties or opposition."
    }
  ],
  "examples": [
    {
      "id": "07165_nebarizuyoi_ex1",
      "japanese": "{粘|ねば}り{強|づよ}い{交渉|こうしょう}で{契約|けいやく}を{取|と}った。",
      "english": "We secured the contract through persistent negotiation.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "07165_nebarizuyoi_ex2",
      "japanese": "{彼|かれ}は{粘|ねば}り{強|づよ}く{練習|れんしゅう}を{続|つづ}けた。",
      "english": "He persistently continued practicing.",
      "notes": null,
