  "definitions": [
    {
      "sense_number": 1,
      "gloss": "extension cord",
      "explanation": "An electrical cord with a plug on one end and one or more outlets on the other, used to extend the reach of power sources."
    }
  ],
  "examples": [
    {
      "id": "07087_enchoukoodo_ex1",
      "japanese": "コンセントが{遠|とお}いので{延長|えんちょう}コードが{必要|ひつよう}だ。",
      "english": "The outlet is far away, so I need an extension cord.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "07087_enchoukoodo_ex2",
      "japanese": "3メートルの{延長|えんちょう}コードを{買|か}った。",
      "english": "I bought a 3-meter extension cord.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "07087_enchoukoodo_ex3",
      "japanese": "{延長|えんちょう}コードを{使|つか}いすぎると{危険|きけん}だ。",
      "english": "Using too many extension cords is dangerous.",
