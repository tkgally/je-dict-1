  "definitions": [
    {
      "sense_number": 1,
      "gloss": "decline; deterioration; decay",
      "explanation": "A gradual weakening, decreasing, or deterioration in power, prosperity, importance, or vitality. Used for civilizations, industries, health, and other things that were once stronger or more prosperous."
    }
  ],
  "examples": [
    {
