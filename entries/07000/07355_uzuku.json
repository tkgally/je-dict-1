  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to ache; to throb (physical pain)",
      "explanation": "To experience a dull, throbbing pain, typically in a localized area of the body."
    },
    {
      "sense_number": 2,
      "gloss": "to ache; to yearn (emotional)",
      "explanation": "To feel a strong emotional longing or anticipation."
    }
  ],
