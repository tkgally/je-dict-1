  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to cower; to flinch; to be daunted",
      "explanation": "To draw back or hesitate due to fear, intimidation, or lack of courage. Stronger than mere hesitation."
    }
  ],
  "examples": [
