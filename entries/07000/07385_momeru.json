  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to have trouble; to quarrel; to dispute; to have a conflict",
      "explanation": "For people or parties to have disagreements or conflicts. Often used for disputes over money, inheritance, or interpersonal conflicts."
    }
  ],
  "examples": [
