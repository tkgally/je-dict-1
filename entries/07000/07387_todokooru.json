  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to stagnate; to be delayed; to accumulate unpaid",
      "explanation": "For things that should progress or flow to become stuck or delayed. Often used for payments, work, or physical flow."
    }
  ],
  "examples": [
    {
