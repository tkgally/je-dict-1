  "definitions": [
    {
      "sense_number": 1,
      "gloss": "stagnation; standstill; deadlock",
      "explanation": "A state where progress has stopped or slowed significantly. Used for economies, negotiations, traffic, or any situation that should be moving forward but isn't."
    }
  ],
  "examples": [
    {
      "id": "07427_teitai_ex1",
