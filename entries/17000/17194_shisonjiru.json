  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to fail; to blunder; to bungle; to make a mistake",
      "explanation": "To fail at doing something, especially through carelessness or poor execution. Implies that an attempt was made but went wrong."
    }
  ],
