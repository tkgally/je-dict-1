  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to take someone out; to lead someone outside; to bring someone along",
      "explanation": "To take a person (or sometimes a pet) from one place to another, typically from indoors to outdoors or from home to somewhere else."
    }
  ],
  "examples": [
    {
      "id": "17099_tsuredasu_ex1",
      "japanese": "{子供|こども}を{公園|こうえん}に{連|つ}れ{出|だ}す。",
      "english": "To take the kids to the park.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
