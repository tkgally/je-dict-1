  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be precocious; to act mature for one's age",
      "explanation": "Describes a child or young person who behaves, speaks, or thinks in a way that seems older or more adult than their actual age. Can be used positively or negatively."
    }
  ],
  "examples": [
