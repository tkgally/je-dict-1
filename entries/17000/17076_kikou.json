  "definitions": [
    {
      "sense_number": 1,
      "gloss": "contribution of an article; written submission",
      "explanation": "The act of writing and submitting an article, essay, or other piece of writing to a newspaper, magazine, journal, or website. Also refers to the submitted piece itself."
    }
  ],
