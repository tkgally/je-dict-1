  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to wrap; to package",
      "explanation": "To wrap or enclose something in paper, plastic, or other material for protection, presentation, or transport. Commonly used in retail and gift-giving contexts."
    }
  ],
