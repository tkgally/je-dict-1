  "definitions": [
    {
      "sense_number": 1,
      "gloss": "luxuriant growth; lush vegetation; thick growth",
      "explanation": "The state of plants growing thickly and abundantly, creating dense vegetation. Used for both natural wilderness and overgrown gardens."
    }
  ],
