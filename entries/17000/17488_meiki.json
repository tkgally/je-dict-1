  "definitions": [
    {
      "sense_number": 1,
      "gloss": "engraving in one's mind; keeping firmly in mind",
      "explanation": "To remember something deeply and not forget it, as if inscribing it in one's memory. Carries a strong sense of solemnity and commitment compared to ordinary remembering."
    }
  ],
  "examples": [
