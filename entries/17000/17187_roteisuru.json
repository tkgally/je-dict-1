  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be exposed; to come to light; to be revealed; to become apparent",
      "explanation": "For something hidden, negative, or problematic to become visible or known. Almost always used for negative things — flaws, weaknesses, scandals, contradictions."
    }
  ],
