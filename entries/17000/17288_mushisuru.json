  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to ignore; to disregard; to pay no attention to",
      "explanation": "To deliberately not acknowledge or respond to something or someone. Can refer to ignoring a person, a rule, a warning, or a fact."
    }
  ],
  "examples": [
