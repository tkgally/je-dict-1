  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be dumped; to be rejected romantically",
      "explanation": "To be turned down when confessing romantic feelings, or to be broken up with by a partner. The passive form of {振|ふ}る in its romantic rejection sense."
    }
  ],
