  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to disparage; to speak ill of; to put down; to belittle",
      "explanation": "To criticize someone or something in a way that makes them seem worthless or inferior. Implies unfair or unkind criticism rather than constructive feedback."
    }
  ],
  "examples": [
