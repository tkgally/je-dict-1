  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to delay; to postpone; to put off; to set back",
      "explanation": "To make something happen later than originally planned or scheduled. Can refer to deliberately pushing back a schedule or causing something to be late."
    }
  ],
