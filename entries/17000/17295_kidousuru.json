  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to start up; to boot; to launch (a machine or program)",
      "explanation": "To turn on or activate a computer, application, machine, or system so that it begins operating. The standard term for booting a computer or launching software."
    }
  ],
