  "definitions": [
    {
      "sense_number": 1,
      "gloss": "suspension; pause; halt; cessation",
      "explanation": "A temporary stop or suspension of an activity, service, or operation. Implies the activity may resume later, unlike permanent discontinuation."
    }
  ],
