  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to stray; to deviate; to go off course",
      "explanation": "For something to deviate from an intended path or direction, whether physically (a ball, a typhoon) or figuratively (a conversation, a topic)."
    },
    {
      "sense_number": 2,
      "gloss": "to miss (the mark); to go wide",
      "explanation": "For a projectile, ball, or aimed object to fail to hit its target."
    }
  ],
