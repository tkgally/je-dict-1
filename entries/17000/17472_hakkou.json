  "definitions": [
    {
      "sense_number": 1,
      "gloss": "luminescence; emission of light; giving off light",
      "explanation": "The production or emission of light by a living organism, chemical reaction, or electronic device. Used in both scientific contexts and everyday descriptions of things that glow."
