  "gloss": "remainder, surplus, excess",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "remainder, surplus, leftover",
      "explanation": "What is left over after division, subtraction, or use. The portion that exceeds what is needed."
    }
  ],
  "examples": [
    {
      "id": "17255_amari_ex1",
      "japanese": "10{割|わ}る3は3{余|あま}り1だ。",
      "english": "10 divided by 3 is 3 remainder 1.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "17255_amari_ex2",
      "japanese": "{布|ぬの}の{余|あま}りで{袋|ふくろ}を{作|つく}った。",
      "english": "I made a bag from the leftover fabric.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "17255_amari_ex3",
      "japanese": "{予算|よさん}の{余|あま}りを{来年|らいねん}に{繰|く}り{越|こ}す。",
      "english": "We will carry over the budget surplus to next year.",
