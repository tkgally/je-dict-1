  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to avoid; to evade; to avert; to circumvent",
      "explanation": "To take action to prevent an undesirable outcome or to stay away from a dangerous or problematic situation. Used for both physical and abstract avoidance."
    }
  ],
