  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to argue back; to refute; to counter",
      "explanation": "To present an opposing argument or objection in response to someone else's statement or claim. Implies a structured or reasoned response, not merely emotional disagreement."
    }
  ],
  "examples": [
    {
      "id": "17280_hanronsuru_ex1",
