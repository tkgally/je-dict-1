  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to prevent; to take precautions against",
      "explanation": "To take measures in advance to stop something undesirable from happening, especially diseases, accidents, or disasters."
    }
  ],
  "examples": [
    {
      "id": "17341_yobousuru_ex1",
      "japanese": "{風邪|かぜ}を{予防|よぼう}する。",
      "english": "To prevent a cold.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "17341_yobousuru_ex2",
      "japanese": "{手洗|てあら}いで{感染|かんせん}を{予防|よぼう}できる。",
      "english": "You can prevent infection by washing your hands.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "17341_yobousuru_ex3",
      "japanese": "{虫歯|むしば}を{予防|よぼう}するために{毎日|まいにち}{歯|は}を{磨|みが}きましょう。",
      "english": "Let's brush our teeth every day to prevent cavities.",
