  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to maintain; to preserve; to sustain",
      "explanation": "To keep something in its current state or condition, preventing it from deteriorating or changing. Used for both physical things and abstract concepts like health, order, or relationships."
    }
  ],
