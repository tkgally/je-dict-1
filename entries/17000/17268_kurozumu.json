  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to darken; to blacken; to become discolored",
      "explanation": "To gradually become dark or blackish in color, typically due to age, dirt, oxidation, or other natural processes. Describes a change that happens over time rather than suddenly."
    }
  ],
