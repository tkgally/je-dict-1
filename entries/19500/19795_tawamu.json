  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to bend; to warp; to sag; to bow under weight",
      "explanation": "For a rigid or semi-rigid object (such as a branch, beam, or shelf) to curve or deform under weight or pressure without breaking."
    }
  ],
