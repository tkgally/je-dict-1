  "definitions": [
    {
      "sense_number": 1,
      "gloss": "light blocking; shading; shielding from light",
      "explanation": "The act of blocking or shutting out light, or the property of doing so. Used for curtains, blinds, lenses, and other materials that prevent light from passing through."
    }
  ],
