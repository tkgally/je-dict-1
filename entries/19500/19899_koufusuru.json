  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to issue, to deliver, to grant (officially)",
      "explanation": "To officially hand over or issue documents, certificates, or funds from an authority or institution to an individual. A formal, administrative term."
    }
  ],
