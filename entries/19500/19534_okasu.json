  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to invade; to encroach on",
      "explanation": "To enter or intrude upon another's territory, space, or domain without permission."
    },
    {
      "sense_number": 2,
      "gloss": "to violate; to infringe upon",
      "explanation": "To transgress rights, privacy, or sovereignty. Used for abstract violations of protected things."
    }
  ],
