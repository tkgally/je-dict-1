  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to go against; to defy; to disobey",
      "explanation": "To act contrary to rules, expectations, orders, or someone's wishes."
    },
    {
      "sense_number": 2,
      "gloss": "to turn one's back on; to betray",
      "explanation": "To turn away from someone or something, abandoning loyalty or trust."
    }
  ],
