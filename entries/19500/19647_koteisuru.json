  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to fix, to fasten, to secure, to make stationary",
      "explanation": "To attach or lock something in place so it does not move. Used physically (fastening objects) and abstractly (fixing prices, roles, or concepts)."
    }
  ],
