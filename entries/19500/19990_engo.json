  "definitions": [
    {
      "sense_number": 1,
      "gloss": "support; backing; covering fire; protection",
      "explanation": "Assistance provided to help or protect someone, originally military (covering fire) but now widely used figuratively to mean backing someone up or providing support."
    }
  ],
