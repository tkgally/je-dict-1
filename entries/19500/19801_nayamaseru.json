  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to trouble; to worry; to torment; to vex",
      "explanation": "To cause someone to suffer worry, distress, or difficulty. The causative form of {悩|なや}む (to worry), used when an external factor or person causes the trouble."
    }
  ],
  "examples": [
    {
      "id": "19801_nayamaseru_ex1",
      "japanese": "この{問題|もんだい}が{私|わたし}を{悩|なや}ませている。",
      "english": "This problem is troubling me.",
      "sense_numbers": [
