  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to forbid; to prohibit; to ban",
      "explanation": "To officially or authoritatively prohibit an action or behavior."
    },
    {
      "sense_number": 2,
      "gloss": "to suppress; to hold back (a feeling)",
      "explanation": "To restrain oneself from expressing an emotion, especially in expressions meaning unable to hold back tears or unable to suppress a feeling."
    }
  ],
