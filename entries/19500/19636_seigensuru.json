  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to restrict, to limit, to set a cap on",
      "explanation": "To set an upper boundary or cap on quantity, time, access, or other measurable things. Implies a defined maximum or allowable range."
    }
  ],
