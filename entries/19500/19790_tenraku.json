  "definitions": [
    {
      "sense_number": 1,
      "gloss": "fall; tumble; plunge",
      "explanation": "Physically falling from a height, such as from a building, cliff, or elevated place."
    },
    {
      "sense_number": 2,
      "gloss": "decline; downfall; ruin",
      "explanation": "A figurative fall in status, position, or circumstances, such as falling into poverty or losing one's social standing."
    }
  ],
