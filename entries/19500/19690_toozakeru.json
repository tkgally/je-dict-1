  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to keep away; to keep at a distance",
      "explanation": "To physically or metaphorically move something or someone away, or to avoid contact with something."
    },
    {
      "sense_number": 2,
      "gloss": "to estrange; to alienate; to shun",
      "explanation": "To distance oneself from a person socially, or to push someone away emotionally."
    }
  ],
  "examples": [
    {
      "id": "19690_toozakeru_ex1",
      "japanese": "{子|こ}どもを{危険|きけん}から{遠|とお}ざける。",
      "english": "Keep children away from danger.",
      "sense_numbers": [
