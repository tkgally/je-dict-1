  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to worry about; to be anxious about; to be concerned about",
      "explanation": "To feel anxiety or concern about someone's wellbeing or a situation's outcome. More literary and formal than {心配|しんぱい}する."
    },
    {
      "sense_number": 2,
      "gloss": "to think up; to devise; to ponder",
      "explanation": "To think carefully about something and come up with an idea or plan. A somewhat literary usage."
    }
  ],
