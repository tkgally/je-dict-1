  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to fit into, to be contained in",
      "explanation": "To fit or be accommodated within a space, container, or limit."
    },
    {
      "sense_number": 2,
      "gloss": "to settle down, to subside, to be resolved",
      "explanation": "For a situation, disturbance, or emotion to calm down and return to a normal state."
    }
  ],
