  "schema_version": "2.0",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "reaching, arriving at, attaining",
      "explanation": "The act of reaching a destination, goal, or level after a process of progress or effort. Used for both physical arrival and abstract achievement of targets or milestones."
    }
  ],
  "examples": [
    {
      "id": "11815_toutatsu_ex1",
      "japanese": "{目標|もくひょう}に{到達|とうたつ}した。",
      "english": "We reached the goal.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11815_toutatsu_ex2",
      "japanese": "{登山|とざん}{隊|たい}がついに{山頂|さんちょう}に{到達|とうたつ}した。",
      "english": "The climbing team finally reached the summit.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11815_toutatsu_ex3",
      "japanese": "{売上|うりあげ}が{過去|かこ}{最高|さいこう}の{金額|きんがく}に{到達|とうたつ}する{見込|みこ}みだ。",
      "english": "Sales are expected to reach a record-high amount.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
