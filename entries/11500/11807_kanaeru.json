{
  "id": "11807_kanaeru",
  "headword": "{叶|かな}える",
  "reading": "かなえる",
  "part_of_speech": "verb (ichidan)",
  "gloss": "to fulfill; to grant",
  "conjugation": {
    "type": "ichidan",
