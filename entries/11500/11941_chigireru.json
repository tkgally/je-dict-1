  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be torn off, to come apart, to break into pieces",
      "explanation": "Something separates or breaks apart on its own, or as a result of force. Often used for paper, cloth, rope, or similar materials that tear or come apart."
    },
    {
      "sense_number": 2,
      "gloss": "to break apart, to scatter (of clouds, etc.)",
      "explanation": "Used figuratively or descriptively for things like clouds breaking apart in the sky."
    }
  ],
  "examples": [
