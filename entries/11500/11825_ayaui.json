{
  "id": "11825_ayaui",
  "headword": "{危|あや}うい",
  "reading": "あやうい",
  "part_of_speech": "i-adjective",
  "gloss": "dangerous, precarious, close call",
  "schema_version": "2.0",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "dangerous, perilous, precarious",
      "explanation": "In a state of danger or instability where something bad could easily happen. Describes situations that are on the verge of going wrong."
    },
    {
      "sense_number": 2,
      "gloss": "narrowly, barely (with く)",
      "explanation": "In the adverbial form {危|あや}うく, means 'nearly' or 'almost' — typically describing a narrow escape from something bad."
    }
  ],
  "examples": [
    {
      "id": "11825_ayaui_ex1",
      "japanese": "{命|いのち}が{危|あや}うい。",
      "english": "One's life is in danger.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11825_ayaui_ex2",
      "japanese": "あのチームの{優勝|ゆうしょう}は{危|あや}うい{状況|じょうきょう}だ。",
      "english": "That team's chance of winning the championship is in a precarious state.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11825_ayaui_ex3",
      "japanese": "{橋|はし}は{崩壊|ほうかい}の{危機|きき}にあり、{通行|つうこう}は{危|あや}うい。",
      "english": "The bridge is at risk of collapse and crossing it is dangerous.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11825_ayaui_ex4",
      "japanese": "{危|あや}うく{転|ころ}ぶところだった。",
      "english": "I almost fell down.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        2
      ]
    },
    {
      "id": "11825_ayaui_ex5",
      "japanese": "{危|あや}うく{電車|でんしゃ}に{乗|の}り{遅|おく}れるところだった。",
      "english": "I almost missed the train.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        2
      ]
    },
    {
      "id": "11825_ayaui_ex6",
      "japanese": "{危|あや}うく{大事故|だいじこ}になるところを、{運転手|うんてんしゅ}の{判断|はんだん}で{回避|かいひ}できた。",
      "english": "What could have nearly become a major accident was averted thanks to the driver's judgment.",
      "notes": null,
