  "definitions": [
    {
      "sense_number": 1,
      "gloss": "trade, player trade",
      "explanation": "The exchange of players between sports teams. This is the primary meaning in Japanese, unlike English where 'trade' covers commerce broadly."
    },
    {
      "sense_number": 2,
      "gloss": "trade, exchange, swap",
      "explanation": "An exchange or swap of items, especially collectibles like trading cards."
    }
  ],
