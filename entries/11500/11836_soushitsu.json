  "definitions": [
    {
      "sense_number": 1,
      "gloss": "loss, forfeiture, deprivation",
      "explanation": "The loss of something important or valuable, especially abstract things like rights, qualifications, memory, or identity. More formal and weighty than simply 'losing' something."
    }
  ],
