  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to surpass, to exceed, to be superior to",
      "explanation": "To be better than or exceed something in comparison. Used with に to mark the thing being surpassed."
    }
  ],
  "examples": [
    {
      "id": "11848_masaru_ex1",
      "japanese": "{質|しつ}は{量|りょう}に{勝|まさ}る。",
      "english": "Quality surpasses quantity.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11848_masaru_ex2",
      "japanese": "{彼|かれ}は{体力|たいりょく}で{誰|だれ}にも{勝|まさ}る。",
      "english": "He surpasses everyone in physical strength.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11848_masaru_ex3",
      "japanese": "{百聞|ひゃくぶん}は{一見|いっけん}に{勝|まさ}るとも{劣|おと}らない{経験|けいけん}だった。",
      "english": "It was an experience no less powerful than seeing it with one's own eyes.",
