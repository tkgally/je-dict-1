  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to surpass, to exceed, to be superior to",
      "explanation": "To be better than or exceed something in comparison. Used with に to mark the thing being surpassed."
    }
  ],
  "examples": [
    {
      "id": "11848_masaru_ex1",
      "japanese": "⟦{質|しつ}→質：01425_shitsu⟧⟦は→は：00079_ha⟧⟦{量|りょう}→量：03799_ryou⟧⟦に→に：00314_ni⟧{勝|まさ}る。",
      "english": "Quality surpasses quantity.",
