  "definitions": [
    {
      "sense_number": 1,
      "gloss": "talking back, backtalk, retort",
      "explanation": "Responding argumentatively or defiantly to someone of higher status such as a parent, teacher, or boss. Viewed negatively in Japanese culture as disrespectful behavior."
    }
