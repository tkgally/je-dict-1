  "schema_version": "2.0",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to divide, to mark off, to segment",
      "explanation": "To separate something into sections or segments by marking boundaries. Used for dividing text, time, space, or abstract concepts."
    },
    {
      "sense_number": 2,
      "gloss": "to bring to a close, to put a stop to",
      "explanation": "To mark a stopping point or conclusion in an activity or period."
    }
  ],
