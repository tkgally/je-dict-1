  "definitions": [
    {
      "sense_number": 1,
      "gloss": "restraint, stopping, holding back",
      "explanation": "The act of stopping or restraining someone from doing something, typically by physical intervention or verbal command. Often used when preventing someone from acting rashly or dangerously."
    }
  ],
