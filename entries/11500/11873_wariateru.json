  "schema_version": "2.0",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to assign, to allocate, to allot",
      "explanation": "To distribute or apportion something (tasks, resources, roles, etc.) to specific people or purposes."
    }
  ],
  "examples": [
    {
      "id": "11873_wariateru_ex1",
      "japanese": "{各自|かくじ}に{役割|やくわり}を{割|わ}り{当|あ}てた。",
      "english": "I assigned roles to each person.",
      "notes": null,
      "has_audio": false,
