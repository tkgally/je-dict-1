  "schema_version": "2.0",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to transform, to take the form of, to appear as",
      "explanation": "To change one's appearance or form, especially said of supernatural beings (foxes, tanuki, ghosts) disguising themselves as humans or other things."
    },
    {
      "sense_number": 2,
      "gloss": "to change drastically, to be transformed",
      "explanation": "Used figuratively for dramatic changes in character, ability, or circumstances."
    }
  ],
  "examples": [
    {
      "id": "11849_bakeru_ex1",
      "japanese": "{狐|きつね}が{人|ひと}に{化|ば}ける。",
      "english": "A fox transforms into a human.",
