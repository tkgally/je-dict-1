      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11849_bakeru_ex3",
      "japanese": "{幽霊|ゆうれい}が{美|うつく}しい{女|おんな}に{化|ば}けて{現|あらわ}れた。",
