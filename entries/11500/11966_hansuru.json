  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be contrary to, to contradict, to go against",
      "explanation": "To be in opposition to a principle, expectation, or standard. Used with に to mark the thing being contradicted."
    },
    {
      "sense_number": 2,
      "gloss": "to violate, to act against",
      "explanation": "To break or act contrary to a rule, law, or agreement. Common in legal and formal contexts."
    }
  ],
