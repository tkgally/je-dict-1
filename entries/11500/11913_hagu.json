  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to strip off, to peel off, to tear off",
      "explanation": "To forcefully remove something that covers or clings to a surface — such as skin, bark, clothing, paint, or a mask. Implies a rougher, more forceful action than simply peeling."
    }
  ],
