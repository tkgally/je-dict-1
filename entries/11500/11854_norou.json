  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to curse, to put a curse on, to hex",
      "explanation": "To invoke supernatural harm upon someone, or to wish ill upon them. Can refer to literal supernatural curses or strong feelings of resentment."
    }
