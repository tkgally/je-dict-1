  "definitions": [
    {
      "sense_number": 1,
      "gloss": "lead, advantage",
      "explanation": "Being ahead of others in a competition, score, or race. Also used as a suru-verb meaning to lead or guide."
    },
    {
      "sense_number": 2,
      "gloss": "leash, lead (for pets)",
      "explanation": "A strap or cord attached to an animal's collar for controlling it during walks."
    }
  ],
