  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to offer, to make an offering (to gods, ancestors, the deceased)",
      "explanation": "To present food, flowers, or other items as a religious or memorial offering, typically placing them at an altar, grave, or shrine."
    }
  ],
  "examples": [
    {
      "id": "11562_sonaeru_ex1",
      "japanese": "{仏壇|ぶつだん}に{花|はな}を{供|そな}える。",
      "english": "Offer flowers at the Buddhist altar.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11562_sonaeru_ex2",
      "japanese": "{墓|はか}に{線香|せんこう}と{果物|くだもの}を{供|そな}えた。",
      "english": "I offered incense and fruit at the grave.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11562_sonaeru_ex3",
      "japanese": "{毎朝|まいあさ}、{神棚|かみだな}に{水|みず}と{米|こめ}を{供|そな}えるのが{日課|にっか}になっている。",
      "english": "It has become my daily routine to offer water and rice at the household Shinto altar every morning.",
      "notes": null,
