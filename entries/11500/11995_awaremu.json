  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to pity, to feel sorry for",
      "explanation": "To feel compassion or sympathy for someone in a difficult or unfortunate situation."
    },
    {
      "sense_number": 2,
      "gloss": "to find something moving, to feel pathos",
      "explanation": "To be emotionally moved by the beauty or sadness of something, with a sense of poignancy."
    }
  ],
