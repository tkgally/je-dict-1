  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to dislike, to be reluctant, to shun",
      "explanation": "To feel aversion toward something and wish to avoid it. Carries a literary or formal tone compared to everyday words like {嫌|きら}う. Often used with abstract nouns like {苦労|くろう} (hardship) or {手間|てま} (effort)."
    }
  ],
