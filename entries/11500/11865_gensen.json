  "definitions": [
    {
      "sense_number": 1,
      "gloss": "careful selection, handpicking, strict selection",
      "explanation": "The act of selecting with great care and strict standards. Commonly used in marketing and advertising to emphasize quality."
    }
  ],
  "examples": [
