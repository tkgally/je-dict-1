  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to conform to, to be based on, to be suited to",
      "explanation": "To be in accordance with or adapted to a particular situation, reality, or standard. Takes に to mark the thing conformed to."
    }
  ],
