  "definitions": [
    {
      "sense_number": 1,
      "gloss": "establishment, founding, creation",
      "explanation": "The act of creating or founding an organization, institution, or system for the first time. Emphasizes the initial creation from nothing, rather than reorganizing something existing."
    }
  ],
  "examples": [
    {
      "id": "11905_sousetsu_ex1",
      "japanese": "{新|あたら}しい{学部|がくぶ}を{創設|そうせつ}した。",
      "english": "A new faculty was established.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11905_sousetsu_ex2",
      "japanese": "この{会社|かいしゃ}は1950{年|ねん}に{創設|そうせつ}された。",
      "english": "This company was founded in 1950.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11905_sousetsu_ex3",
      "japanese": "{政府|せいふ}は{新|あたら}しい{研究機関|けんきゅうきかん}の{創設|そうせつ}を{決定|けってい}した。",
      "english": "The government decided to establish a new research institution.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    }
  ],
  "notes": "Used for significant, formal acts of founding — typically organizations, institutions, or systems. Not used for casually starting small projects.\n\nSIMILAR WORDS:\n・{設立|せつりつ} — establishing (focuses on the formal, legal process)\n・{創立|そうりつ} — founding (similar to {創設|そうせつ} but often used for schools and companies)\n・{創設|そうせつ} — emphasizes creating something entirely new\n\nCOMMON PATTERNS:\n・{創設|そうせつ}する (to establish)\n・{創設|そうせつ}される (to be established)\n・〜の{創設|そうせつ} (the founding of ~)",
