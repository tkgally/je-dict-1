      "sense_number": 1,
      "gloss": "outbreak, eruption, sudden occurrence",
      "explanation": "The sudden outbreak or eruption of a major event, especially war, conflict, or a crisis. Implies something erupting suddenly and violently."
    }
  ],
  "examples": [
    {
