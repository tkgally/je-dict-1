  "definitions": [
    {
      "sense_number": 1,
      "gloss": "mobilization, rallying",
      "explanation": "The act of assembling and organizing people, resources, or forces for a particular purpose. Originally a military term, now widely used for gathering large numbers of people for events, projects, or causes."
