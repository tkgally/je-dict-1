  "definitions": [
    {
      "sense_number": 1,
      "gloss": "reconstruction, rebuilding (of a structure)",
      "explanation": "Rebuilding a physical structure such as a building or temple that has been destroyed or damaged."
    },
    {
      "sense_number": 2,
      "gloss": "reorganization, restructuring, getting back on one's feet",
      "explanation": "Rebuilding or restructuring something abstract such as a business, finances, or one's life after a setback."
    }
  ],
