  "definitions": [
    {
      "sense_number": 1,
      "gloss": "control, regulation, governing",
      "explanation": "The act of controlling or regulating something, especially machinery, systems, or physical forces. Often used in technical and scientific contexts for precise management of processes or devices."
    }
  ],
  "examples": [
