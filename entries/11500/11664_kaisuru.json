  "schema_version": "2.0",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to go through, to use as an intermediary",
      "explanation": "To use something or someone as a means, channel, or intermediary. Almost always appears in the pattern 〜を{介|かい}して (through ~, via ~)."
    },
    {
      "sense_number": 2,
      "gloss": "to mind, to care about",
      "explanation": "To be bothered by or concerned about something. Used in the negative pattern {意|い}に{介|かい}さない (not to care, not to be bothered)."
    }
  ],
