  "definitions": [
    {
      "sense_number": 1,
      "gloss": "joining, enrollment, subscription",
      "explanation": "The act of joining or becoming a member of a group, organization, plan, or service. Commonly used for formal memberships such as insurance, unions, international organizations, and subscription services."
    }
  ],
