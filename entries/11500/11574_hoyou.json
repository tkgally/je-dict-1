  "definitions": [
    {
      "sense_number": 1,
      "gloss": "rest, recuperation, convalescence",
      "explanation": "Resting the body and mind to recover health and vitality, often by going to a quiet or scenic location such as a hot spring resort or the countryside."
    }
  ],
