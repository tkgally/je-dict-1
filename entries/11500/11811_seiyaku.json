  "definitions": [
    {
      "sense_number": 1,
      "gloss": "constraint; restriction; limitation",
      "explanation": "A condition or factor that limits freedom of action. Used for rules, conditions, budgets, time limits, and other factors that restrict what can be done."
    }
  ],
