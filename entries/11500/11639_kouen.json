  "schema_version": "2.0",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "public performance, show, stage performance",
      "explanation": "A performance or show presented to the public, typically in a theater or concert hall. Used for plays, musicals, concerts, ballet, and other staged performances."
    }
  ],
  "examples": [
    {
      "id": "11639_kouen_ex1",
      "japanese": "{今夜|こんや}の{公演|こうえん}は{満席|まんせき}だ。",
      "english": "Tonight's performance is sold out.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11639_kouen_ex2",
      "japanese": "この{劇団|げきだん}は{来月|らいげつ}から{全国|ぜんこく}{公演|こうえん}を{行|おこな}う。",
      "english": "This theater company will hold nationwide performances starting next month.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "11639_kouen_ex3",
      "japanese": "{有名|ゆうめい}なバレエ{団|だん}の{公演|こうえん}を{見|み}に{行|い}ったが、{期待|きたい}どおり{素晴|すば}らしかった。",
      "english": "I went to see a performance by a famous ballet company, and it was wonderful, just as I expected.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    }
  ],
  "notes": "Used for staged artistic performances. Not used for informal live performances or street performances.\n\nCOMMON COLLOCATIONS:\n- {公演|こうえん}を{行|おこな}う (hold a performance)\n- {公演|こうえん}を{見|み}に{行|い}く (go to see a performance)\n- {全国|ぜんこく}{公演|こうえん} (nationwide tour/performances)\n- {初|はつ}{公演|こうえん} (first/premiere performance)\n- {千秋楽|せんしゅうらく} (final performance of a run)\n- {公演|こうえん}{中止|ちゅうし} (performance cancellation)\n\nNote the homophone {公園|こうえん} (park), which has the same reading but different kanji and meaning.",
