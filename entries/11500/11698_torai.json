  "definitions": [
    {
      "sense_number": 1,
      "gloss": "try, attempt, challenge",
      "explanation": "An attempt or effort to do something, often with a positive nuance of taking on a challenge. Used as a suru verb to mean 'to give something a try.'"
    },
    {
      "sense_number": 2,
      "gloss": "try (rugby)",
      "explanation": "In rugby, scoring by touching the ball down in the opponent's in-goal area."
    }
  ],
