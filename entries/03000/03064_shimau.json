  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to put away, to store",
      "explanation": "To put something in its proper place; to store or tidy away."
    },
    {
      "sense_number": 2,
      "gloss": "to finish, to close",
      "explanation": "To bring something to an end; to close up (a shop)."
    }
  ],
