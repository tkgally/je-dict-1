  "id": "03423_datte",
  "headword": "だって",
  "reading": "だって",
  "part_of_speech": "conjunction, particle",
  "gloss": "but, because, even",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "but, because",
      "explanation": "Used at the beginning of a sentence to offer a reason or excuse, often with a slightly defensive or childish nuance."
    },
    {
      "sense_number": 2,
      "gloss": "even, also",
      "explanation": "Attached after a noun to mean 'even' or 'also,' similar to でも."
    }
  ],
  "examples": [
