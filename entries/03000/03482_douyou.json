  "definitions": [
    {
      "sense_number": 1,
      "gloss": "agitation, disturbance, emotional upset",
      "explanation": "A state of being emotionally shaken or disturbed. Can refer to mental agitation or being thrown off balance emotionally."
    },
    {
      "sense_number": 2,
      "gloss": "shaking, swaying, instability",
      "explanation": "Physical shaking or instability, though the emotional meaning is more common."
    }
  ],
