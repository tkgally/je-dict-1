  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to undertake, to take on, to accept",
      "explanation": "To accept responsibility for a task, duty, or role."
    },
    {
      "sense_number": 2,
      "gloss": "to take charge of, to guarantee",
      "explanation": "To become responsible for someone or something."
    }
  ],
  "examples": [
