    },
    {
      "id": "03134_hanashikakeru_ex4",
      "japanese": "{道|みち}に{迷|まよ}ったので、{近|ちか}くにいた{人|ひと}に{話|はな}しかけた。",
      "english": "I was lost, so I spoke to someone nearby.",
