  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to speak to, to address, to start a conversation with",
      "explanation": "To initiate speech with someone; to address or talk to someone (often unexpectedly or as the first interaction)."
    }
  ],
  "examples": [
    {
      "id": "03134_hanashikakeru_ex1",
      "japanese": "{見知|みし}らぬ{人|ひと}に{話|はな}しかけられた。",
      "english": "A stranger spoke to me.",
      "notes": "Passive form",
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "03134_hanashikakeru_ex2",
      "japanese": "{彼女|かのじょ}に{話|はな}しかける{勇気|ゆうき}がなかった。",
      "english": "I didn't have the courage to speak to her.",
