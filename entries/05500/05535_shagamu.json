  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to squat; to crouch down",
      "explanation": "To lower one's body by bending the knees while keeping the feet flat on the ground."
    }
  ],
  "examples": [
    {
      "id": "05535_shagamu_ex1",
      "japanese": "{子供|こども}がしゃがんで{花|はな}を{見|み}ている。",
      "english": "The child is squatting down looking at flowers.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "05535_shagamu_ex2",
      "japanese": "{足|あし}が{疲|つか}れたので、しゃがんで{休|やす}んだ。",
      "english": "My legs were tired, so I squatted down to rest.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "05535_shagamu_ex3",
      "japanese": "{荷物|にもつ}を{拾|ひろ}うためにしゃがむ。",
      "english": "To squat down to pick up luggage.",
      "notes": null,
