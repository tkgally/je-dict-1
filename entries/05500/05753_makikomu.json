  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to roll up, to wrap up in",
      "explanation": "To wind or wrap something into something else."
    },
    {
      "sense_number": 2,
      "gloss": "to involve, to drag into",
      "explanation": "To get someone involved in a situation, often against their will."
    }
  ],
  "examples": [
    {
      "id": "05753_makikomu_ex1",
      "japanese": "{布|ぬの}を{巻|ま}き{込|こ}む。",
