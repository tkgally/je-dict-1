      "sense_number": 1,
      "gloss": "crackling; popping",
      "explanation": "Describes the sound of fire crackling, fireworks popping, or similar sharp, light sounds in succession."
    },
    {
      "sense_number": 2,
      "gloss": "clapping (hands)",
      "explanation": "Describes the sound or action of applause or hand-clapping."
    },
    {
      "sense_number": 3,
      "gloss": "blinking repeatedly",
      "explanation": "Describes eyes blinking rapidly, often in surprise or to clear vision."
    }
