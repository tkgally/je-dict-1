  "part_of_speech": "adverb, onomatopoeia",
  "gloss": "munching; gobbling; opening and closing (mouth)",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "munching; gobbling",
      "explanation": "Eating eagerly by repeatedly opening and closing the mouth; wolfing down food."
    },
    {
      "sense_number": 2,
      "gloss": "opening and closing repeatedly",
      "explanation": "The motion of a mouth (or mouth-like thing) repeatedly opening and closing."
    }
  ],
  "examples": [
