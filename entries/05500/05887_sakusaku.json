{
  "id": "05887_sakusaku",
  "headword": "さくさく",
  "reading": "さくさく",
  "part_of_speech": "adverb, na-adjective",
  "gloss": "crispy; crunchy; smoothly progressing",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "crispy; crunchy",
      "explanation": "Describes a light, pleasant crunchiness, typically of food with a delicate texture like tempura, fresh vegetables, or pastries."
    },
    {
      "sense_number": 2,
      "gloss": "smoothly; efficiently; quickly",
      "explanation": "Describes something proceeding smoothly without hindrance, especially work or tasks."
    }
  ],
  "examples": [
    {
