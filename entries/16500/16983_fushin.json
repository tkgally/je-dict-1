  "definitions": [
    {
      "sense_number": 1,
      "gloss": "racking one's brains; taking great pains; devoting oneself to",
      "explanation": "Worrying intensely and devoting great mental effort to solving a problem or achieving something. Literally 'rotting the heart/mind' from the strain of thinking."
    }
  ],
