  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to chase; to run after; to pursue",
      "explanation": "To run after someone or something in order to catch them. Used for physical pursuit of people, animals, or objects."
    },
    {
      "sense_number": 2,
      "gloss": "to pursue; to seek after",
      "explanation": "To pursue something abstract such as a dream, goal, or ideal."
    }
  ],
