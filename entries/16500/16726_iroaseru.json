  "headword": "{色|いろ}あせる",
  "reading": "いろあせる",
  "part_of_speech": "verb (ichidan)",
  "gloss": "to fade, to lose color",
  "conjugation": {
    "type": "ichidan",
    "stem": "{色|いろ}あせ"
  },
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to fade, to lose color",
      "explanation": "For colors to become less vivid over time due to sunlight, washing, or age."
    },
    {
      "sense_number": 2,
      "gloss": "to lose its luster, to become stale",
      "explanation": "For memories, achievements, or value to diminish or feel less significant over time. Figurative use."
    }
  ],
  "examples": [
    {
