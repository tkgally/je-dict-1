  "definitions": [
    {
      "sense_number": 1,
      "gloss": "sobbing; choking with tears; weeping convulsively",
      "explanation": "Deep, convulsive crying where the voice catches in the throat. Describes emotional weeping that is difficult to control, more intense than quiet crying."
    }
  ],
