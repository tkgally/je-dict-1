  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to oversleep, to sleep in",
      "explanation": "To sleep longer than intended, especially past the time one should wake up. Can also be used as a noun meaning 'oversleeper' or 'oversleeping.'"
