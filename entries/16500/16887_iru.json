  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to roast; to parch; to toast; to pan-fry (dry)",
      "explanation": "To cook by heating in a dry pan without oil, causing ingredients to become crisp and fragrant. Used for nuts, seeds, beans, and similar ingredients."
    }
  ],
