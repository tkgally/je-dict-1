  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to become blurry; to become out of focus",
      "explanation": "For vision, images, or outlines to become unclear or indistinct."
    },
    {
      "sense_number": 2,
      "gloss": "to become vague; to become unclear",
      "explanation": "For ideas, memories, distinctions, or boundaries to become unclear or indistinct. Used figuratively."
    }
  ],
