  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to carry back; to return to a previous state",
      "explanation": "To move something back to its original position or state. Used both literally (rewinding tape) and figuratively (reverting financial losses or recovering past payments)."
    }
  ],
