  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to endure; to bear; to put up with",
      "explanation": "To patiently withstand hardship, pain, or difficult circumstances without complaining."
    },
    {
      "sense_number": 2,
      "gloss": "to conceal oneself; to hide; to do something secretly",
      "explanation": "To act stealthily or keep something hidden from others. The root meaning behind the word ninja (忍者)."
    },
    {
      "sense_number": 3,
      "gloss": "to reminisce; to long for",
      "explanation": "To fondly recall or yearn for the past, a person, or a place. Often literary."
    }
  ],
