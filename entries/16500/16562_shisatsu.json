  "definitions": [
    {
      "sense_number": 1,
      "gloss": "inspection; observation tour; fact-finding visit",
      "explanation": "An official or professional visit to a site, facility, or region to observe conditions, operations, or progress firsthand. Implies a purposeful, structured observation."
    }
