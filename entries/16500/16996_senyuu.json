  "definitions": [
    {
      "sense_number": 1,
      "gloss": "exclusive possession; occupancy; monopolization",
      "explanation": "Having something under one's exclusive control or use. Used in legal, business, and everyday contexts to describe taking or holding sole possession of a space, resource, or market share."
