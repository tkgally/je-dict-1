  "definitions": [
    {
      "sense_number": 1,
      "gloss": "memorial toast; offering a drink in memory of the deceased",
      "explanation": "A solemn toast made at funeral gatherings or memorial services to honor someone who has passed away. Unlike a celebratory toast, it is quiet and respectful."
    }
  ],
  "examples": [
