  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to pity; to feel compassion for; to sympathize with",
      "explanation": "To feel sorrow or sympathy for someone in a difficult or unfortunate situation."
    }
  ],
  "examples": [
    {
      "id": "16875_awaremu_ex1",
