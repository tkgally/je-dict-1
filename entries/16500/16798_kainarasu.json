  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to tame; to domesticate",
      "explanation": "To raise and train a wild animal until it becomes accustomed to humans. Can also be used figuratively to mean bringing someone under control."
    }
  ],
  "examples": [
