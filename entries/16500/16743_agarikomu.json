  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to enter; to go into someone's house",
      "explanation": "To enter someone's home or a building, especially without much formality or without being properly invited. Can carry a nuance of making oneself at home or barging in."
    }
  ],
