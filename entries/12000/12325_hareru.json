  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to swell, to become swollen, to be inflamed",
      "explanation": "To become enlarged or puffy due to injury, infection, or an allergic reaction. Used for body parts that puff up from a medical or physical cause."
    }
  ],
