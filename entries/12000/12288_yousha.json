  "definitions": [
    {
      "sense_number": 1,
      "gloss": "mercy, forgiveness, leniency, pardon",
      "explanation": "Showing leniency or sparing someone from punishment or harsh treatment. Very frequently used in the negative form to mean showing no mercy or being relentless."
