  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to harbor, to hold within, to carry",
      "explanation": "To contain or hold something intangible within oneself — an emotion, a thought, a spirit, or a quality."
    },
    {
      "sense_number": 2,
      "gloss": "to conceive, to carry (a child)",
      "explanation": "To become pregnant, to carry a child in one's womb. A literary or formal expression."
    },
    {
      "sense_number": 3,
      "gloss": "to reflect, to catch (light, dew)",
      "explanation": "For a surface to hold or reflect light, moisture, or color. A poetic expression."
    }
  ],
