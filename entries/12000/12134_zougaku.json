  "definitions": [
    {
      "sense_number": 1,
      "gloss": "increase in amount, raise (of money)",
      "explanation": "An increase in a monetary amount, such as a budget, salary, investment, or payment. The opposite of 減額 (reduction in amount). Used in business, government, and financial contexts."
    }
  ],
