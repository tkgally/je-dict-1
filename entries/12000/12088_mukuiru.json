  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to reward, to repay, to reciprocate",
      "explanation": "To return a favor, kindness, or effort with an appropriate response. Often used for repaying someone's goodwill, trust, or hard work."
    },
    {
      "sense_number": 2,
      "gloss": "to retaliate, to avenge, to get back at",
      "explanation": "To return harm or wrongdoing in kind. Used for revenge or retribution."
    }
  ],
