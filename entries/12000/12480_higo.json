  "definitions": [
    {
      "sense_number": 1,
      "gloss": "protection, patronage, shelter",
      "explanation": "Protecting and supporting someone weaker or in a vulnerable position. Used in contexts ranging from personal protection to political asylum and institutional patronage."
    }
  ],
