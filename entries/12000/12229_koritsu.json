  "definitions": [
    {
      "sense_number": 1,
      "gloss": "isolation, being cut off, standing alone",
      "explanation": "The state of being separated from others, either physically (cut off by a disaster, geographically remote) or socially (having no allies, being excluded). Can describe individuals, communities, or nations."
    }
  ],
