  "definitions": [
    {
      "sense_number": 1,
      "gloss": "salt preservation, salt curing, salting",
      "explanation": "The method of preserving food by packing it in salt or soaking it in brine. A traditional technique used for fish, vegetables, and meat to prevent spoilage."
    }
  ],
