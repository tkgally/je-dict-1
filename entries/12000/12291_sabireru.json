  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to become deserted, to decline, to fall into disuse",
      "explanation": "For a place, area, or business to lose its former liveliness or prosperity and become quiet and empty. Often used for towns, shopping streets, and tourist areas that have lost visitors or residents."
    }
  ],
  "examples": [
