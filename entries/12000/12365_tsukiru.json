  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to run out, to be exhausted, to be used up",
      "explanation": "For a supply, resource, or abstract quality to be completely depleted or exhausted. Describes reaching the end of something finite."
    }
  ],
