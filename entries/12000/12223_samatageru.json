  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to hinder, to obstruct, to impede",
      "explanation": "To prevent something from proceeding smoothly or to get in the way of someone's actions or progress. Used for both physical and abstract obstruction."
    }
  ],
  "examples": [
    {
