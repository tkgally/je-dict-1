  "definitions": [
    {
      "sense_number": 1,
      "gloss": "staying home, nesting, cocooning",
      "explanation": "Staying indoors for an extended period, especially by choice. Originally referred to birds sitting in their nests, but gained widespread use during the COVID-19 pandemic to describe the lifestyle of staying home."
    }
  ],
