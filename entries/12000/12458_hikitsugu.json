  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to take over, to inherit, to succeed to",
      "explanation": "To assume responsibility for work, duties, a role, or property from a predecessor. Used for both professional handovers and inheritance of traditions or qualities."
    }
  ],
  "examples": [
    {
      "id": "12458_hikitsugu_ex1",
      "japanese": "{仕事|しごと}を{引|ひ}き{継|つ}ぐ。",
      "english": "To take over the work.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "12458_hikitsugu_ex2",
      "japanese": "{父|ちち}の{会社|かいしゃ}を{引|ひ}き{継|つ}いだ。",
