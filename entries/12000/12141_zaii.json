  "definitions": [
    {
      "sense_number": 1,
      "gloss": "being on the throne, reign, tenure (of a monarch)",
      "explanation": "The state of a monarch occupying the throne. Describes the period during which a ruler holds sovereign power. Primarily used for emperors and kings."
    }
  ],
