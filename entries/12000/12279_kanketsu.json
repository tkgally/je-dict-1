  "definitions": [
    {
      "sense_number": 1,
      "gloss": "completion, conclusion, ending",
      "explanation": "A story, series, project, or process reaching its final conclusion. Commonly used for the ending of serialized manga, novels, TV series, and other ongoing works."
    }
  ],
  "examples": [
