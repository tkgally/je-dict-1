  "definitions": [
    {
      "sense_number": 1,
      "gloss": "coldness, the cold, cold weather",
      "explanation": "The quality or state of being cold. Formed from the adjective 寒い by replacing い with さ to create a noun expressing the degree or quality of coldness."
    }
  ],
  "examples": [
    {
      "id": "12336_samusa_ex1",
      "japanese": "{冬|ふゆ}の{寒|さむ}さが{厳|きび}しい。",
      "english": "The winter cold is severe.",
      "notes": null,
