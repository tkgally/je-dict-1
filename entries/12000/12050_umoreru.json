  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be buried, to be covered",
      "explanation": "To be physically buried or covered by something such as snow, sand, rubble, or objects."
    },
    {
      "sense_number": 2,
      "gloss": "to be hidden, to remain unnoticed, to be lost",
      "explanation": "To remain obscure, overlooked, or forgotten. Used for talent, works, or facts that deserve recognition but go unnoticed."
    }
  ],
  "examples": [
