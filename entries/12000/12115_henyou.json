  "definitions": [
    {
      "sense_number": 1,
      "gloss": "transformation, transfiguration, metamorphosis",
      "explanation": "A fundamental change in appearance, form, or character. Emphasizes qualitative change rather than mere alteration. Often used for large-scale or significant shifts in society, culture, or identity."
    }
