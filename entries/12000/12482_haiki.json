  "definitions": [
    {
      "sense_number": 1,
      "gloss": "disposal, scrapping, discarding",
      "explanation": "The act of throwing away, disposing of, or scrapping something that is no longer needed or useful. Used for physical objects, documents, and also for abstract things like treaties or plans."
    }
  ],
