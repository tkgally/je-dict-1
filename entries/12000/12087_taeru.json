  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to endure, to bear, to put up with",
      "explanation": "To patiently withstand pain, hardship, or difficult conditions without giving in. Used for both physical and emotional endurance."
    },
    {
      "sense_number": 2,
      "gloss": "to withstand, to resist, to hold up against",
      "explanation": "To be strong or durable enough to resist physical force, pressure, or harsh conditions. Often used for materials, structures, and equipment."
    }
  ],
