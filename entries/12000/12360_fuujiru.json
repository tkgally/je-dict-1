  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to seal, to close with a seal",
      "explanation": "To seal an envelope, container, or opening. The physical act of sealing something shut."
    },
    {
      "sense_number": 2,
      "gloss": "to block, to suppress, to seal away",
      "explanation": "To prevent something from being used, expressed, or accessed. Used figuratively for suppressing abilities, memories, or options."
    }
  ],
