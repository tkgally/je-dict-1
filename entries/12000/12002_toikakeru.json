  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to pose a question, to ask, to question",
      "explanation": "To direct a question at someone, often with the nuance of prompting thought or seeking a deeper answer. Can also mean to address a question to the public or society at large."
    }
  ],
