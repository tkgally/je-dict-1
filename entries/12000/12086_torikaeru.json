  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to replace, to exchange, to swap",
      "explanation": "To remove one thing and put another in its place, or to exchange two things with each other. Used for replacing worn-out items, swapping objects, and exchanging goods."
    }
  ],
