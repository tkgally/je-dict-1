  "definitions": [
    {
      "sense_number": 1,
      "gloss": "returning to one's hometown, going home to visit family",
      "explanation": "A visit back to one's hometown or parents' home, typically during holidays or vacation periods. A culturally significant practice in Japan, especially during Obon, New Year's, and Golden Week."
    }
  ],
  "examples": [
