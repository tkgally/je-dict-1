  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to play (a musical instrument), to produce music or melody",
      "explanation": "Describes performing music on an instrument. Has a literary, elegant tone compared to the more common 弾く. Often used for orchestral instruments, ensembles, or poetic descriptions of sound."
    }
  ],
