  "definitions": [
    {
      "sense_number": 1,
      "gloss": "abolition, discontinuation, repeal",
      "explanation": "The act of officially ending or abolishing a system, law, service, or practice that has been in effect. Implies a formal, deliberate decision to terminate something."
    }
