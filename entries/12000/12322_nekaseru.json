  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to put to bed, to lay down",
      "explanation": "To put someone (especially a child) to bed, or to lay something flat."
    },
    {
      "sense_number": 2,
      "gloss": "to let age, to let rest, to let sit",
      "explanation": "To leave food, drink, or dough for a period of time to develop flavor, ferment, or reach the right consistency."
    }
  ],
