  "definitions": [
    {
      "sense_number": 1,
      "gloss": "designation, name, title, appellation",
      "explanation": "A formal name or title used to refer to a person, place, or thing. More formal and official than ordinary naming. Often used in institutional, academic, or regulatory contexts when discussing what something is officially called."
    }
  ],
