  "part_of_speech": "noun, suru verb",
  "gloss": "calling out to someone, speaking to someone",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "calling out to someone, addressing someone",
      "explanation": "The act of speaking to someone, especially to offer help, extend an invitation, or get their attention. Often implies a friendly or supportive initiative."
    }
  ],
  "examples": [
    {
      "id": "12146_koekake_ex1",
