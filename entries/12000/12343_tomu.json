  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be rich in, to abound in, to be abundant",
      "explanation": "To possess something in large quantity or to be well-endowed with a particular quality. Often used with the particle に to indicate what is abundant."
    }
  ],
  "examples": [
