  "definitions": [
    {
      "sense_number": 1,
      "gloss": "same year, same class, same cohort",
      "explanation": "People who entered a company, school, or organization in the same year. An important concept in Japanese workplace culture, where cohort bonds are strong."
    },
    {
      "sense_number": 2,
      "gloss": "synchronization",
      "explanation": "Aligning the timing or data of two or more systems. Used in computing, engineering, and telecommunications."
    }
  ],
