  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to train, to work out, to build up, to discipline",
      "explanation": "To strengthen the body or mind through repeated exercise or practice. Often used for physical training but also applies to mental discipline."
    },
    {
      "sense_number": 2,
      "gloss": "to forge, to temper",
      "explanation": "To heat and hammer metal repeatedly to make it stronger. The original meaning from metalworking, now less common in everyday use."
    }
  ],
