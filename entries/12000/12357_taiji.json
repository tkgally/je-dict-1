  "definitions": [
    {
      "sense_number": 1,
      "gloss": "confrontation, facing off against, standing opposed",
      "explanation": "Standing face to face in opposition or confrontation. Originally described mountains standing opposite each other, but now commonly used for people, groups, or forces in opposition."
    }
  ],
