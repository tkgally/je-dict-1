  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to guide, to lead, to show the way",
      "explanation": "To guide someone physically or figuratively toward a destination, goal, or outcome. Often implies leading with authority or wisdom."
    },
    {
      "sense_number": 2,
      "gloss": "to derive, to arrive at (a conclusion or answer)",
      "explanation": "To reach a conclusion, answer, or result through reasoning, calculation, or investigation."
    }
  ],
