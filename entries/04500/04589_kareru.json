{
  "id": "04589_kareru",
  "headword": "{枯|か}れる",
  "reading": "かれる",
  "part_of_speech": "verb (ichidan)",
  "gloss": "to wither; to die (plants); to dry up",
  "conjugation": {
    "type": "ichidan",
    "stem": "{枯|か}れ"
  },
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to wither; to die (plants)",
      "explanation": "When plants, flowers, or trees lose vitality and die."
    },
    {
      "sense_number": 2,
      "gloss": "to dry up; to run dry",
      "explanation": "When a water source, well, or stream dries up."
    },
    {
      "sense_number": 3,
      "gloss": "to mature; to mellow",
      "explanation": "Figuratively, when someone's style or manner becomes refined through age and experience."
    }
  ],
  "examples": [
