  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to act violently; to behave wildly",
      "explanation": "To behave in an uncontrolled, violent, or destructive manner."
    },
    {
      "sense_number": 2,
      "gloss": "to rage; to run rampant",
      "explanation": "When natural forces or animals become violent and uncontrollable."
    }
  ],
  "examples": [
