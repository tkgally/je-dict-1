  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be brought forward; to happen earlier",
      "explanation": "When a scheduled event or time occurs earlier than originally planned."
    },
    {
      "sense_number": 2,
      "gloss": "to quicken; to accelerate",
      "explanation": "When a pace, heartbeat, or process speeds up."
    },
    {
      "sense_number": 3,
      "gloss": "to be hasty; to act rashly",
      "explanation": "To make a premature or impulsive decision."
    }
  ],
