  },
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to drip; to trickle down",
      "explanation": "When liquid falls in drops from something."
    },
    {
      "sense_number": 2,
      "gloss": "to be dripping with; to overflow with",
      "explanation": "Figuratively describes something abundant or overflowing with a quality."
    }
  ],
  "examples": [
    {
      "id": "04572_shitataru_ex1",
      "japanese": "{蛇口|じゃぐち}から{水|みず}が{滴|したた}っている。",
      "english": "Water is dripping from the faucet.",
