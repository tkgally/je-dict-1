      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04572_shitataru_ex2",
      "japanese": "{木|き}の{葉|は}から{雨|あめ}の{雫|しずく}が{滴|したた}り{落|お}ちた。",
      "english": "Raindrops trickled down from the leaves.",
