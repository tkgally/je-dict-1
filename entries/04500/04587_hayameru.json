  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to bring forward; to move up",
      "explanation": "To reschedule something to an earlier time."
    },
    {
      "sense_number": 2,
      "gloss": "to hasten; to speed up",
      "explanation": "To make something happen faster or accelerate a process."
    }
  ],
  "examples": [
    {
      "id": "04587_hayameru_ex1",
      "japanese": "{出発|しゅっぱつ}を{一時間|いちじかん}{早|はや}めた。",
      "english": "We moved up the departure by one hour.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04587_hayameru_ex2",
      "japanese": "{会議|かいぎ}の{日程|にってい}を{早|はや}めてもらえますか。",
      "english": "Could you move up the date of the meeting?",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04587_hayameru_ex3",
      "japanese": "{台風|たいふう}が{近|ちか}づいているので、{帰宅|きたく}を{早|はや}めることにした。",
      "english": "Since a typhoon is approaching, we decided to leave for home earlier.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04587_hayameru_ex4",
      "japanese": "{足|あし}を{早|はや}めて{駅|えき}に{向|む}かった。",
      "english": "I quickened my pace and headed to the station.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        2
      ]
    },
    {
      "id": "04587_hayameru_ex5",
      "japanese": "ストレスは{老化|ろうか}を{早|はや}める。",
      "english": "Stress hastens aging.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        2
      ]
    },
    {
      "id": "04587_hayameru_ex6",
      "japanese": "{運動|うんどう}をすると{心拍|しんぱく}が{早|はや}まるが、カフェインも{心拍|しんぱく}を{早|はや}める。",
      "english": "Exercise makes your heart rate increase, and caffeine also speeds it up.",
