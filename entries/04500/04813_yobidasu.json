  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to call out, to summon",
      "explanation": "To call someone to come; to summon a person."
    },
    {
      "sense_number": 2,
      "gloss": "to call forth, to invoke",
      "explanation": "To bring forth or evoke (feelings, memories, etc.)."
    }
  ],
  "examples": [
    {
      "id": "04813_yobidasu_ex1",
      "japanese": "{友達|ともだち}を{呼|よ}び{出|だ}す。",
      "english": "Call a friend out.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04813_yobidasu_ex2",
      "japanese": "タクシーを{呼|よ}び{出|だ}してください。",
