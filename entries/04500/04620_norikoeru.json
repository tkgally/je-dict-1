  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to overcome, to get over",
      "explanation": "To successfully deal with and move past a difficulty, obstacle, or challenging situation."
    },
    {
      "sense_number": 2,
      "gloss": "to ride past, to pass (a stop)",
      "explanation": "To stay on a vehicle past one's intended stop."
    },
    {
      "sense_number": 3,
      "gloss": "to climb over",
      "explanation": "To physically climb over something while riding or by extension."
    }
  ],
