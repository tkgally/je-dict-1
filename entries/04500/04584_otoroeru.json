{
  "id": "04584_otoroeru",
  "headword": "{衰|おとろ}える",
  "reading": "おとろえる",
  "part_of_speech": "verb (ichidan)",
  "gloss": "to decline; to weaken; to deteriorate",
  "conjugation": {
    "type": "ichidan",
    "stem": "{衰|おとろ}え"
  },
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to weaken; to decline",
      "explanation": "When physical strength, health, or abilities diminish."
    },
    {
      "sense_number": 2,
      "gloss": "to wane; to fade",
      "explanation": "When power, influence, or prosperity decreases over time."
    }
  ],
  "examples": [
    {
      "id": "04584_otoroeru_ex1",
      "japanese": "{年|とし}を{取|と}ると、{体力|たいりょく}が{衰|おとろ}える。",
      "english": "As you get older, your physical strength declines.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04584_otoroeru_ex2",
      "japanese": "{祖父|そふ}は{視力|しりょく}が{衰|おとろ}えてきた。",
      "english": "My grandfather's eyesight has been deteriorating.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04584_otoroeru_ex3",
      "japanese": "{記憶力|きおくりょく}が{衰|おとろ}えてきたと{感|かん}じる。",
      "english": "I feel that my memory has been declining.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "04584_otoroeru_ex4",
      "japanese": "その{国|くに}の{勢力|せいりょく}は{次第|しだい}に{衰|おとろ}えていった。",
      "english": "That country's power gradually declined.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        2
      ]
    },
    {
      "id": "04584_otoroeru_ex5",
      "japanese": "{人気|にんき}が{衰|おとろ}えることなく、{今|いま}も{多|おお}くのファンがいる。",
      "english": "Without waning in popularity, there are still many fans today.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        2
      ]
    },
    {
      "id": "04584_otoroeru_ex6",
      "japanese": "{経済|けいざい}が{衰|おとろ}えて、{町|まち}から{若|わか}い{人|ひと}がいなくなった。",
      "english": "The economy declined and young people left the town.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        2
      ]
    }
  ],
  "notes": "{衰|おとろ}える is an intransitive verb ({自動詞|じどうし}). There is no common transitive pair.\n\nASPECT ({ている}):\n{衰|おとろ}えている indicates an ongoing state of decline or weakness.\n\nCOMMON PATTERNS:\n- {体力|たいりょく}が{衰|おとろ}える - physical strength declines\n- {視力|しりょく}/{聴力|ちょうりょく}が{衰|おとろ}える - eyesight/hearing deteriorates\n- {記憶力|きおくりょく}が{衰|おとろ}える - memory weakens\n- {勢|いきお}いが{衰|おとろ}える - momentum/force wanes\n- {衰|おとろ}え{知|し}らず - showing no signs of decline\n\nRELATED WORDS:\n- {衰弱|すいじゃく} - weakness, debility\n- {衰退|すいたい} - decline, decay",
