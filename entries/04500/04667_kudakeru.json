  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to break into pieces; to be smashed",
      "explanation": "For something hard to break apart or shatter into fragments."
    },
    {
      "sense_number": 2,
      "gloss": "to become informal; to relax",
      "explanation": "For an atmosphere or person to become more casual and relaxed."
    }
  ],
  "examples": [
