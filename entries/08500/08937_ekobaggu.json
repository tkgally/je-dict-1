  "definitions": [
    {
      "sense_number": 1,
      "gloss": "reusable shopping bag; eco bag",
      "explanation": "A reusable bag brought by shoppers to reduce plastic bag use, popular in Japan since plastic bag charges were introduced."
    }
  ],
  "examples": [
    {
      "id": "08937_ekobaggu_ex1",
      "japanese": "エコバッグを{持|も}ってきた。",
      "english": "I brought my reusable bag.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "08937_ekobaggu_ex2",
      "japanese": "レジ{袋|ぶくろ}が{有料|ゆうりょう}になったので、エコバッグを{使|つか}う。",
      "english": "Since plastic bags are now charged, I use an eco bag.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "08937_ekobaggu_ex3",
      "japanese": "{折|お}りたたみエコバッグをいつもカバンに{入|い}れている。",
      "english": "I always keep a foldable eco bag in my bag.",
      "notes": null,
