  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to persist; to stick with it; to persevere",
      "explanation": "To continue stubbornly or tenaciously despite difficulties, often implying staying in a situation longer than expected."
    },
    {
      "sense_number": 2,
      "gloss": "to be sticky; to be viscous",
      "explanation": "Physical property of being adhesive or having a thick, sticky consistency."
    }
  ],
