  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to end up doing; to completely do",
      "explanation": "casual contraction of てしまう (te-shimau); expresses completion of an action, often with a sense of regret, finality, or doing something unintentionally"
    }
  ],
  "examples": [
    {
