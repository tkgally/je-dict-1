  "definitions": [
    {
      "sense_number": 1,
      "gloss": "wry smile; bitter smile; forced laugh",
      "explanation": "a smile or laugh expressing embarrassment, irony, or resignation rather than genuine amusement"
    }
  ],
  "examples": [
    {
      "id": "08688_kushou_ex1",
      "japanese": "{彼|かれ}は{苦笑|くしょう}するしかなかった。",
      "english": "He could only smile wryly.",
