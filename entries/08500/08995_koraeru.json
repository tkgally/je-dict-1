  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to endure; to bear; to put up with",
      "explanation": "To withstand pain, hardship, or unpleasant situations without giving in or expressing it outwardly."
    },
    {
      "sense_number": 2,
      "gloss": "to hold back; to suppress (emotions)",
      "explanation": "To restrain oneself from expressing emotions such as tears, laughter, or anger."
    }
  ],
  "examples": [
