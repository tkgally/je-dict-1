  "gloss": "paste",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "paste (food)",
      "explanation": "A thick, soft substance made by crushing or grinding, used in cooking."
    },
    {
      "sense_number": 2,
      "gloss": "paste (computer)",
      "explanation": "The action of inserting copied or cut content in computing."
    }
