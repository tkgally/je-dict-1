  "definitions": [
    {
      "sense_number": 1,
      "gloss": "harmony (music)",
      "explanation": "the combination of different musical notes sung or played together; the pleasing arrangement of parts in music"
    },
    {
      "sense_number": 2,
      "gloss": "harmony; harmonious balance",
      "explanation": "a state of agreement, cooperation, or pleasing combination of elements"
    }
