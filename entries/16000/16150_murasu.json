  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to steam; to let sit and steam; to let rest (in its own heat)",
      "explanation": "To cook or finish cooking by allowing food to sit in steam or its own retained heat. An essential step in Japanese rice cooking — after the rice cooker finishes, the rice is left to rest and absorb remaining moisture. Also used for steaming bread, tea, and other foods."
    }
  ],
  "examples": [
    {
