      "japanese": "ご{飯|はん}を{十分|じゅっぷん}{蒸|む}らす。",
      "english": "Let the rice steam for ten minutes.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
