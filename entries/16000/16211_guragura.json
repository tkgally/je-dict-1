  "definitions": [
    {
      "sense_number": 1,
      "gloss": "wobbly; shaky; unsteady",
      "explanation": "Describes something that is unstable and shaking or rocking. Used for physical objects like teeth, furniture, and buildings."
    },
    {
      "sense_number": 2,
      "gloss": "boiling vigorously; at a rolling boil",
      "explanation": "Describes water or liquid boiling intensely with large bubbles."
    }
  ],
