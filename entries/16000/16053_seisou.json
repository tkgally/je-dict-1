  "definitions": [
    {
      "sense_number": 1,
      "gloss": "formal dress; full dress; formal attire",
      "explanation": "Clothing appropriate for formal occasions such as ceremonies, official events, and important social gatherings. Includes both Western formal wear and traditional Japanese formal kimono."
