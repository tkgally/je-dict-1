  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to win; to gain; to earn through effort",
      "explanation": "To obtain something valuable through struggle, competition, or sustained effort. Implies that the result was hard-won rather than easily obtained."
    }
  ],
