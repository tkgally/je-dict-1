  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to wear well; to dress stylishly; to carry off an outfit",
      "explanation": "To wear clothes in a way that looks natural and stylish. Implies skill or confidence in coordinating outfits and making them look good on oneself."
    }
  ],
