  "definitions": [
    {
      "sense_number": 1,
      "gloss": "abstention; forfeiture of a right",
      "explanation": "Voluntarily giving up or not exercising a right, especially the right to vote."
    },
    {
      "sense_number": 2,
      "gloss": "withdrawal; dropping out",
      "explanation": "Withdrawing from a competition, race, or match, usually due to injury or other circumstances."
    }
  ],
