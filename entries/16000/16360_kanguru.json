  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be suspicious of; to read too much into; to suspect hidden motives",
      "explanation": "To suspect something negative without clear evidence, often imagining hidden intentions or meanings where none may exist."
    }
  ],
