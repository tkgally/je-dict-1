  "definitions": [
    {
      "sense_number": 1,
      "gloss": "open recruitment; public appeal; open call for submissions",
      "explanation": "A public invitation for people to apply, submit, or participate — such as soliciting job applications, calling for design proposals, or inviting entries to a contest. Composed of 公 (public) + 募 (recruit, solicit). Often used as a する verb: 公募する."
    }
  ],
  "examples": [
