{
  "id": "16332_shimekukuru",
  "headword": "{締|し}め{括|くく}る",
  "reading": "しめくくる",
  "part_of_speech": "godan verb",
  "gloss": "to conclude, to wrap up",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to conclude, to wrap up, to bring to a close",
      "explanation": "To bring something to a fitting conclusion. Used for speeches, events, projects, or any activity that needs a proper ending."
    }
  ],
  "examples": [
    {
      "id": "16332_shimekukuru_ex1",
      "japanese": "スピーチを{締|し}め{括|くく}る。",
      "english": "To conclude a speech.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "16332_shimekukuru_ex2",
      "japanese": "{今年|ことし}を{良|よ}い{形|かたち}で{締|し}め{括|くく}りたい。",
      "english": "I want to wrap up this year on a good note.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "16332_shimekukuru_ex3",
      "japanese": "{最後|さいご}に{感謝|かんしゃ}の{言葉|ことば}で{締|し}め{括|くく}った。",
      "english": "He concluded with words of gratitude.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    }
  ],
  "notes": "COMMON COLLOCATIONS:\n- スピーチを{締|し}め{括|くく}る: to conclude a speech\n- {一年|いちねん}を{締|し}め{括|くく}る: to close out the year\n- 〜で{締|し}め{括|くく}る: to wrap up with ~\n\nRELATED NOUN:\n- {締|し}め{括|くく}り: conclusion, wrap-up\n\nSIMILAR WORDS:\n- {終|お}える: to finish (neutral, general)\n- {まとめる}: to summarize, to put together\n- {結|むす}ぶ: to conclude (more formal; used for contracts, agreements)",
