  "definitions": [
    {
      "sense_number": 1,
      "gloss": "tax saving; tax reduction",
      "explanation": "The legal practice of reducing one's tax burden through legitimate means such as deductions, exemptions, and strategic financial planning. Distinguished from tax evasion, which is illegal."
    }
  ],
