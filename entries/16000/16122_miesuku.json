  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be transparent; to be obvious; to be see-through",
      "explanation": "Used figuratively to describe lies, intentions, or excuses that are so obvious they can be easily seen through."
    }
  ],
  "examples": [
