  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to rattle; to be rickety; to be wobbly",
      "explanation": "To shake or rattle due to looseness or poor condition. Used for physical objects like furniture, doors, or machines."
    },
    {
      "sense_number": 2,
      "gloss": "to become unstable; to falter",
      "explanation": "Used figuratively for organizations, relationships, or systems that are losing stability or falling apart."
    }
  ],
