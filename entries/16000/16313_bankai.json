  "definitions": [
    {
      "sense_number": 1,
      "gloss": "recovery, retrieval, making up for",
      "explanation": "Recovering lost ground or making up for a loss, failure, or disadvantage. Often used with する to mean 'to recover' or 'to make up for.'"
    }
  ],
