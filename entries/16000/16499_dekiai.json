  "definitions": [
    {
      "sense_number": 1,
      "gloss": "doting; excessive love; blind devotion",
      "explanation": "Loving someone, typically a child or pet, to an excessive or unhealthy degree. Carries a negative connotation of love that lacks objectivity or discipline."
    }
  ],
  "examples": [
    {
      "id": "16499_dekiai_ex1",
      "japanese": "{祖父|そふ}は{孫|まご}を{溺愛|できあい}している。",
      "english": "My grandfather dotes on his grandchild.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "16499_dekiai_ex2",
      "japanese": "{息子|むすこ}を{溺愛|できあい}するあまり、{何|なん}でも{買|か}い{与|あた}えてしまう。",
      "english": "She dotes on her son so much that she ends up buying him everything.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "16499_dekiai_ex3",
