  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to increase; to mount up",
      "explanation": "For amounts, especially expenses or quantities, to accumulate and become larger."
    },
    {
      "sense_number": 2,
      "gloss": "to bulk up; to take up more space",
      "explanation": "For physical volume to increase or become bulky."
    }
  ],
