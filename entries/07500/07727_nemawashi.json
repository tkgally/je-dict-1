  "definitions": [
    {
      "sense_number": 1,
      "gloss": "groundwork; behind-the-scenes preparation; consensus-building",
      "explanation": "The practice of informally consulting with stakeholders before a formal meeting or decision to build support and avoid opposition."
    }
  ],
  "examples": [
