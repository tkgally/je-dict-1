  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to be biased; to be partial",
      "explanation": "to favor one side unfairly; to have a one-sided view or approach"
    },
    {
      "sense_number": 2,
      "gloss": "to lean; to be uneven; to be lopsided",
      "explanation": "to be physically off-center or concentrated on one side"
    }
  ],
