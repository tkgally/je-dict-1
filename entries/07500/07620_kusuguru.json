  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to tickle",
      "explanation": "To touch someone lightly in a way that causes an itchy, often involuntary laughing response."
    },
    {
      "sense_number": 2,
      "gloss": "to titillate; to appeal to",
      "explanation": "To pleasantly stimulate someone's emotions, curiosity, or vanity."
    }
  ],
