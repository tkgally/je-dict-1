  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to shake; to rock",
      "explanation": "To move something back and forth or side to side repeatedly."
    },
    {
      "sense_number": 2,
      "gloss": "to shake emotionally; to unsettle",
      "explanation": "To disturb someone's emotions or convictions, to make them waver."
    }
  ],
