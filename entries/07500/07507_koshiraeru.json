  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to make; to prepare; to create",
      "explanation": "To make or prepare something, often by hand or with care. Has a somewhat traditional or literary feel."
    },
    {
      "sense_number": 2,
      "gloss": "to fabricate; to make up",
      "explanation": "To create something fictitious such as an excuse or story."
    }
  ],
