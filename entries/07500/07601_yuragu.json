  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to sway; to shake",
      "explanation": "To move slowly back and forth or side to side, especially from wind or instability."
    },
    {
      "sense_number": 2,
      "gloss": "to waver; to falter",
      "explanation": "To become unstable or uncertain, often referring to emotions, convictions, or positions."
    },
    {
      "sense_number": 3,
      "gloss": "to flicker",
      "explanation": "For light or flame to move unsteadily."
    }
  ],
