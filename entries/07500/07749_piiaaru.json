  "definitions": [
    {
      "sense_number": 1,
      "gloss": "public relations; publicity; promotion",
      "explanation": "Activities to promote a company, product, or person. Used broadly for any promotional or publicity efforts."
    },
    {
      "sense_number": 2,
      "gloss": "self-promotion; appeal; selling point",
      "explanation": "Highlighting one's own strengths or appealing qualities, especially in job interviews or self-introductions."
    }
  ],
