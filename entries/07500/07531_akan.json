{
  "id": "07531_akan",
  "headword": "あかん",
  "reading": "あかん",
  "part_of_speech": "expression",
  "gloss": "no good; must not (Kansai dialect)",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "no good; not acceptable; hopeless",
      "explanation": "Kansai dialect equivalent of だめ (dame), indicating something is no good, unacceptable, or impossible."
    },
    {
      "sense_number": 2,
      "gloss": "must not; should not",
      "explanation": "Used to express prohibition or that something should not be done."
    }
  ],
  "examples": [
    {
      "id": "07531_akan_ex1",
      "japanese": "もうあかんわ。",
      "english": "It's no good anymore.",
      "has_audio": false,
      "sense_numbers": [
        1
      ],
      "notes": null
    },
    {
      "id": "07531_akan_ex2",
      "japanese": "この{機械|きかい}、あかんわ。",
      "english": "This machine is no good.",
      "has_audio": false,
      "sense_numbers": [
        1
      ],
      "notes": null
    },
    {
      "id": "07531_akan_ex3",
      "japanese": "{今日|きょう}は{体調|たいちょう}があかんねん。",
      "english": "I'm not feeling well today.",
      "has_audio": false,
      "sense_numbers": [
        1
      ],
      "notes": null
    },
    {
      "id": "07531_akan_ex4",
      "japanese": "ここで{走|はし}ったらあかん。",
