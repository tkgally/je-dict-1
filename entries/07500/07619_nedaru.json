  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to beg for; to pester for",
      "explanation": "To persistently ask someone for something, often in a whining or pleading manner."
    },
    {
      "sense_number": 2,
      "gloss": "to coax; to wheedle",
      "explanation": "To try to get something through flattery or persistent asking."
    }
  ],
