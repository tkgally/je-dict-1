  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to wilt; to wither",
      "explanation": "For plants to droop or lose freshness due to lack of water or heat."
    },
    {
      "sense_number": 2,
      "gloss": "to lose energy; to become dispirited",
      "explanation": "To lose motivation, enthusiasm, or energy, often due to disappointment or exhaustion."
    },
    {
      "sense_number": 3,
      "gloss": "to go limp; to lose strength",
      "explanation": "For body parts to become weak or lose their power."
    }
  ],
