  "definitions": [
    {
      "sense_number": 1,
      "gloss": "compensation; reparation; indemnification",
      "explanation": "Payment made to compensate for damage, loss, or injury caused; especially in a legal context."
    }
  ],
  "examples": [
    {
      "id": "07641_baishou_ex1",
      "japanese": "{損害|そんがい}{賠償|ばいしょう}を{請求|せいきゅう}する。",
      "english": "To claim damages.",
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "07641_baishou_ex2",
      "japanese": "{会社|かいしゃ}は{被害者|ひがいしゃ}に{賠償金|ばいしょうきん}を{支払|しはら}った。",
      "english": "The company paid compensation to the victims.",
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "07641_baishou_ex3",
      "japanese": "{事故|じこ}の{被害者|ひがいしゃ}は{数千万円|すうせんまんえん}の{損害|そんがい}{賠償|ばいしょう}を{求|もと}めて{裁判|さいばん}を{起|お}こした。",
      "english": "The accident victims filed a lawsuit seeking tens of millions of yen in damages.",
      "has_audio": false,
      "sense_numbers": [
        1
      ]
