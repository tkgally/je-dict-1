  "definitions": [
    {
      "sense_number": 1,
      "gloss": "disclosure; exposure; coming to light",
      "explanation": "A hidden truth, wrongdoing, or secret becoming known to others. Almost always used for things that were concealed and are discovered, typically with negative connotations."
    }
  ],
