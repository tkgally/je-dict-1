  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to depend on; to rely on",
      "explanation": "To be reliant on something or someone for support, functioning, or existence."
    },
    {
      "sense_number": 2,
      "gloss": "to be addicted to; to be dependent on",
      "explanation": "To be psychologically or physically dependent on a substance, behavior, or person in a harmful way."
    }
  ],
