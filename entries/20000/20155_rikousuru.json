  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to fulfill; to carry out; to perform (a duty, obligation, or contract)",
      "explanation": "To carry out or fulfill something that one is obligated to do, such as a contract, promise, duty, or agreement. Formal and often used in legal and business contexts."
