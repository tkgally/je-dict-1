  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to accomplish; to carry out; to execute (a task or mission)",
      "explanation": "To carry something through to completion, especially a task, mission, or duty. Implies determination and thoroughness in seeing something through."
    }
