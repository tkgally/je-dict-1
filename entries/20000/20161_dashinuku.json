  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to outsmart; to outwit; to get ahead of someone by trickery",
      "explanation": "To gain an advantage over someone by acting cleverly or sneakily before they can react. Implies cunning or underhanded tactics rather than honest competition."
    }
  ],
