  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to obligate; to make mandatory; to require by rule or law",
      "explanation": "To impose an obligation or requirement, typically through law, regulation, or organizational rules. Often used in passive form to describe what is required."
