  "definitions": [
    {
      "sense_number": 1,
      "gloss": "depravity; corruption; degradation; moral decline",
      "explanation": "A fall from a higher moral or behavioral standard to a lower one. Used for both individuals and societies. Also used as a suru-verb."
    }
  ],
