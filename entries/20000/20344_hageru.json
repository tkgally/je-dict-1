  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to go bald; to lose hair",
      "explanation": "To lose hair from the head, resulting in baldness. Can describe gradual thinning or complete hair loss."
    },
    {
      "sense_number": 2,
      "gloss": "to become bare; to wear off; to peel",
      "explanation": "For surfaces like mountains, paint, or coatings to become stripped or bare, losing their covering."
    }
  ],
