  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to ride, to get on, to board",
      "explanation": "To get onto a vehicle or mount something. Used for trains, buses, cars, bicycles, horses, etc."
    }
  ],
  "examples": [
    {
