  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to return home, to go back",
      "explanation": "To go back to one's home, country, or original location. The destination is typically a place one belongs to or comes from."
    }
  ],
  "examples": [
    {
      "id": "00508_kaeru_ex1",
