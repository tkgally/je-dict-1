{
  "id": "00904_ugoku",
  "headword": "{動|うご}く",
  "reading": "うごく",
  "part_of_speech": "verb (godan)",
  "gloss": "to move",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to move",
      "explanation": "To change position or location. Can describe physical movement of people, animals, vehicles, or objects. Also used for machines that are operating or functioning."
    }
  ],
  "examples": [
    {
      "id": "00904_ugoku_ex1",
