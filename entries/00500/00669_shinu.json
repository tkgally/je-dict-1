  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to die, to pass away",
      "explanation": "The basic verb for dying. Can be used for people, animals, or plants. In polite contexts, 亡くなる (nakunaru) is often preferred when speaking about people."
    }
  ],
  "examples": [
