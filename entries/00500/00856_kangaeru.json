  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to think, to consider",
      "explanation": "To use the mind to process information, reflect on something, or come up with ideas. More deliberate than {思|おも}う which is more about feeling or believing."
    }
  ],
  "examples": [
