  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to put on (shoes, pants, skirts)",
      "explanation": "To wear items on the lower body and feet—shoes, pants, skirts, socks. Different from {着|き}る which is for upper body clothing."
    }
  ],
