  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to arrive, to reach",
      "explanation": "Used when someone or something arrives at a destination. This is the standard verb for expressing arrival at a place. Takes the particle に to mark the destination."
    }
  ],
