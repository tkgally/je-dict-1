  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to climb, to go up, to ascend",
      "explanation": "Used for climbing mountains, hills, stairs, or any upward movement. Takes the particle を to mark what is being climbed, or に for the destination."
    }
  ],
