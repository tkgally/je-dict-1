  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to dry, to become dry",
      "explanation": "For something wet to become dry. Intransitive verb used for laundry, surfaces, etc."
    },
    {
      "sense_number": 2,
      "gloss": "to be thirsty",
      "explanation": "When used with {喉|のど} (throat), means to be thirsty: {喉|のど}が{乾|かわ}いた."
    }
  ],
