  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to get off, to alight",
      "explanation": "To exit a vehicle. Used for trains, buses, cars, etc."
    },
    {
      "sense_number": 2,
      "gloss": "to go down, to descend",
      "explanation": "To move from a higher position to a lower one."
    }
  ],
