  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to receive, to get",
      "explanation": "To accept something given by someone. The receiver is typically the speaker or someone close to the speaker."
    }
  ],
  "examples": [
    {
      "id": "00520_morau_ex1",
      "japanese": "⟦{友達|ともだち}→友達：01478_tomodachi⟧⟦から→から：00504_kara⟧⟦プレゼント→プレゼント：01791_purezento⟧⟦を→を：00422_wo⟧もらいました。",
