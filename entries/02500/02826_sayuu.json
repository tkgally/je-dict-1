      "sense_numbers": [
        2
      ]
    },
    {
      "id": "02826_sayuu_ex5",
      "japanese": "{道路|どうろ}を{渡|わた}る{前|まえ}に、{左右|さゆう}をよく{確認|かくにん}してください。",
