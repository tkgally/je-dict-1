{
  "id": "01813_akirameru",
  "headword": "{諦|あきら}める",
  "reading": "あきらめる",
  "part_of_speech": "verb (ichidan)",
  "gloss": "to give up",
  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to give up, to abandon",
      "explanation": "To stop trying or hoping for something; to accept that something cannot be achieved."
    }
  ],
  "examples": [
    {
      "id": "01813_akirameru_ex1",
      "japanese": "⟦{夢|ゆめ}→夢：01519_yume⟧⟦を→を：00422_wo⟧{諦|あきら}めないで。",
      "english": "Don't give up on your dream.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "01813_akirameru_ex2",
      "japanese": "⟦もう→もう：00602_mou⟧{諦|あきら}めました。",
      "english": "I've already given up.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "01813_akirameru_ex3",
      "japanese": "⟦{簡単|かんたん}に→簡単：00713_kantan⟧{諦|あきら}めてはいけない。",
      "english": "You shouldn't give up easily.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "01813_akirameru_ex4",
      "japanese": "⟦{何度|なんど}→何度：17592_nando⟧⟦{失敗|しっぱい}しても→失敗する：01636_shippai⟧{諦|あきら}めなかった。",
      "english": "I didn't give up no matter how many times I failed.",
      "notes": null,
      "has_audio": false,
      "sense_numbers": [
        1
      ]
    },
    {
      "id": "01813_akirameru_ex5",
      "japanese": "⟦{最後|さいご}→最後：01413_saigo⟧⟦まで→まで：00490_made⟧{諦|あきら}めずに⟦{頑張|がんば}ろう→頑張る：01222_ganbaru⟧。",
      "english": "Let's keep trying without giving up until the end.",
      "notes": null,
