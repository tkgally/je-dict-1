  "definitions": [
    {
      "sense_number": 1,
      "gloss": "maintenance, preservation",
      "explanation": "The act of keeping something in good condition or at the same level over time."
    },
    {
      "sense_number": 2,
      "gloss": "to maintain, to preserve",
      "explanation": "To keep something in its existing state."
    }
  ],
