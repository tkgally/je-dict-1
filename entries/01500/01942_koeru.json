  "definitions": [
    {
      "sense_number": 1,
      "gloss": "to exceed, to surpass",
      "explanation": "To go beyond a limit or amount."
    },
    {
      "sense_number": 2,
      "gloss": "to transcend, to go beyond (a boundary)",
      "explanation": "To go beyond a boundary or category in an abstract sense: borders, generations, eras. For physically crossing a mountain or river, the usual spelling is 越える."
    }
  ],
