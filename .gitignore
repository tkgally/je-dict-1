# Project-specific
# Note: docs/ is served by GitHub Pages and must be in version control
# The build script outputs to docs/ instead of dist/

# Backups (created by Claude Code hooks)
backups/

# Claude Code local settings (if any)
.claude/settings.local.json
docs_build_temp/

# Batch script logs
prompts/batch/logs/

# Brainstorming temp files (large data file + transient results)
prompts/entries-and-candidates-for-brainstorming.md
prompts/brainstorm_results.json

# Parallel session locks (advisory, not committed)
polishing/locks/

# Orchestrator runtime files
pipeline/orchestrator.lock
pipeline/logs/
pipeline/task_queue.json

# Git worktrees for parallel sessions
.worktrees/

# Review artifacts (2026-09-02): per-entry review files are local working
# artifacts, regenerated by each run. The tracked records are
# reviews/screening/screening_status.json (coverage), reviews/accuracy_flags.jsonl
# (outstanding flags), and reviews/decisions.jsonl (adjudications).
reviews/accuracy/*.json
reviews/screening/*.json
!reviews/screening/screening_status.json
